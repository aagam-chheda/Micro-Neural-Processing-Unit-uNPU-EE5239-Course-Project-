#@ set PT_VIOL_MAX_PATHS 100000
#@ # 078 (ECO probe, pt_eco_probe.tcl). Hold margin handed to fix_eco_timing: 0.05 ns on top of the 0.5 ns hold uncertainty that is already in the constraints, because the PrimeTime and the ICC2
#@ # parasitic estimates (and the ICC2 re-route after the ECO) differ by picoseconds to tens of picoseconds; a fix that closes with exactly 0.00 would not survive that difference.
#@ set PT_ECO_HOLD_MARGIN 0.05
#@ # library cell name patterns for the buffer candidates (names relative to the library; the choice among them is made by DATA: is_buffer, delay, area -- see pt_eco_choose_buffers)
#@ set PT_ECO_LIB_PATTERNS {dl* buff*}
#@ # 078 fix: when NO delay is readable from the library, the buffer list is the hold-fixing set: every candidate that matches PT_ECO_DELAY_PATTERN (the dl* delay cells) plus the cells in
#@ # PT_ECO_EXTRA_CELLS (buffd1: the smallest plain buffer), ordered by area, largest first, as the proxy for the delay (the first server run: the delay was n/a for all 18 cells). This is a
#@ # NAME-based choice, forced by the missing data; the log says so.
#@ set PT_ECO_DELAY_PATTERN {dl*}
#@ set PT_ECO_EXTRA_CELLS {buffd1}
#@ # how many candidate cells are handed to -buffer_list at most. 20 is above the 18 cells the first server run listed (dl* 12, buffd* 6), so the list is not cut; fix_eco_timing picks the best cell itself.
#@ set PT_ECO_MAX_BUFFERS 20
#@ # licence feature names that are TRIED (not assumed): the probe prints PrimeTime's own answer for each, and the ECO command itself is the final test
#@ set PT_ECO_LICENSE_TRIES {PrimeTime-ECO}
#@ # output files of the probe (in $PT_RPT_DIR)
#@ # 078 fix: 0 = the ECO is LOGICAL only (no physical data; tried first). 1 = also hand the physical data to set_eco_options (the kit standard-cell LEF, an optional technology LEF, the DEF
#@ # written by pv.tcl) and use -physical_mode occupied_site; use only after the logical form was answered with PTECO-099/017 (VERIFY the option names, README V28).
#@ set PT_ECO_PHYSICAL 0
#@ set PT_ECO_STD_LEF  "${PT_KIT}/stdcell/fs120/4M1IL/lef/scl18fs120_std.lef"    ;# the same file as CELL_LEF in build_ndm_std.tcl
#@ set PT_ECO_TECH_LEF ""                                                        ;# EMPTY = not passed (a separate technology LEF is not known here)
#@ set PT_ECO_DEF      "${PT_OUT_DIR}/${PT_DESIGN}.def"                          ;# written by pv.tcl
#@ set PT_ECO_FILE_ICCTCL "pt_eco_hold_changes.tcl"
#@ set PT_ECO_FILE_ICC2TCL "pt_eco_hold_changes_icc2.tcl"
#@ set PT_ECO_FILE_TEXT "pt_eco_hold_changes.txt"
#@ 
#@ # ---- 080: the in2out cone (keep PrimeTime's ECO out of the input-to-output paths) ----
#@ # 080: why. The first ICC2 apply of the hold ECO (commit 31427af) put hold delay cells (dl01d1, dl02d1: 0.4 to 0.9 ns at ss) at shared points of u_apb / u_csr (u_apb/U46/Z, U61/Z, U29/Z ...) that also feed the
#@ # 080: combinational APB read path paddr -> ... -> prdata (path group **in2out_default**, budget 4.5 ns, met with about zero margin). ICC2 then reported setup WNS -0.589873 ns, 32 violating endpoints, ALL in
#@ # 080: that group. PrimeTime's hold ECO runs in ONE fast-corner session and cannot see the setup damage at ss. So during fix_eco_timing every cell and net on an input-to-output path is dont_touch.
#@ set PT_CONE_PROTECT       1        ;# 080: 1 = protect the cone during the hold ECO (the default and the only value that is safe for the read path); 0 = compute and report the cone only (for a comparison run)
#@ set PT_CONE_PROTECT_NETS  1        ;# 080 (decided from the server runs, commit 8b185fa): 1 = the cone CELLS and the cone NETS are dont_touch (default). With 0 (cells only) the probe ended with `ECO RAN BUT TOUCHES THE IN2OUT CONE: 2 of 109 proposed changes touch the cone; first: insert_buffer on pin U61/Z of the cone cell U61`: dont_touch on a cell stops a resize but PrimeTime still inserted a buffer on its OUTPUT NET. With 1 the run gave 0 hold violators remaining (WNS +0.0002 ns, before 263 / -0.3468 ns) and `ECO RAN: 112 changes proposed ... (none touches the in2out cone)`. 0 stays available for a comparison run; the after-check on the change file is the guard in both modes
#@ set PT_CONE_EXPECT_PREFIXES {u_apb/ u_csr/}   ;# 080 sanity: the cone must contain at least one cell whose name starts with one of these (the APB read mux lives in u_apb / u_csr); none = the cone is wrong, the ECO is NOT run
#@ set PT_CONE_REPORT_PATHS  20       ;# 080: method (b): number of paths of the report_timing cross-check
#@ set PT_CONE_MAX_NODES     200000   ;# 080: method (c): bound on the number of cells visited by the structural traversal (a runaway traversal is an ERROR, not a hang)
#@ set PT_CONE_MAX_PATHS     100000   ;# 080: bound of get_timing_paths -unique_pins for the input-to-output paths; a list as long as the bound is an ERROR (the cone may be truncated). Same size and reason as PT_VIOL_MAX_PATHS
#@ set PT_CONE_PRINT_NAMES   20       ;# 080: how many cone names are printed (the full lists are written to the cone files)
#@ set PT_CONE_SAMPLE        3        ;# 080: how many protected objects get the dont_touch attribute read back (proof that it is in effect)
#@ set PT_CONE_TOUCH_PRINT   10       ;# 080: how many remaining violators are printed with their reason after the ECO (all of them are in the CSV)
#@ 

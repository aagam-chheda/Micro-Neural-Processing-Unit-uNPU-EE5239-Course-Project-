# ---- BEGIN PURE TCL 068 ----
# 068: everything between BEGIN and END is plain Tcl (no ICC2 command); pnr_v2/test_antenna_port_buffers.tcl extracts and tests exactly this text.

# 068: parse a Calibre ASCII results database (antenna or DRC). Returns a dict: top, dbu, polys.
# 068: each poly is a dict: rule id nv xs ys bbox {x0 y0 x1 y1} (micrometres). Lines such as `CN unpu_top c 1 0 0 1 0 0 0` between the `p` line and
# 068: the vertices are skipped (fix_antenna.tcl reads them as one of the vertices, which loses the last vertex of the first polygon of each rule).
proc ant_parse_db {text} {
    set lines [split $text "\n"]
    set n [llength $lines]
    set i 0
    set dbu ""
    set top ""
    while {$i < $n} {
        set l [string trim [lindex $lines $i]]
        incr i
        if {$l eq ""} continue
        if {![regexp {^(\S+)\s+([0-9]+)$} $l -> top dbu]} {
            error "ant_parse_db: the first line is not '<cell> <database units per um>': '$l'"
        }
        break
    }
    if {$dbu eq "" || $dbu == 0} { error "ant_parse_db: no header line (cell and database unit)" }
    set rule ""
    set polys {}
    while {$i < $n} {
        set l [string trim [lindex $lines $i]]
        if {[regexp {^[A-Za-z][A-Za-z0-9_.]*$} $l] && ($i + 1) < $n && [regexp {^[0-9]+\s+[0-9]+\s+[0-9]+\s+[A-Z][a-z][a-z]\s} [string trim [lindex $lines [expr {$i + 1}]]]]} {
            set rule $l
            incr i
            continue
        }
        if {[regexp {^p\s+([0-9]+)\s+([0-9]+)$} $l -> pid nv]} {
            if {$rule eq ""} { error "ant_parse_db: polygon $pid before any rule line" }
            set xs {}
            set ys {}
            set j [expr {$i + 1}]
            while {[llength $xs] < $nv} {
                if {$j >= $n} { error "ant_parse_db: polygon $pid of rule $rule is cut off by the end of the file" }
                set vl [string trim [lindex $lines $j]]
                if {[regexp {^(-?[0-9]+)\s+(-?[0-9]+)$} $vl -> vx vy]} {
                    lappend xs [expr {$vx / double($dbu)}]
                    lappend ys [expr {$vy / double($dbu)}]
                } elseif {[regexp {^p\s+[0-9]+\s+[0-9]+$} $vl]} {
                    error "ant_parse_db: polygon $pid of rule $rule has fewer than $nv vertices"
                }
                incr j
            }
            set xmin [lindex [lsort -real $xs] 0]
            set xmax [lindex [lsort -real $xs] end]
            set ymin [lindex [lsort -real $ys] 0]
            set ymax [lindex [lsort -real $ys] end]
            lappend polys [dict create rule $rule id $pid nv $nv xs $xs ys $ys bbox [list $xmin $ymin $xmax $ymax]]
            set i $j
            continue
        }
        incr i
    }
    return [dict create top $top dbu $dbu polys $polys]
}

# 068: Calibre antenna rule name -> ICC2 layer name, "" when the rule is not a metal-area rule (AN.VIA.*, AN.GC.1, ...)
proc ant_rule_layer {rule} {
    if {[regexp {^AN\.MTL\.[12]\.(M[1-3]|MT)$} $rule -> l]} {
        if {$l eq "MT"} { return "TOP_M" }
        return $l
    }
    return ""
}

# 068: four numbers out of an ICC2 bbox string such as "{837.46 408.465} {837.74 409.365}"
proc ant_bbox_nums {s} {
    set nums [regexp -all -inline -- {-?[0-9]+(?:\.[0-9]+)?(?:[eE][-+]?[0-9]+)?} $s]
    if {[llength $nums] != 4} { error "ant_bbox_nums: expected 4 numbers in '$s'" }
    return $nums
}

proc ant_poly_area {xs ys} {
    set n [llength $xs]
    set a 0.0
    for {set i 0} {$i < $n} {incr i} {
        set j [expr {($i + 1) % $n}]
        set a [expr {$a + [lindex $xs $i] * [lindex $ys $j] - [lindex $xs $j] * [lindex $ys $i]}]
    }
    return [expr {abs($a) / 2.0}]
}

# 068: point in polygon, boundary counts as inside (eps in um)
proc ant_pt_in_poly {x y xs ys {eps 1e-4}} {
    set n [llength $xs]
    for {set i 0} {$i < $n} {incr i} {
        set j [expr {($i + 1) % $n}]
        set x1 [lindex $xs $i]; set y1 [lindex $ys $i]
        set x2 [lindex $xs $j]; set y2 [lindex $ys $j]
        set dx [expr {$x2 - $x1}]; set dy [expr {$y2 - $y1}]
        set len2 [expr {$dx * $dx + $dy * $dy}]
        if {$len2 == 0.0} continue
        set t [expr {(($x - $x1) * $dx + ($y - $y1) * $dy) / $len2}]
        if {$t < 0.0} { set t 0.0 }
        if {$t > 1.0} { set t 1.0 }
        set cx [expr {$x1 + $t * $dx}]; set cy [expr {$y1 + $t * $dy}]
        if {hypot($x - $cx, $y - $cy) <= $eps} { return 1 }
    }
    set inside 0
    for {set i 0} {$i < $n} {incr i} {
        set j [expr {($i + $n - 1) % $n}]
        set xi [lindex $xs $i]; set yi [lindex $ys $i]
        set xj [lindex $xs $j]; set yj [lindex $ys $j]
        if {(($yi > $y) != ($yj > $y)) && ($x < ($xj - $xi) * ($y - $yi) / ($yj - $yi) + $xi)} {
            set inside [expr {!$inside}]
        }
    }
    return $inside
}

# 068: rank the nets of a list of shapes {net x0 y0 x1 y1} against one polygon (dict from ant_parse_db).
# 068: tier 3 = a shape of the net has the polygon's bbox (within tol); tier 2 = a shape contains the polygon's bbox; tier 1 = shapes overlap the polygon
# 068: (overlap area whose centre lies inside the polygon, divided by the polygon area = score). Result: list of {net tier score}, best first.
proc ant_rank {poly shapes {tol 0.006}} {
    lassign [dict get $poly bbox] px0 py0 px1 py1
    set xs [dict get $poly xs]
    set ys [dict get $poly ys]
    set parea [ant_poly_area $xs $ys]
    array set tier {}
    array set num {}
    foreach s $shapes {
        lassign $s net sx0 sy0 sx1 sy1
        set ix0 [expr {max($sx0, $px0)}]
        set iy0 [expr {max($sy0, $py0)}]
        set ix1 [expr {min($sx1, $px1)}]
        set iy1 [expr {min($sy1, $py1)}]
        if {$ix1 - $ix0 <= 1e-6 || $iy1 - $iy0 <= 1e-6} continue
        if {![info exists tier($net)]} { set tier($net) 0; set num($net) 0.0 }
        set t 0
        if {abs($sx0 - $px0) <= $tol && abs($sy0 - $py0) <= $tol && abs($sx1 - $px1) <= $tol && abs($sy1 - $py1) <= $tol} {
            set t 3
        } elseif {$sx0 <= $px0 + $tol && $sy0 <= $py0 + $tol && $sx1 >= $px1 - $tol && $sy1 >= $py1 - $tol} {
            set t 2
        }
        if {[ant_pt_in_poly [expr {($ix0 + $ix1) / 2.0}] [expr {($iy0 + $iy1) / 2.0}] $xs $ys]} {
            set num($net) [expr {$num($net) + ($ix1 - $ix0) * ($iy1 - $iy0)}]
            if {$t == 0} { set t 1 }
        } elseif {$t < 2} {
            set t 0
        }
        if {$t > $tier($net)} { set tier($net) $t }
    }
    set out {}
    foreach net [array names tier] {
        if {$tier($net) == 0} continue
        set sc [expr {$parea > 0 ? min(1.0, $num($net) / $parea) : 0.0}]
        lappend out [list $net $tier($net) $sc]
    }
    return [lsort -decreasing -integer -index 1 [lsort -decreasing -real -index 2 $out]]   ;# sort by score, then (stable) by tier: tier first, score second
}

# 068: decision on a ranked list: {status chosen note}. status: OK | NONE | AMBIGUOUS | LOWCOVER. Nothing is guessed: only OK has a net.
proc ant_decide {ranks {margin 0.05} {mincover 0.5}} {
    if {[llength $ranks] == 0} { return [list NONE "" "no shape overlaps the polygon"] }
    set top [lindex $ranks 0]
    lassign $top n1 t1 s1
    if {[llength $ranks] > 1} {
        lassign [lindex $ranks 1] n2 t2 s2
        if {$t2 == $t1 && ($t1 >= 2 || abs($s1 - $s2) < $margin)} {
            return [list AMBIGUOUS "" "$n1 and $n2 both at tier $t1 (scores [format %.2f $s1] / [format %.2f $s2])"]
        }
    }
    if {$t1 == 1 && $s1 < $mincover} {
        return [list LOWCOVER "" "best net $n1 covers only [format %.2f $s1] of the polygon"]
    }
    return [list OK $n1 "tier $t1 score [format %.2f $s1]"]
}

# 068: gate area (um^2) a pin wire of wire_um on a layer of the given weight needs: 2 x (L + W) x weight / limit x safety
proc ant_need_gate {wire_um width_um weight limit safety} {
    return [expr {2.0 * ($wire_um + $width_um) * $weight / $limit * $safety}]
}
proc ant_ratio {gate_area wire_um width_um weight} {
    return [expr {2.0 * ($wire_um + $width_um) * $weight / $gate_area}]
}

# 068: kit LEF -> dict cell -> {w h pins}, pins: dict pin -> {dir use gate {list} diff {list}}
proc ant_parse_lef {text} {
    set cells [dict create]
    set macro ""
    set pin ""
    foreach raw [split $text "\n"] {
        set l [string trim $raw]
        if {$l eq ""} continue
        if {[regexp {^MACRO\s+(\S+)} $l -> m]} {
            set macro $m
            set pin ""
            dict set cells $macro [dict create w "" h "" pins [dict create]]
            continue
        }
        if {$macro eq ""} continue
        if {[regexp {^SIZE\s+([0-9.eE+-]+)\s+BY\s+([0-9.eE+-]+)} $l -> w h]} {
            dict set cells $macro w $w
            dict set cells $macro h $h
            continue
        }
        if {[regexp {^PIN\s+(\S+)} $l -> p]} {
            set pin $p
            dict set cells $macro pins $pin [dict create dir "" use "" gate {} diff {}]
            continue
        }
        if {[regexp {^END\s+(\S+)} $l -> e]} {
            if {$e eq $macro} { set macro ""; set pin "" } elseif {$e eq $pin} { set pin "" }
            continue
        }
        if {$pin eq ""} continue
        set pd [dict get $cells $macro pins $pin]
        if {[regexp {^DIRECTION\s+(\S+)} $l -> d]} {
            dict set pd dir $d
        } elseif {[regexp {^USE\s+(\S+)} $l -> u]} {
            dict set pd use $u
        } elseif {[regexp {^ANTENNAGATEAREA\s+([0-9.eE+-]+)} $l -> v]} {
            dict lappend pd gate $v
        } elseif {[regexp {^ANTENNADIFFAREA\s+([0-9.eE+-]+)} $l -> v]} {
            dict lappend pd diff $v
        } else {
            continue
        }
        dict set cells $macro pins $pin $pd
    }
    return $cells
}

proc ant_dont_use {name patterns} {
    foreach p $patterns { if {[string match -nocase $p $name]} { return $p } }
    return ""
}

proc ant_min_or_zero {l} {
    if {[llength $l] == 0} { return 0.0 }
    return [lindex [lsort -real $l] 0]
}

# 068: evaluate the candidate buffers `names` (already known to be non-inverting buffers of the library) against the LEF data.
# 068: criteria: (a) output diffusion >= diode_min; (b) input gate area >= need_gate; (c) not on the don't-use list; (d) exactly one signal input and one signal output.
# 068: rows: dict name area w h gate diff verdict(PASS|FAIL) why. The smallest gate and diffusion value listed in the LEF is used (conservative).
proc ant_eval_buffers {lef names dont_patterns need_gate diode_min} {
    set rows {}
    foreach name [lsort $names] {
        if {![dict exists $lef $name]} {
            lappend rows [dict create name $name area 0 w 0 h 0 gate 0 diff 0 verdict FAIL why "no MACRO in the LEF"]
            continue
        }
        set c [dict get $lef $name]
        set w [dict get $c w]
        set h [dict get $c h]
        set area [expr {($w eq "" || $h eq "") ? 0.0 : $w * $h}]
        set ins {}
        set outs {}
        dict for {pn pd} [dict get $c pins] {
            set use [dict get $pd use]
            set dir [dict get $pd dir]
            if {$use eq "POWER" || $use eq "GROUND" || $dir eq "INOUT"} continue
            if {$dir eq "INPUT"} { lappend ins $pn }
            if {$dir eq "OUTPUT"} { lappend outs $pn }
        }
        set gate 0.0
        set diff 0.0
        set why {}
        if {[llength $ins] != 1 || [llength $outs] != 1} {
            lappend why "(d) [llength $ins] signal inputs and [llength $outs] outputs"
        } else {
            set gate [ant_min_or_zero [dict get $c pins [lindex $ins 0] gate]]
            set diff [ant_min_or_zero [dict get $c pins [lindex $outs 0] diff]]
            if {$diff < $diode_min} { lappend why "(a) output diffusion [format %.3f $diff] < [format %.3f $diode_min]" }
            if {$gate < $need_gate} { lappend why "(b) input gate [format %.3f $gate] < [format %.3f $need_gate]" }
        }
        set du [ant_dont_use $name $dont_patterns]
        if {$du ne ""} { lappend why "(c) on the don't-use list ($du)" }
        lappend rows [dict create name $name area $area w $w h $h gate $gate diff $diff verdict [expr {[llength $why] ? "FAIL" : "PASS"}] why [join $why "; "]]
    }
    return $rows
}

# 068: the passing cell with the smallest footprint (ties: name); "" when none passes
proc ant_pick_buffer {rows} {
    set best ""
    set barea 0
    foreach r $rows {
        if {[dict get $r verdict] ne "PASS"} continue
        set a [dict get $r area]
        if {$best eq "" || $a < $barea} { set best [dict get $r name]; set barea $a }
    }
    return $best
}

# 068: where to put a buffer of size bw x bh for a pin at (px,py): the pin position clamped into the core box {x0 y0 x1 y1} and snapped to a row
# 068: (rows start at y0 with height bh). Returns {x y}.
proc ant_target_xy {px py bw bh core} {
    lassign $core cx0 cy0 cx1 cy1
    set tx [expr {$px - $bw / 2.0}]
    set ty [expr {$py - $bh / 2.0}]
    set tx [expr {min(max($tx, $cx0), $cx1 - $bw)}]
    set ty [expr {min(max($ty, $cy0), $cy1 - $bh)}]
    set ty [expr {$cy0 + floor(($ty - $cy0) / $bh + 0.5) * $bh}]
    if {$ty > $cy1 - $bh} { set ty [expr {$ty - $bh}] }
    return [list $tx $ty]
}

proc ant_manhattan {x1 y1 x2 y2} {
    return [expr {abs($x1 - $x2) + abs($y1 - $y2)}]
}

# 068: "Total number of DRCs = 1" style lines of check_routes -> number, or "" when the line is missing
proc ant_parse_count {text label} {
    set pat "(?i)total number of ${label}\\s*=\\s*(\[0-9\]+)"
    if {[regexp -- $pat $text -> n]} { return $n }
    return ""
}

# 068: check_legality text -> number of violations or "" (accepts "TOTAL 0 Violations", "Total N violations", and "N violation(s)"; "succeeded" alone is NOT a number)
proc ant_parse_legality {text} {
    foreach l [split $text "\n"] {
        if {[regexp -nocase -- {total\s+([0-9][0-9,]*)\s+violations?} $l -> n]} { return [string map {, {}} $n] }
    }
    foreach l [split $text "\n"] {
        if {[regexp -nocase -- {([0-9][0-9,]*)\s+(legality\s+)?violations?} $l -> n]} { return [string map {, {}} $n] }
    }
    return ""
}
# 069: group filler instances into contiguous runs per row. fillers: list of {name x0 y0 x1 y1 orient}. Returns a list of dicts:
# 069: y0 y1 x0 x1 orient fillers {{name x0 x1} ...} (fillers sorted by x). Two fillers are in one run when they touch (gap <= tol) in the same row.
proc ant_filler_runs {fillers {tol 0.001}} {
    set rows [dict create]
    foreach f $fillers { dict lappend rows [format %.3f [lindex $f 2]] $f }
    set runs {}
    foreach key [lsort -real [dict keys $rows]] {
        set cur {}
        foreach f [lsort -real -index 1 [dict get $rows $key]] {
            lassign $f name x0 y0 x1 y1 ori
            if {[llength $cur] > 0 && $x0 <= [dict get $cur x1] + $tol && abs($y1 - [dict get $cur y1]) <= $tol} {
                dict set cur x1 [expr {max([dict get $cur x1], $x1)}]
                dict lappend cur fillers [list $name $x0 $x1]
            } else {
                if {[llength $cur] > 0} { lappend runs $cur }
                set cur [dict create y0 $y0 y1 $y1 x0 $x0 x1 $x1 orient $ori fillers [list [list $name $x0 $x1]]]
            }
        }
        if {[llength $cur] > 0} { lappend runs $cur }
    }
    return $runs
}

# 070: evaluate ONE run for a buffer of width bw: returns a dict ok (0/1), reason ("" when ok), x (start site on the run's site grid, nearest to the pin),
# 070: dist (Manhattan from the pin to the buffer box centre), need (width needed in whole sites), width (of the run), near (Manhattan from the pin to the run's nearest point)
proc ant_run_eval {r bw site_w px py limit {tol 0.001}} {
    set span [expr {ceil($bw / $site_w - 1e-6) * $site_w}]
    set x0 [dict get $r x0]; set x1 [dict get $r x1]
    set y0 [dict get $r y0]; set y1 [dict get $r y1]
    set dx [expr {max($x0 - $px, 0.0, $px - $x1)}]
    set dy [expr {max($y0 - $py, 0.0, $py - $y1)}]
    set res [dict create ok 0 reason "" x $x0 dist 0.0 need $span width [expr {$x1 - $x0}] near [expr {$dx + $dy}]]
    if {$x1 - $x0 < $span - $tol} {
        dict set res reason "too narrow: width [format %.2f [expr {$x1 - $x0}]] < needed [format %.2f $span]"
        return $res
    }
    set nsteps [expr {int(floor(($x1 - $x0 - $span) / $site_w + 1e-6))}]
    set k [expr {int(floor(($px - $span / 2.0 - $x0) / $site_w + 0.5))}]
    if {$k < 0} { set k 0 }
    if {$k > $nsteps} { set k $nsteps }
    set xs [expr {$x0 + $k * $site_w}]
    set dist [ant_manhattan $px $py [expr {$xs + $bw / 2.0}] [expr {($y0 + $y1) / 2.0}]]
    dict set res x $xs
    dict set res dist $dist
    if {$dist > $limit} {
        dict set res reason "too far: dist [format %.2f $dist] > limit [format %.2f $limit]"
        return $res
    }
    dict set res ok 1
    return $res
}

# 069: candidate sites for a buffer of width bw: in every run at least as wide as the buffer (rounded up to whole sites) take the start site
# 069: nearest to the pin (px,py), on the site grid of the run. Keep the candidates whose box centre is within `limit` (Manhattan) of the pin, closest first
# 069: (ties: lower y, lower x). A candidate is a dict: x y w h dist orient names (the fillers to remove: those overlapping the buffer box) run_x0 run_x1.
proc ant_site_candidates {runs bw site_w px py limit {tol 0.001}} {
    set span [expr {ceil($bw / $site_w - 1e-6) * $site_w}]
    set list_ {}
    foreach r $runs {
        set ev [ant_run_eval $r $bw $site_w $px $py $limit $tol]
        if {![dict get $ev ok]} continue
        set xs [dict get $ev x]
        set x0 [dict get $r x0]; set x1 [dict get $r x1]
        set y0 [dict get $r y0]; set y1 [dict get $r y1]
        set names {}
        foreach f [dict get $r fillers] {
            lassign $f fname fx0 fx1
            if {min($fx1, $xs + $span) - max($fx0, $xs) > $tol} { lappend names $fname }
        }
        lappend list_ [list [dict get $ev dist] $y0 $xs [dict create x $xs y $y0 w $span h [expr {$y1 - $y0}] dist [dict get $ev dist] orient [dict get $r orient] names $names run_x0 $x0 run_x1 $x1]]
    }
    set list_ [lsort -real -index 2 $list_]
    set list_ [lsort -real -index 1 $list_]
    set list_ [lsort -real -index 0 $list_]
    return [lmap e $list_ {lindex $e 3}]
}

# 070: the nearest `n` runs (by Manhattan distance from the pin to the run's nearest point) with the reason each one is rejected ("" = usable). Lines of text.
proc ant_run_report {runs bw site_w px py limit {n 3} {tol 0.001}} {
    set evs {}
    foreach r $runs {
        set ev [ant_run_eval $r $bw $site_w $px $py $limit $tol]
        lappend evs [list [dict get $ev near] $r $ev]
    }
    set out {}
    foreach e [lrange [lsort -real -index 0 $evs] 0 [expr {$n - 1}]] {
        lassign $e near r ev
        lappend out [format "row y=%.2f x=%.2f..%.2f width=%.2f needed=%.2f nearest-point distance=%.1f: %s" [dict get $r y0] [dict get $r x0] [dict get $r x1] [dict get $ev width] [dict get $ev need] $near [expr {[dict get $ev ok] ? "usable (site x=[format %.2f [dict get $ev x]], centre distance [format %.1f [dict get $ev dist]])" : [dict get $ev reason]}]]
    }
    return $out
}

# 070: rows {name x0 y0 x1 y1 orient} that overlap the window (positive overlap in x and y); the window is given as four numbers
proc ant_rows_in_window {rows wx0 wy0 wx1 wy1} {
    set out {}
    foreach r $rows {
        lassign $r name x0 y0 x1 y1
        if {$x1 > $wx0 && $x0 < $wx1 && $y1 > $wy0 && $y0 < $wy1} { lappend out $r }
    }
    return $out
}

# 070: the table without the rows whose name is in `names`
proc ant_rows_remove {rows names} {
    array set gone {}
    foreach nm $names { set gone($nm) 1 }
    set out {}
    foreach r $rows { if {![info exists gone([lindex $r 0])]} { lappend out $r } }
    return $out
}

# 070: {xmin ymin xmax ymax} over the rows, "" for no row
proc ant_rows_extent {rows} {
    if {[llength $rows] == 0} { return "" }
    set xa 1e18; set ya 1e18; set xb -1e18; set yb -1e18
    foreach r $rows {
        lassign $r name x0 y0 x1 y1
        set xa [expr {min($xa, $x0)}]; set ya [expr {min($ya, $y0)}]
        set xb [expr {max($xb, $x1)}]; set yb [expr {max($yb, $y1)}]
    }
    return [list $xa $ya $xb $yb]
}

# 069: longest pin-to-buffer Manhattan distance (um) whose predicted antenna ratio stays at or below `ratio` for this gate area
proc ant_max_dist_for_ratio {gate_area width_um weight ratio} {
    return [expr {$ratio * $gate_area / (2.0 * $weight) - $width_um}]
}
# ---- END PURE TCL 068 ----

# 068: ICC2 side helpers (use ICC2 commands, not tested locally)
proc ant068_bbox_of {obj} {   ;# 068: VERIFY: the `bbox` attribute of shapes, terminals, pins and cells is a plain string with 4 numbers (it was in task 067)
    return [ant_bbox_nums [get_attribute -quiet $obj bbox]]
}
proc ant068_centre {obj} {
    lassign [ant068_bbox_of $obj] x0 y0 x1 y1
    return [list [expr {($x0 + $x1) / 2.0}] [expr {($y0 + $y1) / 2.0}]]
}
proc ant068_net_shapes {netname layer} {   ;# 068: shapes of one net on one layer: {net x0 y0 x1 y1}; the filter text is the one fix_antenna.tcl uses
    set out {}
    set sc [get_shapes -quiet -of_objects [get_nets -quiet -exact $netname] -filter "layer.name == $layer"]
    foreach_in_collection s $sc { lappend out [concat [list $netname] [ant068_bbox_of $s]] }
    return $out
}
proc ant068_slack {port scen type} {   ;# 068: worst slack of the paths starting at a port; VERIFY get_timing_paths ... and the `slack` attribute
    # 069: get_timing_paths rejects -quiet in this ICC2 (CMD-010); the real option list is in ~/server_pull/rpt/help/get_timing_paths.txt. A failure is printed ONCE, not per net.
    global ab_timing_err
    if {[catch {
        set p [get_timing_paths -scenarios $scen -from [get_ports -quiet -exact $port] -delay_type $type -max_paths 1]
        if {[sizeof_collection $p] == 0} { set r "n/a" } else { set r [get_attribute $p slack] }
    } err]} {
        if {![info exists ab_timing_err]} {
            set ab_timing_err $err
            puts ">>> 069 per-net timing unavailable: $err"
        }
        return "unavailable"
    }
    return $r
}
proc ant069_filler_rows {win filter} {   ;# 069: fillers intersecting a window -> list of {name x0 y0 x1 y1 orientation}; VERIFY get_cells -intersect finds fillers, and the `orientation` attribute
    # 070: NOT used by the ECO any more (see ant070_all_fillers); kept for pnr_v2/diag_filler_runs.tcl, which compares it with the table
    set rows {}
    foreach_in_collection f [get_cells -quiet -intersect $win -filter $filter] {
        lappend rows [concat [list [get_object_name $f]] [ant068_bbox_of $f] [list [get_attribute -quiet $f orientation]]]
    }
    return $rows
}
proc ant070_all_fillers {filter} {   ;# 070: ALL filler instances once, with no geometric query: {name x0 y0 x1 y1 {}} (orientation is read only for the fillers that are removed)
    set rows {}
    foreach_in_collection f [get_cells -quiet -filter $filter] {
        lappend rows [concat [list [get_object_name $f]] [ant068_bbox_of $f] [list {}]]
    }
    return $rows
}
proc ant068_net_leaf_pins {netname} {   ;# 068: names of the leaf pins on a net; VERIFY get_pins -leaf -of_objects <net>
    set out {}
    foreach_in_collection p [get_pins -quiet -leaf -of_objects [get_nets -quiet -exact $netname]] { lappend out [get_object_name $p] }
    return $out
}
proc ant068_check_routes_counts {} {   ;# 068: run check_routes, return {drc opens antenna} from its "Verify Summary" (text as in fix_antenna2_console.log)
    redirect -variable ab_cr_txt { check_routes }
    puts $ab_cr_txt
    return [list [ant_parse_count $ab_cr_txt "DRCs"] [ant_parse_count $ab_cr_txt "open nets"] [ant_parse_count $ab_cr_txt "antenna violations"]]
}

file mkdir $LOG_DIR
file mkdir $RPT_DIR

redirect -tee -file ${LOG_DIR}/6c_antenna_port_buffers.log {
    puts ">>> RUN ROOT: $RUN_ROOT"   ;# 082: the log shows which clone wrote it

    set ab_failures {}

    set open_blk [get_blocks -quiet *]
    if {[sizeof_collection $open_blk] > 0} {
        close_blocks -force $open_blk
    }
    set open_lib [get_libs -quiet *]
    if {[sizeof_collection $open_lib] > 0} {
        foreach_in_collection lib_obj $open_lib {
            close_lib -force $lib_obj
        }
    }

    open_lib ${BLOCKS_DIR}/${DESIGN_NAME}.dlib
    open_block ${DESIGN_NAME}.dlib:${DESIGN_NAME}_route
    current_block ${DESIGN_NAME}_route
    link_block
    unpu_remove_clock_latency antenna_port_buffers   ;# 088: remove the tool-made set_clock_latency (a no-op when the block is clean); prints the counts per scenario, ERROR 088 if any is left
    puts ">>> 068 block ${DESIGN_NAME}_route opened (it is overwritten in place at the end; the README tells the user to back up the library first)"

    # --------------------------------------------------------------------------
    # 1. Parse the Calibre antenna database
    # --------------------------------------------------------------------------
    if {![file exists $ANT_DB]} { error "ERROR 068: Cannot find the Calibre antenna DB at $ANT_DB (README step 6c copies the NEW run's unpu_top.ant.db there)" }
    set fp [open $ANT_DB r]
    set ab_db [ant_parse_db [read $fp]]
    close $fp
    set ab_polys [dict get $ab_db polys]
    puts ">>> 068 database $ANT_DB: top '[dict get $ab_db top]', [dict get $ab_db dbu] units per um, [llength $ab_polys] polygons"
    array set ab_rule_count {}
    foreach p $ab_polys {
        set r [dict get $p rule]
        if {![info exists ab_rule_count($r)]} { set ab_rule_count($r) 0 }
        incr ab_rule_count($r)
    }
    foreach r [lsort [array names ab_rule_count]] { puts ">>> 068   rule $r: $ab_rule_count($r) polygons" }
    puts ">>> 068 polygons: [llength $ab_polys], expectation of task 068: $EXPECT_POLYGONS (a different number is not an error: the database may be a newer Calibre run)"
    if {[llength $ab_polys] == 0} { error "ERROR 068: the database holds no polygon, nothing to do" }

    # --------------------------------------------------------------------------
    # 2. Port nets and the shapes of those nets, then polygon -> net
    # --------------------------------------------------------------------------
    array set ab_port_of_net {}
    array set ab_net_of_port {}
    array set ab_port_dir {}
    set ab_bad_ports {}
    foreach_in_collection p [get_ports -quiet *] {
        set pn [get_object_name $p]
        if {[lsearch -exact $POWER_PORT_NAMES $pn] >= 0} continue
        set nc [get_nets -quiet -of_objects $p]   ;# 068: VERIFY get_nets -of_objects <port> returns exactly one net
        if {[sizeof_collection $nc] != 1} { lappend ab_bad_ports $pn; continue }
        set nn [get_object_name $nc]
        set ab_port_of_net($nn) $pn
        set ab_net_of_port($pn) $nn
        set ab_port_dir($pn) [get_attribute -quiet $p direction]   ;# 068: VERIFY: `direction` of a port is in / out
    }
    puts ">>> 068 signal ports with one net: [array size ab_net_of_port]; ports without exactly one net: [llength $ab_bad_ports] $ab_bad_ports"
    if {[array size ab_net_of_port] == 0} { error "ERROR 068: no port net found (VERIFY get_ports / get_nets -of_objects)" }

    set ab_layers {}
    foreach p $ab_polys {
        set l [ant_rule_layer [dict get $p rule]]
        if {$l ne "" && [lsearch -exact $ab_layers $l] < 0} { lappend ab_layers $l }
    }
    puts ">>> 068 layers to read: $ab_layers; reading the shapes of [array size ab_net_of_port] port nets (a few minutes at most)"
    array set ab_shapes {}
    foreach l $ab_layers {
        set ab_shapes($l) {}
        foreach pn [lsort [array names ab_net_of_port]] {
            set ab_shapes($l) [concat $ab_shapes($l) [ant068_net_shapes $ab_net_of_port($pn) $l]]
        }
        puts ">>> 068   layer $l: [llength $ab_shapes($l)] port-net shapes"
    }

    array set ab_net_polys {}
    set ab_unresolved {}
    foreach p $ab_polys {
        set rule [dict get $p rule]
        set pid  [dict get $p id]
        lassign [dict get $p bbox] x0 y0 x1 y1
        set lyr [ant_rule_layer $rule]
        set tag "$rule #$pid"
        if {$lyr eq ""} {
            puts ">>> 068 POLY $tag bbox=($x0,$y0)->($x1,$y1) UNRESOLVED: the rule is not a metal-area rule of M1/M2/M3/MT"
            lappend ab_unresolved "$tag: rule without a layer"
            continue
        }
        # candidates: shapes of port nets that overlap the bbox, plus ALL nets seen by get_shapes -intersect (information, and a port net must beat them)
        set cands {}
        foreach s $ab_shapes($lyr) {
            lassign [lrange $s 1 4] sx0 sy0 sx1 sy1
            if {$sx1 >= $x0 && $sx0 <= $x1 && $sy1 >= $y0 && $sy0 <= $y1} { lappend cands $s }
        }
        set others {}
        set win [list [list [expr {$x0 - 0.05}] [expr {$y0 - 0.05}]] [list [expr {$x1 + 0.05}] [expr {$y1 + 0.05}]]]
        foreach_in_collection s [get_shapes -quiet -intersect $win -filter "layer.name == $lyr"] {   ;# 068: unreliable alone (handoff 18.26); used as extra competitors only
            set nc [get_nets -quiet -of_objects $s -filter "net_type == signal || net_type == clock"]   ;# 068: power and ground stripes are not competitors (same filter as fix_antenna.tcl)
            if {[sizeof_collection $nc] == 0} continue
            set nn [get_object_name [index_collection $nc 0]]
            if {[array names ab_port_of_net -exact $nn] ne ""} continue
            lappend cands [concat [list $nn] [ant068_bbox_of $s]]
            if {[lsearch -exact $others $nn] < 0} { lappend others $nn }
        }
        set ranks [ant_rank $p $cands $TOL_UM]
        lassign [ant_decide $ranks $MARGIN_SCORE $MIN_COVER] st chosen note
        set top3 {}
        foreach r [lrange $ranks 0 2] { lappend top3 "[lindex $r 0]:t[lindex $r 1]:[format %.2f [lindex $r 2]]" }
        if {$st eq "OK" && [array names ab_port_of_net -exact $chosen] eq ""} {
            set st NONPORT
            set note "best net $chosen is not connected to a port ($note)"
            set chosen ""
        }
        if {$st eq "OK"} {
            set pn $ab_port_of_net($chosen)
            if {$ab_port_dir($pn) ne "" && [string match -nocase "out*" $ab_port_dir($pn)]} {
                set st OUTPORT
                set note "net $chosen belongs to OUTPUT port $pn (it has a driver; a buffer at the pin does not help)"
                set chosen ""
            }
        }
        puts ">>> 068 POLY $tag layer $lyr bbox=($x0,$y0)->($x1,$y1) candidates=[llength $cands] ranks=[join $top3 { }] others_seen=[llength $others] chosen=[expr {$chosen eq {} ? {none} : $chosen}] status=$st ($note)"
        if {$st eq "OK"} {
            lappend ab_net_polys($chosen) $tag
        } else {
            lappend ab_unresolved "$tag bbox=($x0,$y0)->($x1,$y1): $st, $note"
        }
    }
    puts ">>> 068 polygons resolved: [expr {[llength $ab_polys] - [llength $ab_unresolved]}] of [llength $ab_polys]; unresolved: [llength $ab_unresolved]"
    foreach u $ab_unresolved { puts ">>> 068 UNRESOLVED $u" }
    if {[llength $ab_unresolved] > 0} {
        error "ERROR 068: [llength $ab_unresolved] polygon(s) could not be assigned to a port net (listed above). Nothing was changed. Decide those by hand (get_shapes at the bbox, see handoff 18.26/18.27)."
    }

    # --------------------------------------------------------------------------
    # 3. The set of port nets and the comparison with the expectation
    # --------------------------------------------------------------------------
    set ab_set [lsort [array names ab_net_polys]]
    puts ">>> 068 port nets with antenna polygons: [llength $ab_set]"
    foreach n $ab_set { puts ">>> 068   $n (port $ab_port_of_net($n)): [llength $ab_net_polys($n)] polygons: [join $ab_net_polys($n) {, }]" }
    set ab_missing {}
    foreach e $EXPECT_PORT_NETS { if {[lsearch -exact $ab_set $e] < 0} { lappend ab_missing $e } }
    set ab_extra {}
    foreach n $ab_set { if {[lsearch -exact $EXPECT_PORT_NETS $n] < 0} { lappend ab_extra $n } }
    puts ">>> 068 compared with the [llength $EXPECT_PORT_NETS] nets expected by task 068: expected but not found: [llength $ab_missing] $ab_missing; found but not expected: [llength $ab_extra] $ab_extra"

    # --------------------------------------------------------------------------
    # 4. Clock nets are not buffered: print what Planning needs
    # --------------------------------------------------------------------------
    set ab_clk_ports {}
    foreach_in_collection c [get_clocks -quiet -filter "is_virtual == false"] {
        foreach_in_collection s [get_attribute -quiet $c sources] { lappend ab_clk_ports [get_object_name $s] }   ;# 068: VERIFY the `sources` attribute of a clock
    }
    puts ">>> 068 clock source ports: $ab_clk_ports"
    set ab_targets {}
    set ab_clk_nets {}
    foreach n $ab_set {
        set pn $ab_port_of_net($n)
        set nt [get_attribute -quiet [get_nets -quiet -exact $n] net_type]
        if {[lsearch -exact $ab_clk_ports $pn] >= 0 || $nt eq "clock"} { lappend ab_clk_nets $n } else { lappend ab_targets $n }
    }
    puts ">>> 068 nets to buffer: [llength $ab_targets]; clock nets left alone: [llength $ab_clk_nets] $ab_clk_nets"
    foreach n $ab_clk_nets {
        set pn $ab_port_of_net($n)
        set t [get_terminals -quiet -of_objects [get_ports -quiet -exact $pn]]
        if {[sizeof_collection $t] == 0} { puts ">>> 068 CLOCK $n: no terminal found"; continue }
        lassign [ant068_centre [index_collection $t 0]] cpx cpy
        puts ">>> 068 CLOCK $n (port $pn): pin at ([format %.2f $cpx], [format %.2f $cpy]); polygons: [join $ab_net_polys($n) {, }]"
        set cl {}
        foreach lp [ant068_net_leaf_pins $n] {
            lassign [ant068_centre [get_pins -quiet -exact $lp]] lx ly
            lappend cl [list $lp $lx $ly [ant_manhattan $cpx $cpy $lx $ly]]
        }
        foreach r [lrange [lsort -real -index 3 $cl] 0 4] { puts ">>> 068 CLOCK $n load [lindex $r 0] at ([format %.2f [lindex $r 1]], [format %.2f [lindex $r 2]]) Manhattan distance from the pin [format %.1f [lindex $r 3]] um" }
        puts ">>> 068 CLOCK $n: [llength $cl] leaf loads on the port net (the CTS root); NOT buffered by this script (a buffer before the CTS root shifts the clock latency and the I/O timing: decision for Planning)"
    }
    if {[llength $ab_targets] == 0} { error "ERROR 068: no non-clock port net to buffer" }

    # --------------------------------------------------------------------------
    # 5. Buffer cell chosen by data
    # --------------------------------------------------------------------------
    if {![file exists $STD_LEF]} { error "ERROR 068: kit LEF not found at $STD_LEF" }
    set fp [open $STD_LEF r]
    set ab_lef [ant_parse_lef [read $fp]]
    close $fp
    puts ">>> 068 LEF $STD_LEF: [dict size $ab_lef] macros"
    set ab_bufnames {}
    set ab_libcell_of {}
    if {[catch {set ab_lc [get_lib_cells -quiet ${STD_LIB}/* -filter "is_buffer == true"]} err]} {   ;# 068: VERIFY lib_cell attribute is_buffer (non-inverting buffer)
        error "ERROR 068: cannot select buffers with the lib_cell attribute is_buffer: $err"
    }
    foreach_in_collection lc $ab_lc {
        set full [get_object_name $lc]
        set short [lindex [split $full /] end]
        set du [get_attribute -quiet $lc dont_use]
        if {$du eq "true"} { puts ">>> 068   $short: dont_use attribute is true in the library, skipped"; continue }
        lappend ab_bufnames $short
        lappend ab_libcell_of $short $full
    }
    puts ">>> 068 library buffers (is_buffer, not dont_use): [llength $ab_bufnames]"
    if {[llength $ab_bufnames] == 0} { error "ERROR 068: no buffer cell found in ${STD_LIB}" }
    set ab_need [ant_need_gate $PIN_WIRE_UM $WIRE_WIDTH_UM $ANT_WEIGHT_PINWIRE $ANT_RATIO_LIMIT $GATE_SAFETY]
    puts ">>> 068 requirements: (a) output diffusion >= $DIODE_MIN_AREA um^2; (b) input gate >= [format %.4f $ab_need] um^2 for a ${PIN_WIRE_UM} um wire (2 x (L+W) x $ANT_WEIGHT_PINWIRE / $ANT_RATIO_LIMIT x $GATE_SAFETY); (c) not in {$DONT_USE_PATTERNS}; (d) one input, one output, non-inverting"
    set ab_rows [ant_eval_buffers $ab_lef $ab_bufnames $DONT_USE_PATTERNS $ab_need $DIODE_MIN_AREA]
    puts ">>> 068 candidate table (name, footprint um^2, input gate um^2, output diffusion um^2, verdict, reason):"
    foreach r [lsort -real -index 3 [lmap r $ab_rows {list [dict get $r name] [dict get $r verdict] [dict get $r why] [dict get $r area] [dict get $r gate] [dict get $r diff]}]] {
        puts [format ">>> 068   %-12s area %8.2f  gate %7.3f  diff %7.3f  %s  %s" [lindex $r 0] [lindex $r 3] [lindex $r 4] [lindex $r 5] [lindex $r 1] [lindex $r 2]]
    }
    set ab_buf [ant_pick_buffer $ab_rows]
    if {$ab_buf eq ""} {
        error "ERROR 068: no library buffer meets (a) to (d); see the candidate table above"
    }
    foreach r $ab_rows { if {[dict get $r name] eq $ab_buf} { set ab_buf_row $r } }
    set ab_buf_lc [dict get $ab_libcell_of $ab_buf]
    set ab_bw [dict get $ab_buf_row w]
    set ab_bh [dict get $ab_buf_row h]
    puts ">>> 068 CHOSEN buffer $ab_buf_lc: smallest footprint ([format %.2f [dict get $ab_buf_row area]] um^2, ${ab_bw} x ${ab_bh}) among the cells that pass (a) to (d); input gate [format %.3f [dict get $ab_buf_row gate]] um^2, output diffusion [format %.3f [dict get $ab_buf_row diff]] um^2"

    # --------------------------------------------------------------------------
    # 6. Measurements before the ECO
    # --------------------------------------------------------------------------
    set ab_rows_sites [get_site_rows -quiet]   ;# 068: VERIFY: the core box = union of the site row boxes
    if {[sizeof_collection $ab_rows_sites] == 0} { error "ERROR 068: no site rows found" }
    set cx0 1e9; set cy0 1e9; set cx1 -1e9; set cy1 -1e9
    foreach_in_collection sr $ab_rows_sites {
        lassign [ant068_bbox_of $sr] a b c d
        set cx0 [expr {min($cx0, $a)}]; set cy0 [expr {min($cy0, $b)}]; set cx1 [expr {max($cx1, $c)}]; set cy1 [expr {max($cy1, $d)}]
    }
    set ab_core [list $cx0 $cy0 $cx1 $cy1]
    puts ">>> 068 core box from the site rows: ($cx0,$cy0)->($cx1,$cy1) (rows [sizeof_collection $ab_rows_sites])"

    update_timing -full
    puts ">>> 068 ===== report_global_timing BEFORE ====="
    report_global_timing
    array set ab_pin_xy {}
    array set ab_loads_before {}
    array set ab_slack0 {}
    foreach n $ab_targets {
        set pn $ab_port_of_net($n)
        set t [get_terminals -quiet -of_objects [get_ports -quiet -exact $pn]]
        if {[sizeof_collection $t] == 0} { lappend ab_failures "net $n: port $pn has no terminal"; continue }
        set ab_pin_xy($n) [ant068_centre [index_collection $t 0]]
        set ab_loads_before($n) [llength [ant068_net_leaf_pins $n]]
        set ab_slack0($n) [list [ant068_slack $pn $SETUP_SCEN max] [ant068_slack $pn $HOLD_SCEN min]]
        if {[info exists ab_timing_err]} {   ;# 069: no error text as a result
            puts ">>> 068 BEFORE $n: pin ([format %.2f [lindex $ab_pin_xy($n) 0]], [format %.2f [lindex $ab_pin_xy($n) 1]]), leaf loads $ab_loads_before($n)"
        } else {
            puts ">>> 068 BEFORE $n: pin ([format %.2f [lindex $ab_pin_xy($n) 0]], [format %.2f [lindex $ab_pin_xy($n) 1]]), leaf loads $ab_loads_before($n), worst slack from the port: setup [lindex $ab_slack0($n) 0] ($SETUP_SCEN), hold [lindex $ab_slack0($n) 1] ($HOLD_SCEN)"
        }
    }
    if {[llength $ab_failures] > 0} { error "ERROR 068: [join $ab_failures {; }]" }
    set ab_anti_before [ant068_check_routes_counts]
    puts ">>> 068 check_routes BEFORE: DRCs [lindex $ab_anti_before 0], open nets [lindex $ab_anti_before 1], ICC2 antenna violations [lindex $ab_anti_before 2] (ICC2 skips port nets, Calibre decides)"
    set ab_drc_before [lindex $ab_anti_before 0]

    # --------------------------------------------------------------------------
    # 7. ECO (069): pick a free run of FILLER sites per net, remove exactly those fillers, insert, place on the site, verify, undo and retry on failure
    # --------------------------------------------------------------------------
    # 069: the first server run asked the legaliser to find a site in a cleared window; two buffers were moved 360 and 1080 um away (it never fails, it moves).
    # 069: now the site is chosen here from the fillers that route.tcl created, and the result is verified (position and distance) before the next net.
    set ab_filter {}
    foreach f $FILLER_REFS { lappend ab_filter "ref_name == $f" }
    set ab_filter [join $ab_filter " || "]
    set ab_site_w 1e9
    foreach f $FILLER_REFS {   ;# 069: the site width is the width of the narrowest filler master in the LEF (data, not typed)
        if {[dict exists $ab_lef $f] && [dict get $ab_lef $f w] ne "" && [dict get $ab_lef $f w] < $ab_site_w} { set ab_site_w [dict get $ab_lef $f w] }
    }
    if {$ab_site_w > 1e8} { error "ERROR 069: none of the filler masters $FILLER_REFS is in the LEF, the site width is unknown" }
    # 070: the first server run of 069 found 0 usable sites for all nets and "the nearest free run" about 300 um away (the half size of the wide window) for every pin:
    # 070: the candidates were all at the border of the search window, so get_cells -intersect with a rectangle returned the cells at the window border, not the interior (cause
    # 070: inferred from the numbers, to be confirmed by pnr_v2/diag_filler_runs.tcl). The ECO therefore reads every filler ONCE without a geometric query and selects the
    # 070: window in Tcl (ant_rows_in_window). Removed fillers are deleted from the table (they are refilled at the end).
    set ab_t0 [clock seconds]
    set ab_ftable [ant070_all_fillers $ab_filter]
    puts ">>> 070 filler table: [llength $ab_ftable] filler instances read in [expr {[clock seconds] - $ab_t0}] s, extent [ant_rows_extent $ab_ftable]"
    if {[llength $ab_ftable] == 0} { error "ERROR 070: no filler instance found with the filter '$ab_filter' (the design has fillers: route.tcl creates them)" }
    set ab_gate [dict get $ab_buf_row gate]
    set ab_tier2_dist [ant_max_dist_for_ratio $ab_gate $WIRE_WIDTH_UM $ANT_WEIGHT_PINWIRE $TIER2_RATIO]
    puts ">>> 069 site width $ab_site_w um (narrowest of $FILLER_REFS in the LEF), buffer $ab_buf is ${ab_bw} um wide = [expr {int(ceil($ab_bw / $ab_site_w - 1e-6))}] sites; tier 1 limit $MAX_PIN_BUF_DIST um; tier 2 limit [format %.1f $ab_tier2_dist] um (predicted M2/M3 ratio <= $TIER2_RATIO with gate [format %.3f $ab_gate])"
    array set ab_cell_of {}
    array set ab_newnet_of {}
    array set ab_tier {}
    array set ab_lim {}
    set ab_removed 0
    set ab_failed {}
    set k 0
    foreach n $ab_targets {
        set pn $ab_port_of_net($n)
        lassign $ab_pin_xy($n) px py
        set ab_cell_of($n) ""
        set placed 0
        set tried {}
        foreach tier {1 2} {
            if {$placed} break
            set lim [expr {$tier == 1 ? $MAX_PIN_BUF_DIST : $ab_tier2_dist}]
            if {$tier == 2 && $lim <= $MAX_PIN_BUF_DIST} continue
            set L [expr {$lim + $ab_bw + $ab_bh}]
            set win [list [list [expr {$px - $L}] [expr {$py - $L}]] [list [expr {$px + $L}] [expr {$py + $L}]]]
            set frows [ant_rows_in_window $ab_ftable [expr {$px - $L}] [expr {$py - $L}] [expr {$px + $L}] [expr {$py + $L}]]   ;# 070: window selection in Tcl
            set runs [ant_filler_runs $frows]
            set cands {}
            foreach c [ant_site_candidates $runs $ab_bw $ab_site_w $px $py $lim] {
                if {[lsearch -exact $tried [list [dict get $c x] [dict get $c y]]] < 0} { lappend cands $c }
            }
            puts ">>> 069 $n tier $tier: limit [format %.1f $lim] um, [llength $frows] fillers in the search window, [llength $runs] runs, [llength $cands] usable candidate sites"
            if {[llength $cands] == 0} {   ;# 070: nothing fails silently: say why, run by run
                puts ">>> 070 $n tier $tier: 0 usable candidates. pin=([format %.3f $px], [format %.3f $py]) window=({[format %.3f [expr {$px - $L}]] [format %.3f [expr {$py - $L}]]} {[format %.3f [expr {$px + $L}]] [format %.3f [expr {$py + $L}]]}) buffer width $ab_bw needs [format %.2f [expr {ceil($ab_bw / $ab_site_w - 1e-6) * $ab_site_w}]] um of contiguous filler, site width $ab_site_w"
                if {[llength $runs] == 0} { puts ">>> 070 $n tier $tier:   no filler run in the window" }
                foreach ln [ant_run_report $runs $ab_bw $ab_site_w $px $py $lim 3] { puts ">>> 070 $n tier $tier:   nearest run: $ln" }
            }
            if {![info exists ab_070_first]} {   ;# 070: for the FIRST net only: the raw rows and the extent, so a wrong query is visible
                set ab_070_first 1
                puts ">>> 070 first net $n: first 3 filler rows of the window {name x0 y0 x1 y1 orient}: [lrange $frows 0 2]"
                puts ">>> 070 first net $n: extent of the [llength $frows] window fillers [ant_rows_extent $frows] (window $win)"
            }
            set ntry 0
            foreach c $cands {
                if {$ntry >= $MAX_SITE_TRIES} break
                incr ntry
                set cx [dict get $c x]; set cy [dict get $c y]
                lappend tried [list $cx $cy]
                set rm [dict get $c names]
                set flc [get_cells -quiet -exact $rm]
                if {[sizeof_collection $flc] != [llength $rm]} {
                    puts ">>> 069 BUFFER $n tier $tier candidate ($cx, $cy): only [sizeof_collection $flc] of [llength $rm] filler names found, candidate skipped"
                    continue
                }
                set ori0 [get_attribute -quiet [index_collection $flc 0] orientation]   ;# 070: VERIFY `orientation` of a filler (MX / N / FS ...), read here only for the removed fillers
                remove_cells $flc   ;# 069: VERIFY remove_cells on the filler instances (as in task 068)
                set ab_ftable [ant_rows_remove $ab_ftable $rm]   ;# 070: the table follows the design
                incr ab_removed [llength $rm]
                set base "${BUF_PREFIX}_[regsub -all {[^A-Za-z0-9]} $pn _]_${k}_t${tier}a${ntry}"
                insert_buffer -lib_cell [get_lib_cells -exact $ab_buf_lc] -new_cell_names $base -new_net_names ${base}_n [get_ports -exact $pn]   ;# 068: VERIFY insert_buffer on a PORT puts the buffer between the port and all its loads (usage text: add_buffer ... object_list = nets, ports or pins)
                set bname ""
                foreach_in_collection c2 [get_cells -quiet -of_objects [get_nets -quiet -exact $n]] {
                    if {[get_attribute -quiet $c2 ref_name] eq $ab_buf} { set bname [get_object_name $c2] }
                }
                if {$bname eq ""} { error "ERROR 069: net $n: no cell of type $ab_buf found on the port net after insert_buffer (nothing saved)" }
                set bc [get_cells -exact $bname]
                set op [get_pins -quiet -of_objects $bc -filter "direction == out"]   ;# 068: VERIFY pin attribute direction == out
                if {[sizeof_collection $op] != 1} { error "ERROR 069: net $n: buffer $bname has [sizeof_collection $op] output pins (nothing saved)" }
                set newnet [get_object_name [get_nets -quiet -of_objects $op]]
                set sargs [list -coordinates [list $cx $cy]]
                if {$ori0 ne ""} { lappend sargs -orientation $ori0 }   ;# 069: the row's orientation, read from the removed fillers (070: read just before the removal)
                if {[catch {set_cell_location {*}$sargs $bc} err]} {   ;# 068: VERIFY set_cell_location (the first server run accepted -coordinates); 069: VERIFY -orientation
                    puts ">>> 069 set_cell_location failed ($err), trying the origin attribute"
                    if {[catch {set_attribute -objects $bc -name origin -value [list $cx $cy]} err2]} { error "ERROR 069: net $n: cannot move $bname: $err / $err2 (nothing saved)" }
                }
                legalize_placement -cells $bc   ;# 069: only this cell; at a free site it must not move
                lassign [ant068_bbox_of $bc] bx0 by0 bx1 by1
                set dpos [ant_manhattan $bx0 $by0 $cx $cy]
                set inp [get_pins -quiet -of_objects $bc -filter "direction == in"]   ;# 068: VERIFY pin attribute direction == in
                lassign [expr {[sizeof_collection $inp] == 1 ? [ant068_centre $inp] : [ant068_centre $bc]}] ix iy
                set dist [ant_manhattan $px $py $ix $iy]
                set ratio [ant_ratio $ab_gate $dist $WIRE_WIDTH_UM $ANT_WEIGHT_PINWIRE]
                set why {}
                if {$dpos > 0.001} { lappend why "buffer at ([format %.3f $bx0], [format %.3f $by0]) instead of the site ([format %.3f $cx], [format %.3f $cy])" }
                if {$dist > $lim} { lappend why "distance [format %.1f $dist] > [format %.1f $lim]" }
                puts [format ">>> 069 BUFFER %s tier %d pin=(%.2f, %.2f) run: row y=%.2f x=%.2f..%.2f fillers_removed=%d %s buffer=%s site=(%.3f, %.3f) final=(%.3f, %.3f) distance=%.1f um predicted_ratio=%.0f %s" \
                    $n $tier $px $py $cy [dict get $c run_x0] [dict get $c run_x1] [llength $rm] $rm $bname $cx $cy $bx0 $by0 $dist $ratio [expr {[llength $why] ? "REJECTED: [join $why {; }]" : "OK"}]]
                if {[llength $why] == 0} {
                    set ab_cell_of($n) $bname
                    set ab_newnet_of($n) $newnet
                    set ab_tier($n) $tier
                    set ab_lim($n) $lim
                    set placed 1
                    if {$tier == 2} {
                        puts ">>> 069 $n: TIER 2: no usable filler run within $MAX_PIN_BUF_DIST um; buffer [format %.1f $dist] um from the pin, predicted M2/M3 ratio [format %.0f $ratio] (<= $TIER2_RATIO); the route of this port net is limited to layers up to $TIER2_MAX_LAYER"
                        set_routing_rule -max_routing_layer $TIER2_MAX_LAYER -max_layer_mode hard [get_nets -quiet -exact $n]   ;# 069: VERIFY set_routing_rule on a signal net (usage text); 'hard' = the route may not use a layer above M3 (TOP_M weight 0.84 allows only about 45 um)
                    }
                    break
                }
                # undo this net and retry with the next candidate
                if {[catch {remove_buffers $bc} err]} { error "ERROR 069: net $n: cannot remove the rejected buffer $bname: $err (nothing saved)" }   ;# 069: VERIFY remove_buffers restores the original net
                set back [llength [ant068_net_leaf_pins $n]]
                if {$back != $ab_loads_before($n)} { error "ERROR 069: net $n: $back leaf pins after removing the rejected buffer, $ab_loads_before($n) before (nothing saved)" }
                puts ">>> 069 $n: rejected buffer $bname removed, net restored ($back leaf pins)"
            }
        }
        if {!$placed} {
            set wide [ant_site_candidates [ant_filler_runs [ant_rows_in_window $ab_ftable [expr {$px - 300.0}] [expr {$py - 300.0}] [expr {$px + 300.0}] [expr {$py + 300.0}]]] $ab_bw $ab_site_w $px $py 1e9]   ;# 069: only for the message: the nearest free run in a wider window (070: from the table)
            if {[llength $wide] > 0} { set nearest "nearest free filler run at [format %.1f [dict get [lindex $wide 0] dist]] um" } else { set nearest "no free filler run within 300 um" }
            puts ">>> 069 BUFFER $n FAILED: no site within the tier 1 limit ($MAX_PIN_BUF_DIST um) or the tier 2 limit ([format %.1f $ab_tier2_dist] um); $nearest"
            lappend ab_failed "$n ($nearest)"
        }
        incr k
    }
    puts ">>> 068 fillers removed: $ab_removed"
    if {[llength $ab_failed] > 0} { error "ERROR 069: [llength $ab_failed] net(s) FAILED to get a buffer site, nothing saved (the design in memory is not saved): [join $ab_failed {; }]" }

    set fill_cells [get_lib_cells -quiet [lmap f $FILLER_REFS {string cat ${FILLER_LIB}/ $f}]]   ;# 068: the same selection as route.tcl
    if {[sizeof_collection $fill_cells] == 0} { set fill_cells [get_lib_cells -quiet {*/feedth9 */feedth3 */feedth}] }
    if {[sizeof_collection $fill_cells] > 0} {
        create_stdcell_fillers -lib_cells $fill_cells   ;# 068: as route.tcl: only empty sites are filled, the other fillers stay
    } else {
        lappend ab_failures "filler cells not found, the removed fillers are not restored"
    }
    connect_pg_net -automatic
    connect_pg_net -net VDD [get_pins -hierarchical -quiet */VDD]
    connect_pg_net -net VSS [get_pins -hierarchical -quiet */VSS]

    # --------------------------------------------------------------------------
    # 8. Re-route only the touched nets
    # --------------------------------------------------------------------------
    set ab_touched {}
    foreach n $ab_targets {
        lappend ab_touched $n $ab_newnet_of($n)
    }
    set ab_touched_coll [get_nets -quiet -exact $ab_touched]
    puts ">>> 068 nets to re-route: [sizeof_collection $ab_touched_coll] ($ab_touched)"
    remove_routes -nets $ab_touched_coll -detail_route
    route_eco \
        -nets $ab_touched_coll \
        -reuse_existing_global_route false \
        -reroute modified_nets_first_then_others \
        -max_detail_route_iterations 60
    route_eco \
        -open_net_driven true \
        -reuse_existing_global_route true \
        -reroute modified_nets_first_then_others \
        -max_detail_route_iterations 40
    route_detail -incremental true -max_number_iterations 40

    # --------------------------------------------------------------------------
    # 9. Leftover DRC markers (the task expects M3.S.1 near (127.8, 287.0))
    # --------------------------------------------------------------------------
    set ab_cr [ant068_check_routes_counts]
    set ab_drc [lindex $ab_cr 0]
    puts ">>> 068 check_routes after the ECO: DRCs $ab_drc (before $ab_drc_before), open nets [lindex $ab_cr 1], ICC2 antenna violations [lindex $ab_cr 2]"
    if {$ab_drc ne "" && $ab_drc > 0} {
        puts ">>> 068 DRC error list (VERIFY the command: get_drc_errors with the error data of check_routes):"
        if {[catch {
            foreach_in_collection e [get_drc_errors -quiet -error_data zroute.err *] {   ;# 068: VERIFY get_drc_errors and the error data name
                puts ">>> 068   DRC [get_attribute -quiet $e type_name] bbox [get_attribute -quiet $e bounding_box]"
            }
        } err]} { puts ">>> 068   could not list the DRC errors: $err" }
        set ab_wins {}
        if {[file exists $DRC_DB]} {   ;# 068: the Calibre DRC markers give the locations (same ASCII format as the antenna database)
            set fp [open $DRC_DB r]
            set ab_drcdb [ant_parse_db [read $fp]]
            close $fp
            foreach p [dict get $ab_drcdb polys] {
                lassign [dict get $p bbox] a b c d
                puts ">>> 068   Calibre marker [dict get $p rule] #[dict get $p id] at ($a,$b)->($c,$d)"
                lappend ab_wins [list [list [expr {$a - 5.0}] [expr {$b - 5.0}]] [list [expr {$c + 5.0}] [expr {$d + 5.0}]]]
            }
        } else {
            puts ">>> 068   $DRC_DB not found: no Calibre marker location (README copies unpu_top.drc.db there)"
        }
        foreach w $ab_wins {
            route_detail -incremental true -max_number_iterations 40 -coordinates [list $w]   ;# 068: the same incremental routing, limited to the marker window
        }
        set ab_cr [ant068_check_routes_counts]
        set ab_drc [lindex $ab_cr 0]
        puts ">>> 068 check_routes after the window clean-up: DRCs $ab_drc"
    }

    # --------------------------------------------------------------------------
    # 10. Final checks (nothing is saved when one fails)
    # --------------------------------------------------------------------------
    if {$ab_drc eq ""} { lappend ab_failures "check_routes DRC count not readable" } elseif {$ab_drc != 0} { lappend ab_failures "check_routes DRCs $ab_drc (0 required)" }
    set ab_open [lindex $ab_cr 1]
    if {$ab_open eq ""} { lappend ab_failures "check_routes open-net count not readable" } elseif {$ab_open != 0} { lappend ab_failures "check_routes open nets $ab_open (0 required)" }

    redirect -variable ab_leg_txt { check_legality -verbose }
    puts $ab_leg_txt
    set ab_leg [ant_parse_legality $ab_leg_txt]
    if {$ab_leg eq ""} { if {![catch {sizeof_collection [check_legality -cell_violation]} v]} { set ab_leg $v } }   ;# 068: VERIFY -cell_violation (usage text) as fallback when the text has no number
    puts ">>> 068 CHECK legality violations: [expr {$ab_leg eq {} ? {unreadable} : $ab_leg}] (0 required)"
    if {$ab_leg eq ""} { lappend ab_failures "check_legality result unreadable (see the text above)" } elseif {$ab_leg != 0} { lappend ab_failures "legality violations $ab_leg" }

    set ab_nbuf [sizeof_collection [get_cells -quiet ${BUF_PREFIX}_*]]
    puts ">>> 068 CHECK buffers in the design: $ab_nbuf, nets buffered: [llength $ab_targets]"
    if {$ab_nbuf != [llength $ab_targets]} { lappend ab_failures "buffer count $ab_nbuf != nets buffered [llength $ab_targets]" }

    foreach n $ab_targets {
        set pn $ab_port_of_net($n)
        set bc [get_cells -quiet -exact $ab_cell_of($n)]
        if {[sizeof_collection $bc] == 0} { lappend ab_failures "net $n: buffer $ab_cell_of($n) vanished"; continue }
        set pin_loads [llength [ant068_net_leaf_pins $n]]
        set out_loads [expr {[llength [ant068_net_leaf_pins $ab_newnet_of($n)]] - 1}]
        puts ">>> 068 CHECK $n: loads before $ab_loads_before($n); after: port net $pin_loads leaf pin (the buffer input), buffer output net $out_loads loads"
        if {$pin_loads != 1} { lappend ab_failures "net $n: port net has $pin_loads leaf pins after the ECO (1 required)" }
        if {$out_loads != $ab_loads_before($n)} { lappend ab_failures "net $n: loads $ab_loads_before($n) before, $out_loads after the buffer" }
        set inp [get_pins -quiet -of_objects $bc -filter "direction == in"]   ;# 068: VERIFY pin attribute direction == in
        lassign [expr {[sizeof_collection $inp] == 1 ? [ant068_centre $inp] : [ant068_centre $bc]}] bx by
        lassign $ab_pin_xy($n) px py
        set dist [ant_manhattan $px $py $bx $by]
        set gate [dict get $ab_buf_row gate]
        set r1 [ant_ratio $gate $dist $WIRE_WIDTH_UM $ANT_WEIGHT_PINWIRE]
        set r2 [ant_ratio $gate $dist $WIRE_WIDTH_UM $ANT_WEIGHT_TOPM]
        puts ">>> 068 CHECK $n: buffer $ab_cell_of($n) at ([format %.2f $bx], [format %.2f $by]), pin at ([format %.2f $px], [format %.2f $py]): Manhattan distance [format %.1f $dist] um (limit $ab_lim($n), tier $ab_tier($n)); predicted ratio on M2/M3 [format %.0f $r1], on TOP_M [format %.0f $r2] (limit $ANT_RATIO_LIMIT)"
        if {$dist > $ab_lim($n)} { lappend ab_failures "net $n: buffer is $dist um from the pin (limit $ab_lim($n), tier $ab_tier($n))" }   ;# 069: the limit of the tier the net was placed in
        if {$r1 > $ANT_RATIO_LIMIT} { lappend ab_failures "net $n: predicted antenna ratio [format %.0f $r1] on M2/M3 exceeds $ANT_RATIO_LIMIT" }
    }

    # --------------------------------------------------------------------------
    # 11. Timing after the ECO: reported, not tuned
    # --------------------------------------------------------------------------
    update_timing -full
    puts ">>> 068 ===== report_global_timing AFTER ====="
    report_global_timing
    foreach n $ab_targets {
        set pn $ab_port_of_net($n)
        set s1 [list [ant068_slack $pn $SETUP_SCEN max] [ant068_slack $pn $HOLD_SCEN min]]
        if {[info exists ab_timing_err]} continue   ;# 069: the one message "per-net timing unavailable: <reason>" was printed once; no per-net line with error text
        set worse {}
        foreach i {0 1} {
            set a [lindex $ab_slack0($n) $i]
            set b [lindex $s1 $i]
            if {[string is double -strict $a] && [string is double -strict $b] && $b < $a - 1e-6} { lappend worse [lindex {setup hold} $i] }
        }
        puts ">>> 068 TIMING $n: setup [lindex $ab_slack0($n) 0] -> [lindex $s1 0], hold [lindex $ab_slack0($n) 1] -> [lindex $s1 1]  [expr {[llength $worse] ? "WORSE: $worse" : {not worse}}]"
    }
    if {[info exists ab_timing_err]} { puts ">>> 069 per-net TIMING lines skipped (reason above); the report_global_timing tables before and after are printed" }
    if {[llength $ab_failures] > 0} {
        error "ERROR 068: [llength $ab_failures] check(s) failed, NOTHING SAVED: [join $ab_failures {; }]"
    }

    # --------------------------------------------------------------------------
    # 12. Save over _route (as fix_antenna.tcl) and finish
    # --------------------------------------------------------------------------
    save_block
    save_block -force -as ${DESIGN_NAME}_route
    save_lib
    puts ">>> STAGE 6c COMPLETE: [llength $ab_targets] port nets buffered with $ab_buf_lc, ${DESIGN_NAME}_route overwritten in place. Log: ${LOG_DIR}/6c_antenna_port_buffers.log"
    puts ">>> 068 NEXT: metal_fill.tcl, pv.tcl, then a NEW Calibre antenna run; only a database from that new run may be used for another pass of this script."
    puts ">>> 068 clock nets left for a decision: $ab_clk_nets"
}

set ec_b [string first "# ---- BEGIN PURE TCL 068 ----" $ec_src]
7638
set ec_e [string first "# ---- END PURE TCL 068 ----" $ec_src]
27973
set ec_h [string first "# 068: ICC2 side helpers" $ec_src]
28003
set ec_f [string first "file mkdir \$LOG_DIR" $ec_src]
31231
if {$ec_b < 0 || $ec_e < 0 || $ec_h < 0 || $ec_f < 0 || $ec_f <= $ec_h} { error "ERROR 079: markers not found in ${SCRIPT_DIR}/antenna_port_buffers.tcl" }
eval [string range $ec_src $ec_b $ec_e]
eval [string range $ec_src $ec_h [expr {$ec_f - 1}]]
# 079 fix: the antenna numbers used for insertions on a PORT are read from antenna_port_buffers.tcl (one source), printed below
foreach ec_n {MAX_PIN_BUF_DIST ANT_RATIO_LIMIT ANT_WEIGHT_PINWIRE WIRE_WIDTH_UM ANT_WEIGHT_TOPM TIER2_RATIO} {
    if {[catch {set PORT_$ec_n [eco079_param_from_text $ec_src $ec_n]} ec_err]} { error "ERROR 079: ${SCRIPT_DIR}/antenna_port_buffers.tcl: $ec_err" }
}
# 097: a resized cell that does not fit in place may be relocated by at most this much (Manhattan distance between the centre of the old cell and the centre of the new one). Same value and reason as the pin-to-buffer limit of
# 097: step 6c (PORT_MAX_PIN_BUF_DIST, read above): a cell that moves farther adds wire delay on its nets that PrimeTime did not see; the timing gates after the ECO judge what is left. Edit this line to change it (printed).
set MAX_RESIZE_MOVE_UM $PORT_MAX_PIN_BUF_DIST
40.0
set RESIZE_PORT_WARN_UM 20.0   ;# 097: WARNING when the driver-to-port distance of a relocated cell grows by more than this (named by the task text of 097)
20.0
set ec_src2 [eco079_read ${SCRIPT_DIR}/timing_closure.tcl]
# ==============================================================================
# Script: timing_closure.tcl
# Path  : <RUN_DIR>/pnr_v2/timing_closure.tcl   ;# 072: new script (flow step 6e, after antenna_clk_root.tcl, before metal_fill.tcl)
# Stage : Final timing pass after the antenna ECOs: route_opt again, ECO cells protected, fillers out of the way
# Tool  : Synopsys ICC2 (U-2022.12-SP3)
# ==============================================================================
# 072: THIS SCRIPT CAN CHANGE THE NETLIST: route_opt may resize cells and insert hold buffers. The PM must be told (the netlist written by pv.tcl differs from the one of step 6d).
# 072: why. The exported layout is DRC 0 and antenna 0 in Calibre, but setup WNS is -0.10 ns (2 in-to-out paths) and hold has 53 violations (worst -0.04 ns): route.tcl ended with
# 072: setup 0.00 / 15 hold violations, then the fillers, the route_eco steps and the antenna ECOs (fix passes, port buffers, clock root) moved both. This pass gives the optimiser
# 072: the SAME goals and options as route.tcl once more. No constraint, uncertainty, goal, SDC value, limit or app option is changed relative to route.tcl:
# 072: every block marked "route.tcl line N" below is copied from route.tcl (pnr_v2/test_timing_closure.tcl compares them line by line).
# 072: the antenna ECO cells exist only to satisfy the antenna rule, so they are PROTECTED (dont_touch on the cells and on their nets, fixed placement) and their snapshot
# 072: (reference, origin, orientation, pin connections) is compared after the pass: the 15 `antbuf_*` buffers and the root cell of the `clk` net.
# 072: the fillers occupy every free site, so they are removed during the pass (table method of task 070: get_cells -filter, no geometric query) and re-created as route.tcl does.
# 072: what it does, in order (every decision is printed with `>>> 072`):
# 072:   1 route.tcl settings   2 BEFORE metrics   3 protect the ECO cells   4 remove the fillers   5 route_opt passes (at most MAX_PASSES, stop rules printed)
# 072:   6 legalise, fillers, connect_pg_net, route_detail / route_eco, spec uncertainties restored   7 hard checks (nothing is saved on error)   8 AFTER metrics and verdict   9 save
# 072: every command or option not shown in a usage text in ~/server_pull/rpt/help (the real help of this tool version) is marked VERIFY.

set DESIGN_NAME "unpu_top"   ;# 072: design name (as the other scripts)
set UNPU_ERR ""   ;# 082: the run root is derived from where this script lives (pnr_v2/run_root.tcl), never typed: one clone = one run
if {[info script] eq "" || [catch {source [file join [file dirname [file normalize [info script]]] run_root.tcl]} UNPU_ERR]} { error "ERROR 082: cannot load run_root.tcl from the folder of this script ('[info script]'): [expr {$UNPU_ERR ne {} ? $UNPU_ERR : {the script was pasted into the shell: use source <file> or -f <file>}}]" }
set RUN_ROOT [unpu_run_init [info script]]   ;# 082: prints ">>> RUN ROOT: <path>" and a WARNING if the current directory is in another clone
source [file join [file dirname [file normalize [info script]]] clock_latency.tcl]   ;# 088: the shared proc that removes the tool-made set_clock_latency (clock_latency.tcl) and checks it
source [file join [file dirname [file normalize [info script]]] opt_uncertainty.tcl]   ;# 090: the optimisation-only uncertainty margin (scoped, restored with a proof)
set PNR_DIR     "${RUN_ROOT}/pnr_icc2"   ;# 072: ICC2 work directory (as the other scripts)
set BLOCKS_DIR  "${PNR_DIR}/blocks"
set LOG_DIR     "${PNR_DIR}/logs"
set SCRIPT_DIR  "${RUN_ROOT}/pnr_v2"   ;# 072: where antenna_port_buffers.tcl is: its ICC2 helper procs are read from its text, not copied
set STD_LEF     "/storage/PDK_iitg/SCLPDK_V3.0_KIT/scl180/stdcell/fs120/4M1IL/lef/scl18fs120_std.lef"   ;# 072: kit LEF (as pnr_v2/build_ndm_std.tcl): the filler master sizes
set STD_LIB     "scl180_std"
set FILLER_LIB  "scl180_filler"   ;# 072: as route.tcl
set FILLER_REFS {feedth feedth3 feedth9}   ;# 072: the filler masters route.tcl inserts

# 072: parameters of THIS script (nothing here changes what the optimiser is given)
set BUF_PREFIX      "antbuf"   ;# 072: instance name base of the port buffers made by antenna_port_buffers.tcl (BUF_PREFIX there)
set CLK_PORT        "clk"      ;# 072: the clock port; its net's single leaf load is the CTS root (antenna_clk_root.tcl)
set MAX_PASSES      3          ;# 072: route_opt passes at most (task 072)
set IMPROVE_EPS     0.001      ;# 072: a pass must improve the setup or the hold WNS by more than this (ns) or the loop stops
set WORSE_TOL       0.005      ;# 072: verdict WORSE when a WNS drops by more than this (ns)
set FILLER_TOL_PCT  1.0        ;# 072: the filler count after must be within this percent of the count before, or the site balance must explain the difference
set PROTECT_NETS    1          ;# 072: 1 = the nets of the protected cells are dont_touch too (the optimiser may not buffer them); 0 = cells only
set KEEP_PROTECTION 1          ;# 072: 1 = leave dont_touch / fixed on the protected cells in the saved block (later passes keep them); 0 = remove it before saving
set SETUP_SCEN      "func_ss"  ;# 072: scenario names of cts.tcl / route.tcl
set HOLD_SCEN       "func_ff"
set SETUP_GROUP     "in2out"   ;# 072: path group whose worst setup path is printed in full
set HOLD_GROUP      "reg2out"  ;# 072: path group whose worst hold path is printed in full

# ---- BEGIN PURE TCL 072 ----
# 072: everything between BEGIN and END is plain Tcl (no ICC2 command); pnr_v2/test_timing_closure.tcl extracts and tests exactly this text.

# 072: the loop decision after a pass. prev / cur: dicts with setup and hold (worst slack in ns, "" when unreadable). Returns {action reason}, action = continue | stop.
# 072: stop when a value is unreadable, when both are >= 0 (closed), when pass >= max_passes, or when neither WNS improved by more than eps.
proc ant072_pass_decision {pass max_passes prev cur eps} {
    foreach m {setup hold} {
        if {![string is double -strict [dict get $cur $m]]} { return [list stop "the $m WNS could not be read after pass $pass"] }
    }
    set s [dict get $cur setup]
    set h [dict get $cur hold]
    if {$s >= 0 && $h >= 0} { return [list stop "closed after pass $pass: setup WNS [format %.4f $s], hold WNS [format %.4f $h]"] }
    if {$pass >= $max_passes} { return [list stop "maximum of $max_passes passes reached (setup WNS [format %.4f $s], hold WNS [format %.4f $h])"] }
    set improved 0
    foreach m {setup hold} {
        set p [dict get $prev $m]
        if {[string is double -strict $p] && [dict get $cur $m] - $p > $eps} { set improved 1 }
    }
    if {!$improved} {
        return [list stop "pass $pass improved neither WNS by more than $eps ns (setup [format %.4f [dict get $prev setup]] -> [format %.4f $s], hold [format %.4f [dict get $prev hold]] -> [format %.4f $h])"]
    }
    return [list continue "pass $pass improved a WNS by more than $eps ns, next pass"]
}

# 072: worst slack to WNS: 0 when nothing violates
proc ant072_clamp {slack} {
    if {![string is double -strict $slack]} { return $slack }
    return [expr {min($slack, 0.0)}]
}

# 072: verdict from before / after dicts (setup, hold = worst slack in ns). UNKNOWN when a number is unreadable (never CLOSED then);
# 072: CLOSED when both are >= 0 after; WORSE when a WNS (0 when not violating) dropped by more than worse_tol; IMPROVED when none got worse and one improved by more than eps;
# 072: UNCHANGED otherwise (not in the task's list: it says nothing changed more than the tolerances).
proc ant072_verdict {before after worse_tol eps} {
    foreach m {setup hold} {
        if {![string is double -strict [dict get $before $m]] || ![string is double -strict [dict get $after $m]]} {
            return [list UNKNOWN "the $m WNS could not be read (before '[dict get $before $m]', after '[dict get $after $m]')"]
        }
    }
    if {[dict get $after setup] >= 0 && [dict get $after hold] >= 0} { return [list CLOSED "setup WNS [format %.4f [dict get $after setup]] and hold WNS [format %.4f [dict get $after hold]] are >= 0"] }
    set worse {}
    set better {}
    foreach m {setup hold} {
        set b [ant072_clamp [dict get $before $m]]
        set a [ant072_clamp [dict get $after $m]]
        if {$a < $b - $worse_tol - 1e-12} { lappend worse "$m WNS [format %.4f $b] -> [format %.4f $a]" }
        if {$a > $b + $eps} { lappend better "$m WNS [format %.4f $b] -> [format %.4f $a]" }
    }
    if {[llength $worse]} { return [list WORSE [join $worse {; }]] }
    if {[llength $better]} { return [list IMPROVED [join $better {; }]] }
    return [list UNCHANGED "neither WNS changed by more than $eps ns"]
}

# 072: snapshots of protected cells: a list of dicts: name ref x y ori pins ({{pin net} ...}). Differences between two snapshots (list of text lines, empty = identical).
proc ant072_snapshot_diff {before after {tol 0.001}} {
    array set a {}
    foreach s $after { set a([dict get $s name]) $s }
    set diff {}
    foreach b $before {
        set n [dict get $b name]
        if {![info exists a($n)]} { lappend diff "$n: cell is gone"; continue }
        set s $a($n)
        if {[dict get $s ref] ne [dict get $b ref]} { lappend diff "$n: reference [dict get $b ref] -> [dict get $s ref]" }
        if {abs([dict get $s x] - [dict get $b x]) > $tol || abs([dict get $s y] - [dict get $b y]) > $tol} {
            lappend diff "$n: origin ([dict get $b x], [dict get $b y]) -> ([dict get $s x], [dict get $s y])"
        }
        if {[dict get $s ori] ne [dict get $b ori]} { lappend diff "$n: orientation [dict get $b ori] -> [dict get $s ori]" }
        array unset pb
        array unset pa
        foreach e [dict get $b pins] { set pb([lindex $e 0]) [lindex $e 1] }
        foreach e [dict get $s pins] { set pa([lindex $e 0]) [lindex $e 1] }
        foreach p [lsort [array names pb]] {
            if {![info exists pa($p)]} { lappend diff "$n: pin $p is gone"; continue }
            if {$pa($p) ne $pb($p)} { lappend diff "$n: pin $p net $pb($p) -> $pa($p)" }
        }
        foreach p [lsort [array names pa]] { if {![info exists pb($p)]} { lappend diff "$n: new pin $p (net $pa($p))" } }
    }
    return $diff
}

# 072: filler check. count_*: number of filler instances; sites_*: total filler width in sites; cell_sites_added: sites taken by the standard cells added (negative when removed).
# 072: ok when the count is within tol_pct percent of the count before, or when the site balance explains the change: |(sites_after - sites_before) + cell_sites_added| <= tol_pct percent of sites_before.
# 072: returns {ok message}.
proc ant072_filler_check {count_before count_after sites_before sites_after cell_sites_added tol_pct} {
    if {$count_before <= 0} { return [list 0 "no filler before the pass"] }
    set dc [expr {$count_after - $count_before}]
    set pc [expr {100.0 * abs($dc) / $count_before}]
    if {$pc <= $tol_pct} { return [list 1 "filler count $count_before -> $count_after ([format %+d $dc], [format %.2f $pc] percent, within $tol_pct percent)"] }
    set resid [expr {($sites_after - $sites_before) + $cell_sites_added}]
    set pr [expr {100.0 * abs($resid) / $sites_before}]
    if {$pr <= $tol_pct} {
        return [list 1 "filler count $count_before -> $count_after ([format %+d $dc], [format %.2f $pc] percent) is explained by the site balance: filler sites [format %.0f $sites_before] -> [format %.0f $sites_after], cells added take [format %.0f $cell_sites_added] sites, residual [format %.0f $resid] sites ([format %.2f $pr] percent)"]
    }
    return [list 0 "filler count $count_before -> $count_after ([format %+d $dc], [format %.2f $pc] percent); the site balance does not explain it: filler sites [format %.0f $sites_before] -> [format %.0f $sites_after], cells added take [format %.0f $cell_sites_added] sites, residual [format %.0f $resid] sites ([format %.2f $pr] percent)"]
}
# 072: cell statistics from the reference names of ALL design cells (read with the proven attribute ref_name). The area comes from the kit LEF (SIZE width x height of the reference),
# 072: not from a design-cell attribute; buffers and inverters are the design cells whose reference is in the library buffer / inverter name lists (is_buffer / is_inverter exist on LIBRARY cells,
# 072: not on design cells: FLT-005 on the first server run). Fillers are not counted. Returns a dict: ncell area nbuf ninv unknown (cells whose reference has no LEF size) unknown_names (first five).
proc ant072_count_refs {refs filler_refs buf_names inv_names lef} {
    array set isf {}
    foreach f $filler_refs { set isf($f) 1 }
    array set isb {}
    foreach b $buf_names { set isb($b) 1 }
    array set isi {}
    foreach i $inv_names { set isi($i) 1 }
    set n 0
    set area 0.0
    set nb 0
    set ni 0
    set unknown 0
    set unk {}
    foreach r $refs {
        if {[info exists isf($r)]} continue
        incr n
        if {[info exists isb($r)]} { incr nb }
        if {[info exists isi($r)]} { incr ni }
        if {$r ne "" && [dict exists $lef $r]} {
            set w [dict get $lef $r w]
            set h [dict get $lef $r h]
            if {$w ne "" && $h ne ""} { set area [expr {$area + $w * $h}]; continue }
        }
        incr unknown
        if {[lsearch -exact $unk $r] < 0 && [llength $unk] < 5} { lappend unk $r }
    }
    return [dict create ncell $n area $area nbuf $nb ninv $ni unknown $unknown unknown_names $unk]
}

# 072: b - a formatted, or "n/a" when one of them is not a number (the metric is UNKNOWN)
proc ant072_delta {a b {fmt %.2f}} {
    if {![string is double -strict $a] || ![string is double -strict $b]} { return "n/a" }
    return [format $fmt [expr {$b - $a}]]
}
# ---- END PURE TCL 072 ----

# 072: take the ICC2 helper procs of antenna_port_buffers.tcl from its text (same code, no copy): ant068_bbox_of, ant068_centre, ant070_all_fillers, ant068_net_leaf_pins, ant068_check_routes_counts, ...
set fp [open ${SCRIPT_DIR}/antenna_port_buffers.tcl r]
set tc_src [read $fp]
close $fp
set tc_b [string first "# ---- BEGIN PURE TCL 068 ----" $tc_src]
set tc_e [string first "# ---- END PURE TCL 068 ----" $tc_src]
set tc_h [string first "# 068: ICC2 side helpers" $tc_src]
set tc_f [string first "file mkdir \$LOG_DIR" $tc_src]
if {$tc_b < 0 || $tc_e < 0 || $tc_h < 0 || $tc_f < 0 || $tc_f <= $tc_h} { error "ERROR 072: markers not found in ${SCRIPT_DIR}/antenna_port_buffers.tcl" }
eval [string range $tc_src $tc_b $tc_e]
eval [string range $tc_src $tc_h [expr {$tc_f - 1}]]

# 072: ICC2 side helpers of this script (not tested locally)
proc ant072_pin_nets {cell} {   ;# 072: {pin net} for every pin of a cell, power pins included; pin = the part of the full name after the last /
    set out {}
    foreach_in_collection p [get_pins -quiet -of_objects $cell] {
        set nc [get_nets -quiet -of_objects $p]
        lappend out [list [lindex [split [get_object_name $p] /] end] [expr {[sizeof_collection $nc] ? [get_object_name $nc] : {-}}]]
    }
    return $out
}
proc ant072_snapshot {cellname} {   ;# 072: dict name ref x y ori pins of one cell
    set c [get_cells -quiet -exact $cellname]
    if {[sizeof_collection $c] != 1} { return [dict create name $cellname ref "" x 1e9 y 1e9 ori "" pins {}] }
    lassign [ant068_bbox_of $c] x0 y0 x1 y1
    return [dict create name $cellname ref [get_attribute -quiet $c ref_name] x $x0 y $y0 ori [get_attribute -quiet $c orientation] pins [ant072_pin_nets $c]]
}
proc ant072_wns {scen dtype} {   ;# 072: {wns tns num groups}: wns = worst slack of all paths (positive when nothing violates), tns / num over the violating endpoints, groups = {{group wns tns num} ...}; "" = UNKNOWN
    global ab_pg_warned
    set wns ""
    set tns ""
    set num ""
    set groups {}
    # 072: the worst slack: get_timing_paths with the slack attribute worked on the server (task 071 metrics)
    if {[catch {
        set p [get_timing_paths -scenarios $scen -delay_type $dtype -max_paths 1]
        if {[sizeof_collection $p] > 0} { set wns [get_attribute $p slack] }
    } err]} { puts ">>> 072 WNS of $scen $dtype is UNKNOWN: $err" }
    # 072: TNS, number of violating endpoints, groups: -slack_lesser_than / -max_paths 100000 are in the usage text but not yet proven; path_group is unproven
    if {[catch {
        array set g {}
        set tns 0.0
        set num 0
        set v [get_timing_paths -scenarios $scen -delay_type $dtype -max_paths 100000 -slack_lesser_than 0.0]
        foreach_in_collection q $v {
            set s [get_attribute $q slack]
            set tns [expr {$tns + $s}]
            incr num
            if {![info exists ab_pg_warned]} {
                if {[catch {set gn [get_object_name [get_attribute $q path_group]]}]} {   ;# 072: VERIFY the path attribute path_group (unproven)
                    set ab_pg_warned 1
                    puts ">>> 072 the path attribute path_group is not available: per-group lines are skipped (the totals are still printed)"
                } else {
                    if {![info exists g($gn)]} { set g($gn) [list $s 0.0 0] }
                    lassign $g($gn) gw gt gn2
                    set g($gn) [list [expr {min($gw, $s)}] [expr {$gt + $s}] [expr {$gn2 + 1}]]
                }
            }
        }
        foreach k [lsort [array names g]] { lappend groups [concat [list $k] $g($k)] }
    } err]} {
        puts ">>> 072 TNS and violating-endpoint count of $scen $dtype are UNKNOWN: $err"
        set tns ""
        set num ""
        set groups {}
    }
    return [list $wns $tns $num $groups]
}
proc ant072_metrics {label} {   ;# 072: print and return the numbers of the verdict (dict setup hold, ...)
    global SETUP_SCEN HOLD_SCEN SETUP_GROUP HOLD_GROUP
    update_timing -full
    puts ">>> 072 $label ===== report_global_timing ====="
    report_global_timing
    lassign [ant072_wns $SETUP_SCEN max] sw st sn sg
    lassign [ant072_wns $HOLD_SCEN min] hw ht hn hg
    puts ">>> 072 $label SETUP ($SETUP_SCEN): WNS [expr {$sw eq {} ? {UNKNOWN} : $sw}] ns, TNS [expr {$st eq {} ? {UNKNOWN} : [format %.4f $st]}] ns, violating endpoints [expr {$sn eq {} ? {UNKNOWN} : $sn}]"
    foreach e $sg { puts ">>> 072 $label SETUP group [lindex $e 0]: WNS [format %.4f [lindex $e 1]] ns, TNS [format %.4f [lindex $e 2]] ns, violating endpoints [lindex $e 3]" }
    puts ">>> 072 $label HOLD ($HOLD_SCEN): WNS [expr {$hw eq {} ? {UNKNOWN} : $hw}] ns, TNS [expr {$ht eq {} ? {UNKNOWN} : [format %.4f $ht]}] ns, violating endpoints [expr {$hn eq {} ? {UNKNOWN} : $hn}]"
    foreach e $hg { puts ">>> 072 $label HOLD group [lindex $e 0]: WNS [format %.4f [lindex $e 1]] ns, TNS [format %.4f [lindex $e 2]] ns, violating endpoints [lindex $e 3]" }
    return [dict create setup $sw hold $hw setup_tns $st hold_tns $ht setup_num $sn hold_num $hn]
}
proc ant072_paths {label} {   ;# 072: the worst setup path of the in2out group and the worst hold path of reg2out in full
    global SETUP_SCEN HOLD_SCEN SETUP_GROUP HOLD_GROUP
    if {[catch {
        puts ">>> 072 $label ===== worst setup path, group $SETUP_GROUP ====="
        report_timing -scenarios $SETUP_SCEN -delay_type max -groups $SETUP_GROUP -max_paths 1 -path_type full_clock_expanded -significant_digits 4   ;# 072: VERIFY the group name
    } err]} { puts ">>> 072 $label setup path report failed: $err" }
    if {[catch {
        puts ">>> 072 $label ===== worst hold path, group $HOLD_GROUP ====="
        report_timing -scenarios $HOLD_SCEN -delay_type min -groups $HOLD_GROUP -max_paths 1 -path_type full_clock_expanded -significant_digits 4
    } err]} { puts ">>> 072 $label hold path report failed: $err" }
}
proc ant072_lib_names {lib filter} {   ;# 072: {ok names} of the LIBRARY cells matching a filter; is_buffer / is_inverter are proven on library cells (tasks 068, 071)
    if {[catch {set lc [get_lib_cells -quiet ${lib}/* -filter $filter]} err]} {
        puts ">>> 072 library filter '$filter' failed: $err"
        return [list 0 {}]
    }
    set names {}
    foreach_in_collection c $lc { lappend names [lindex [split [get_object_name $c] /] end] }
    return [list 1 $names]
}
proc ant072_stats {label filler_filter site_w lef filler_refs} {   ;# 072: cells (not fillers), area, buffers, inverters, fillers (count and sites); a value that cannot be read is "" (UNKNOWN), never an error
    global STD_LIB
    set out [dict create ncell "" area "" nbuf "" ninv "" nfill "" fsites ""]
    lassign [ant072_lib_names $STD_LIB "is_buffer == true"] okb bufs
    lassign [ant072_lib_names $STD_LIB "is_inverter == true"] oki invs
    set refs {}
    if {[catch {
        foreach_in_collection c [get_cells -quiet *] { lappend refs [get_attribute -quiet $c ref_name] }   ;# 072: ref_name of a design cell is proven (tasks 069 to 071)
    } err]} {
        puts ">>> 072 $label CELLS: reading the design cells failed ($err): cells, area, buffers, inverters are UNKNOWN"
    } else {
        set cn [ant072_count_refs $refs $filler_refs $bufs $invs $lef]
        dict set out ncell [dict get $cn ncell]
        if {[dict get $cn unknown] == 0} { dict set out area [dict get $cn area] } else {
            puts ">>> 072 $label CELLS: [dict get $cn unknown] cells have a reference without a LEF size (first: [dict get $cn unknown_names]): the area is UNKNOWN"
        }
        if {$okb} { dict set out nbuf [dict get $cn nbuf] } else { puts ">>> 072 $label CELLS: the number of buffers is UNKNOWN (no library buffer list)" }
        if {$oki} { dict set out ninv [dict get $cn ninv] } else { puts ">>> 072 $label CELLS: the number of inverters is UNKNOWN (no library inverter list)" }
    }
    if {[catch {
        set fl [ant070_all_fillers $filler_filter]
        set fsites 0.0
        foreach r $fl { lassign $r nm x0 y0 x1 y1; set fsites [expr {$fsites + ($x1 - $x0) / $site_w}] }
        dict set out nfill [llength $fl]
        dict set out fsites $fsites
    } err]} { puts ">>> 072 $label FILLERS: reading the fillers failed ($err): the filler numbers are UNKNOWN" }
    foreach {k fmt} {ncell %d area %.2f nbuf %d ninv %d nfill %d fsites %.0f} {
        set v [dict get $out $k]
        set txt($k) [expr {[string is double -strict $v] ? [format $fmt $v] : {UNKNOWN}}]
    }
    puts ">>> 072 $label CELLS: $txt(ncell) cells (fillers excluded), area $txt(area) um^2 (from the LEF sizes), buffers $txt(nbuf), inverters $txt(ninv), fillers $txt(nfill) ($txt(fsites) sites)"
    return $out
}

file mkdir $LOG_DIR

redirect -tee -file ${LOG_DIR}/6e_timing_closure.log {
    puts ">>> RUN ROOT: $RUN_ROOT"   ;# 082: the log shows which clone wrote it

    set tc_failures {}

    set open_blk [get_blocks -quiet *]
    if {[sizeof_collection $open_blk] > 0} {
        close_blocks -force $open_blk
    }
    set open_lib [get_libs -quiet *]
    if {[sizeof_collection $open_lib] > 0} {
        foreach_in_collection lib_obj $open_lib {
            close_lib -force $lib_obj
        }
    }

    open_lib ${BLOCKS_DIR}/${DESIGN_NAME}.dlib
    open_block ${DESIGN_NAME}.dlib:${DESIGN_NAME}_route
    current_block ${DESIGN_NAME}_route
    link_block
    unpu_remove_clock_latency timing_closure   ;# 088: remove the tool-made set_clock_latency (a no-op when the block is clean); prints the counts per scenario, ERROR 088 if any is left
    puts ">>> 072 block ${DESIGN_NAME}_route opened (it is overwritten in place at the end; the README tells the user to back up the library first)"

    # --------------------------------------------------------------------------
    # 1. The settings of route.tcl (copied, not retyped; the test compares them line by line)
    # --------------------------------------------------------------------------
    # 072: route.tcl lines 36-36, verbatim
    suppress_message {DCHK-027 DCHK-010 ATTR-12 PDC-003 ZRT-740 ZRT-027 POW-046 UIC-058 UIC-057}

    # 072: route.tcl lines 42-57, verbatim
   # 2. Restrict Routing to SCL 180nm 4-Metal Stack (M1 to TOP_M)
    set_ignored_layers \
        -min_routing_layer M1 \
        -max_routing_layer TOP_M

    # Allow clock nets (from CTS) to hop up to TOP_M to fix M3 antenna violations
    set_clock_routing_rules \
        -default_rule \
        -min_routing_layer M2 \
        -max_routing_layer TOP_M

    # Ensure Hold cells remain enabled for Post-Route Hold Optimization
    set hold_cells [get_lib_cells -quiet {scl180_std/*BUF* scl180_std/*INV* scl180_std/*DEL* scl180_std/*DLY* scl180_std/*buf* scl180_std/*inv* scl180_std/*del* scl180_std/*dly*}]
    if {[sizeof_collection $hold_cells] > 0} {
        set_lib_cell_purpose -include hold $hold_cells
    }

    # 072: the clock routing rule line as in antenna_clk_root.tcl: it is the same line as route.tcl line 48-51 above (kept there)

    # 072: route.tcl lines 65-76, verbatim (090: the uncertainty block of route.tcl calls the shared procs of opt_uncertainty.tcl; the same lines here)
    set SPEC_SETUP_UNC   1.5   ;# 063 E9: old constraints, setup uncertainty 1.5 (the example had 0.15)
    set SPEC_HOLD_UNC    0.5   ;# 063 E9: old constraints, hold uncertainty 0.5 (the example had 0.05)
    lassign [unc090_params $SPEC_SETUP_UNC $SPEC_HOLD_UNC] SETUP_SLACK_GOAL HOLD_SLACK_GOAL UNC_SCOPE UNC_PROBE   ;# 090: goals/scope/probes with environment overrides (opt_uncertainty.tcl); replaces the 065 goals of 0.0
    set OPT_SETUP_UNC    [expr {$SPEC_SETUP_UNC + $SETUP_SLACK_GOAL}]
    set OPT_HOLD_UNC     [expr {$SPEC_HOLD_UNC + $HOLD_SLACK_GOAL}]

    set_scenario_status func_ss -active true -setup true -hold false
    set_scenario_status func_ff -active true -hold true -setup true
    # 090: clock-level = SPEC, in2out numbers, OPT values of the scope (setup goal in func_ss, hold goal in func_ff), probes, SDC check; restored below with a proof
    unc090_open_opt route $SPEC_SETUP_UNC $SPEC_HOLD_UNC $SETUP_SLACK_GOAL $HOLD_SLACK_GOAL $UNC_SCOPE $UNC_PROBE

    # 3. Configure Routing, SI Crosstalk & Antenna App Options
    set_app_options -name route.global.timing_driven -value true
    set_app_options -name route.track.timing_driven -value true
    set_app_options -name route.detail.timing_driven -value true
    set_app_options -name route.global.crosstalk_driven -value true
    set_app_options -name route.track.crosstalk_driven -value true
    set_app_options -name time.si_enable_analysis -value true

    # 072: route.tcl lines 85-132, verbatim
   # ==========================================================================
    # SCL 180nm (4M1L) Fast Layer-Hopping Antenna Rules
    # - Keeps M1 & M2 -diode_ratio at 180/75 (already 0 errors, fast runtime)
    # - Tightens -ratio (input port nets only) to 25/12 to clear the 6 MT errors
    # - Tightens M3 -diode_ratio to 100/45 to clear the 14 M3 errors
    # ==========================================================================
    remove_antenna_rules

    # 1. Mode 4: Sidewall Area Rules for Metal Layers
    define_antenna_rule -mode 4 -diode_mode 4 \
        -metal_ratio 25 -cut_ratio 0
    define_antenna_layer_rule -layer M1    -mode 4 \
        -ratio 25  -diode_ratio {0 0 0 180}
    define_antenna_layer_rule -layer M2    -mode 4 \
        -ratio 25  -diode_ratio {0 0 0 180}
    define_antenna_layer_rule -layer M3    -mode 4 \
        -ratio 25  -diode_ratio {0 0 0 100}
    define_antenna_layer_rule -layer TOP_M -mode 4 \
        -ratio 25  -diode_ratio {0 0 8000 30000}

    # 2. Mode 1: Polygon Area Rules for Via Cut & Metal Layers
    define_antenna_rule -mode 1 -diode_mode 4 \
        -metal_ratio 12 -cut_ratio 20
    define_antenna_layer_rule -layer M1    -mode 1 \
        -ratio 12  -diode_ratio {0 0 0 75}
    define_antenna_layer_rule -layer M2    -mode 1 \
        -ratio 12  -diode_ratio {0 0 0 75}
    define_antenna_layer_rule -layer M3    -mode 1 \
        -ratio 12  -diode_ratio {0 0 0 45}
    define_antenna_layer_rule -layer TOP_M -mode 1 \
        -ratio 12  -diode_ratio {0 0 2000 7500}

    foreach via_lyr [get_object_name [get_layers -quiet -filter "layer_type == interconnect_via"]] {
        define_antenna_layer_rule -layer $via_lyr -mode 1 \
            -ratio 20 -diode_ratio {0 0 83.33 75}
    }

    report_antenna_rules
    
    # Pure layer-hopping antenna options (fast runtime, no diodes)
    set_app_options -name route.detail.antenna -value true
    set_app_options -name route.detail.hop_layers_to_fix_antenna -value true
    set_app_options -name route.detail.antenna_fixing_preference -value hop_layers
    set_app_options -name route.detail.insert_diodes_during_routing -value false
    #set_app_options -name route.detail.diode_libcell_names -value {scl180_std/adiode}

    set_app_options -name route_opt.flow.enable_power -value false
    set_app_options -name route_opt.flow.enable_ccd -value false
    puts ">>> 072 SETTINGS used: setup uncertainty during optimisation $OPT_SETUP_UNC ns (spec $SPEC_SETUP_UNC + goal $SETUP_SLACK_GOAL), hold uncertainty during optimisation $OPT_HOLD_UNC ns (spec $SPEC_HOLD_UNC + goal $HOLD_SLACK_GOAL), scope $UNC_SCOPE; route.tcl takes the same numbers from opt_uncertainty.tcl and the same environment variables"
    foreach {nm val exp} [list SPEC_SETUP_UNC $SPEC_SETUP_UNC 1.5 SPEC_HOLD_UNC $SPEC_HOLD_UNC 0.5] {
        if {abs($val - $exp) > 1e-12} { error "ERROR 072: $nm is $val, route.tcl's value is $exp" }
    }

    # --------------------------------------------------------------------------
    # 2. BEFORE
    # --------------------------------------------------------------------------
    set tc_filter {}
    foreach f $FILLER_REFS { lappend tc_filter "ref_name == $f" }
    set tc_filter [join $tc_filter " || "]
    set fp [open $STD_LEF r]
    set tc_lef [ant_parse_lef [read $fp]]
    close $fp
    set tc_site 1e9
    foreach f $FILLER_REFS { if {[dict exists $tc_lef $f] && [dict get $tc_lef $f w] < $tc_site} { set tc_site [dict get $tc_lef $f w] } }
    if {$tc_site > 1e8} { error "ERROR 072: none of the filler masters $FILLER_REFS is in the LEF" }
    set tc_row_h [dict get $tc_lef [lindex $FILLER_REFS 0] h]
    puts ">>> 072 site width $tc_site um, row height $tc_row_h um (narrowest filler master in the LEF)"
    set tc_stats0 [ant072_stats BEFORE $tc_filter $tc_site $tc_lef $FILLER_REFS]
    set tc_before [ant072_metrics BEFORE]
    ant072_paths BEFORE
    if {[catch {redirect -variable tc_cq0 { report_clock_qor -type summary }} err]} {   ;# 072: VERIFY (usage text); printed only
        puts ">>> 072 BEFORE report_clock_qor failed: $err"
    } else {
        puts ">>> 072 BEFORE ===== report_clock_qor -type summary =====\n$tc_cq0"
    }
    set tc_cr0 [ant068_check_routes_counts]
    puts ">>> 072 check_routes BEFORE: DRCs [lindex $tc_cr0 0], open nets [lindex $tc_cr0 1], ICC2 antenna violations [lindex $tc_cr0 2]"

    # --------------------------------------------------------------------------
    # 3. Protect the antenna ECO cells and snapshot them
    # --------------------------------------------------------------------------
    set tc_names {}
    foreach_in_collection c [get_cells -quiet ${BUF_PREFIX}_*] { lappend tc_names [get_object_name $c] }
    set tc_nbuf [llength $tc_names]
    set tc_loads [ant068_net_leaf_pins $CLK_PORT]
    if {[llength $tc_loads] != 1} { error "ERROR 072: the clock port net $CLK_PORT has [llength $tc_loads] leaf loads, 1 expected (the CTS root)" }
    set tc_rootcell [get_cells -quiet -of_objects [get_pins -quiet -exact [lindex $tc_loads 0]]]   ;# 071: VERIFY get_cells -of_objects <pin>
    if {[sizeof_collection $tc_rootcell] != 1} { error "ERROR 072: cannot find the cell of pin [lindex $tc_loads 0]" }
    set tc_root [get_object_name $tc_rootcell]
    lappend tc_names $tc_root
    if {$tc_nbuf == 0} { error "ERROR 072: no instance named ${BUF_PREFIX}_* found: antenna_port_buffers.tcl has not run on this block (nothing to protect), nothing was changed" }
    set tc_snap0 {}
    set tc_pnets {}
    foreach nm $tc_names {
        set s [ant072_snapshot $nm]
        lappend tc_snap0 $s
        puts ">>> 072 PROTECTED $nm: reference [dict get $s ref], origin ([format %.3f [dict get $s x]], [format %.3f [dict get $s y]]), orientation [dict get $s ori], pins [dict get $s pins]"
        foreach e [dict get $s pins] {
            set pn [lindex $e 1]
            if {$pn ne "-" && $pn ne "VDD" && $pn ne "VSS" && [lsearch -exact $tc_pnets $pn] < 0} { lappend tc_pnets $pn }
        }
    }
    puts ">>> 072 protected cells: [llength $tc_names] ($tc_nbuf port buffers ${BUF_PREFIX}_* + the clock root $tc_root, reference [dict get [lindex $tc_snap0 end] ref]); their signal nets: [llength $tc_pnets]"
    set tc_cells [get_cells -quiet -exact $tc_names]
    set tc_status0 {}
    foreach_in_collection c $tc_cells { lappend tc_status0 [list [get_object_name $c] [get_attribute -quiet $c physical_status]] }   ;# 072: VERIFY the cell attribute physical_status
    set tc_dt_ok 0
    if {![catch {set_dont_touch $tc_cells true} err]} {   ;# 072: VERIFY set_dont_touch <cells> true (not in the probed help, UNPROVEN)
        set tc_dt_ok 1
    } else {
        puts ">>> 072 set_dont_touch on the cells failed: $err; trying set_attribute dont_touch"
        if {![catch {set_attribute -objects $tc_cells -name dont_touch -value true} err2]} { set tc_dt_ok 1 } else { puts ">>> 072 set_attribute dont_touch failed too: $err2" }   ;# 072: VERIFY the attribute dont_touch is settable (UNPROVEN)
    }
    if {$PROTECT_NETS} {
        if {[catch {set_dont_touch [get_nets -quiet -exact $tc_pnets] true} err]} { puts ">>> 072 set_dont_touch on the nets failed: $err"; set tc_dt_ok 0 }
    }
    if {!$tc_dt_ok} { error "ERROR 072: the protection could not be set (set_dont_touch), nothing was changed. Without it route_opt may resize or remove the antenna cells." }
    if {[catch {set_attribute -objects $tc_cells -name physical_status -value fixed} err]} { puts ">>> 072 physical_status fixed failed: $err (the cell origin is still checked at the end)" }   ;# 072: VERIFY physical_status fixed blocks moving
    set tc_dt_read 0
    foreach_in_collection c $tc_cells {
        set tc_dtv [get_attribute -quiet $c dont_touch]   ;# 072: VERIFY the cell attribute dont_touch (UNPROVEN, -quiet: empty when it does not exist)
        if {$tc_dtv ne ""} { incr tc_dt_read }
        puts ">>> 072 PROTECTION [get_object_name $c]: dont_touch=$tc_dtv physical_status=[get_attribute -quiet $c physical_status]"
    }
    if {$tc_dt_read == 0} { puts ">>> 072 the cell attribute dont_touch cannot be read back: the protection relies on the command having returned without error, and it is checked by the snapshot comparison after every pass" }

    # --------------------------------------------------------------------------
    # 4. Remove the fillers (table method of task 070; counts kept)
    # --------------------------------------------------------------------------
    set tc_fcoll [get_cells -quiet -filter $tc_filter]
    set tc_nfill0 [sizeof_collection $tc_fcoll]
    puts ">>> 072 removing $tc_nfill0 filler instances (count and site balance are checked at the end)"
    if {$tc_nfill0 == 0} { error "ERROR 072: no filler instance found with the filter '$tc_filter'" }
    if {[catch {remove_cells $tc_fcoll} err]} { error "ERROR 072: remove_cells on the $tc_nfill0 fillers failed: $err. Nothing was saved (the protection was set in memory only)." }   ;# 069: VERIFY remove_cells on 20k filler instances at once (it worked per net in the task 069/070 runs)
    puts ">>> 072 fillers left after the removal: [sizeof_collection [get_cells -quiet -filter $tc_filter]]"

    # --------------------------------------------------------------------------
    # 5. route_opt passes (the call of route.tcl line 142)
    # --------------------------------------------------------------------------
    set tc_prev $tc_before
    set tc_pass 0
    set tc_stop_reason "no pass run"
    while {1} {
        incr tc_pass
        puts ">>> 072 ===== route_opt pass $tc_pass of at most $MAX_PASSES (goals unchanged: setup uncertainty $OPT_SETUP_UNC, hold $OPT_HOLD_UNC) ====="
        route_opt   ;# 072: route.tcl line 142 (same call, no argument)
        set tc_cur [ant072_metrics "PASS $tc_pass"]
        set tc_diff [ant072_snapshot_diff $tc_snap0 [lmap nm $tc_names {ant072_snapshot $nm}]]
        if {[llength $tc_diff]} {
            puts ">>> 072 PROTECTED CELL CHANGED in pass $tc_pass: [join $tc_diff {; }]"
            lappend tc_failures "protected cells changed in pass $tc_pass: [join $tc_diff {; }]"
            set tc_stop_reason "a protected cell changed"
            break
        }
        lassign [ant072_pass_decision $tc_pass $MAX_PASSES $tc_prev $tc_cur $IMPROVE_EPS] tc_act tc_why
        puts ">>> 072 PASS DECISION after pass $tc_pass: $tc_act: $tc_why"
        set tc_prev $tc_cur
        if {$tc_act eq "stop"} { set tc_stop_reason $tc_why; break }
    }
    puts ">>> 072 route_opt loop ended after $tc_pass pass(es): $tc_stop_reason"
    set tc_afteropt $tc_prev

    # --------------------------------------------------------------------------
    # 6. Legalise, restore the spec uncertainties, fillers, PG, route_detail / route_eco (route.tcl)
    # --------------------------------------------------------------------------
    legalize_placement   ;# 072: route.tcl line 143
    # 072: route.tcl lines 147-148, verbatim
    # Restore the real uncertainties so reports and exported SDC are correct (090: removes the pin/port-level values, proves none is left, in2out comparison)
    unc090_close_opt route $SPEC_SETUP_UNC $SPEC_HOLD_UNC $SETUP_SLACK_GOAL $HOLD_SLACK_GOAL $UNC_SCOPE
    puts ">>> 072 uncertainties restored to the spec values: setup $SPEC_SETUP_UNC ns, hold $SPEC_HOLD_UNC ns"

    # 072: route.tcl lines 158-192, verbatim
    # Insert Standard Cell Fillers (Pulling from scl180_filler.ndm via reference libraries)
    set fill_cells [get_lib_cells -quiet [list ${FILLER_LIB}/feedth9 ${FILLER_LIB}/feedth3 ${FILLER_LIB}/feedth]]
    if {[sizeof_collection $fill_cells] == 0} {
        set fill_cells [get_lib_cells -quiet {*/feedth9 */feedth3 */feedth}]
    }
    if {[sizeof_collection $fill_cells] > 0} { 
        create_stdcell_fillers -lib_cells $fill_cells
        connect_pg_net -automatic
        connect_pg_net -net VDD [get_pins -hierarchical -quiet */VDD]
        connect_pg_net -net VSS [get_pins -hierarchical -quiet */VSS]
    } else {
        puts "ERROR: feedth filler cells not found in reference libraries!"
    }

    # 7. Connect PG Nets for Any Post-Route ECO & Filler Cells
    connect_pg_net -automatic
    connect_pg_net -net VDD [get_pins -hierarchical -quiet */VDD]
    connect_pg_net -net VSS [get_pins -hierarchical -quiet */VSS]

    # Fix filler-induced DRCs and close any open nets without ripping up clean global routes
    route_detail -incremental true -max_number_iterations 100
    route_eco \
        -reuse_existing_global_route true \
        -utilize_dangling_wires true \
        -reroute modified_nets_first_then_others \
        -max_detail_route_iterations 200
    # Final pass specifically ensuring 0 open nets remain
    route_eco \
        -open_net_driven true \
        -reuse_existing_global_route true \
        -utilize_dangling_wires true \
        -reroute modified_nets_first_then_others \
        -max_detail_route_iterations 200
    route_detail -incremental true -max_number_iterations 100
    check_routes

    # --------------------------------------------------------------------------
    # 7. Checks (nothing is saved when one fails)
    # --------------------------------------------------------------------------
    set tc_cr [ant068_check_routes_counts]
    set tc_drc [lindex $tc_cr 0]
    set tc_open [lindex $tc_cr 1]
    puts ">>> 072 check_routes AFTER: DRCs $tc_drc, open nets $tc_open, ICC2 antenna violations [lindex $tc_cr 2]"
    if {$tc_drc eq ""} { lappend tc_failures "check_routes DRC count not readable" } elseif {$tc_drc != 0} { lappend tc_failures "check_routes DRCs $tc_drc (0 required)" }
    if {$tc_open eq ""} { lappend tc_failures "check_routes open-net count not readable" } elseif {$tc_open != 0} { lappend tc_failures "check_routes open nets $tc_open (0 required)" }

    redirect -variable tc_leg_txt { check_legality -verbose }
    puts $tc_leg_txt
    set tc_leg [ant_parse_legality $tc_leg_txt]
    if {$tc_leg eq ""} { if {![catch {sizeof_collection [check_legality -cell_violation]} v]} { set tc_leg $v } }   ;# 068: VERIFY -cell_violation as the fallback when the text has no number
    puts ">>> 072 CHECK legality violations: [expr {$tc_leg eq {} ? {unreadable} : $tc_leg}] (0 required)"
    if {$tc_leg eq ""} { lappend tc_failures "check_legality result unreadable" } elseif {$tc_leg != 0} { lappend tc_failures "legality violations $tc_leg" }

    set tc_snap1 [lmap nm $tc_names {ant072_snapshot $nm}]
    set tc_diff [ant072_snapshot_diff $tc_snap0 $tc_snap1]
    puts ">>> 072 CHECK protected cells ([llength $tc_names]): [expr {[llength $tc_diff] ? $tc_diff : {reference, origin, orientation and every pin connection are identical to the snapshot}}]"
    foreach d $tc_diff { lappend tc_failures "protected cell: $d" }
    set tc_nbuf1 [sizeof_collection [get_cells -quiet ${BUF_PREFIX}_*]]
    puts ">>> 072 CHECK ${BUF_PREFIX}_* count: $tc_nbuf before, $tc_nbuf1 after"
    if {$tc_nbuf1 != $tc_nbuf} { lappend tc_failures "${BUF_PREFIX}_* count $tc_nbuf -> $tc_nbuf1" }
    set tc_loads1 [ant068_net_leaf_pins $CLK_PORT]
    puts ">>> 072 CHECK $CLK_PORT leaf loads: $tc_loads1, root $tc_root reference [dict get [lindex $tc_snap1 end] ref] (before [dict get [lindex $tc_snap0 end] ref])"
    if {$tc_loads1 ne $tc_loads} { lappend tc_failures "the leaf loads of $CLK_PORT changed: $tc_loads -> $tc_loads1" }

    set tc_stats1 [ant072_stats AFTER $tc_filter $tc_site $tc_lef $FILLER_REFS]
    set tc_a0 [dict get $tc_stats0 area]
    set tc_a1 [dict get $tc_stats1 area]
    if {[string is double -strict $tc_a0] && [string is double -strict $tc_a1]} {
        set tc_cell_sites [expr {($tc_a1 - $tc_a0) / ($tc_site * $tc_row_h)}]
    } else {
        set tc_cell_sites 0.0
        puts ">>> 072 cell area before or after is UNKNOWN: the filler check uses the filler COUNT only (no site-balance explanation)"
    }
    lassign [ant072_filler_check $tc_nfill0 [dict get $tc_stats1 nfill] [dict get $tc_stats0 fsites] [dict get $tc_stats1 fsites] $tc_cell_sites $FILLER_TOL_PCT] tc_fok tc_fmsg
    puts ">>> 072 CHECK fillers: $tc_fmsg"
    if {!$tc_fok} { lappend tc_failures $tc_fmsg }
    puts ">>> 072 ADDED by the pass: cells [ant072_delta [dict get $tc_stats0 ncell] [dict get $tc_stats1 ncell] %d], area [ant072_delta $tc_a0 $tc_a1] um^2, buffers [ant072_delta [dict get $tc_stats0 nbuf] [dict get $tc_stats1 nbuf] %d], inverters [ant072_delta [dict get $tc_stats0 ninv] [dict get $tc_stats1 ninv] %d] (hold buffers and resizing by route_opt; n/a = UNKNOWN)"

    # --------------------------------------------------------------------------
    # 8. AFTER and verdict
    # --------------------------------------------------------------------------
    puts ">>> 072 timing after route_opt and legalisation, before the fillers / route_eco steps: setup WNS [dict get $tc_afteropt setup], hold WNS [dict get $tc_afteropt hold] (compare with AFTER below: the difference is what the filler and route_eco steps of route.tcl cost)"
    set tc_after [ant072_metrics AFTER]
    ant072_paths AFTER
    if {[catch {redirect -variable tc_cq1 { report_clock_qor -type summary }} err]} {
        puts ">>> 072 AFTER report_clock_qor failed: $err"
    } else {
        puts ">>> 072 AFTER ===== report_clock_qor -type summary =====\n$tc_cq1"
    }
    lassign [ant072_verdict $tc_before $tc_after $WORSE_TOL $IMPROVE_EPS] tc_verdict tc_vwhy
    puts ">>> 072 VERDICT $tc_verdict: $tc_vwhy"
    puts ">>> 072 BEFORE setup WNS [dict get $tc_before setup] hold WNS [dict get $tc_before hold]; AFTER setup WNS [dict get $tc_after setup] hold WNS [dict get $tc_after hold]"

    if {[llength $tc_failures] > 0} {
        error "ERROR 072: [llength $tc_failures] check(s) failed, NOTHING SAVED: [join $tc_failures {; }]"
    }

    # --------------------------------------------------------------------------
    # 9. Save over _route (as fix_antenna.tcl) and finish
    # --------------------------------------------------------------------------
    if {!$KEEP_PROTECTION} {
        catch {set_dont_touch $tc_cells false}
        if {$PROTECT_NETS} { catch {set_dont_touch [get_nets -quiet -exact $tc_pnets] false} }
        foreach e $tc_status0 { catch {set_attribute -objects [get_cells -exact [lindex $e 0]] -name physical_status -value [lindex $e 1]} }
        puts ">>> 072 protection removed before saving"
    } else {
        puts ">>> 072 protection (dont_touch on the cells[expr {$PROTECT_NETS ? { and their nets} : {}}], fixed placement) is KEPT in the saved block"
    }
    save_block
    save_block -force -as ${DESIGN_NAME}_route
    save_lib
    puts ">>> STAGE 6e COMPLETE: route_opt passes $tc_pass, verdict $tc_verdict ($tc_vwhy), setup WNS [dict get $tc_before setup] -> [dict get $tc_after setup], hold WNS [dict get $tc_before hold] -> [dict get $tc_after hold], ${DESIGN_NAME}_route overwritten in place. Log: ${LOG_DIR}/6e_timing_closure.log"
    puts ">>> 072 NEXT: metal_fill.tcl, pv.tcl, then NEW Calibre DRC and antenna runs (both must stay 0)."
}

set ec_b [string first "# ---- BEGIN PURE TCL 072 ----" $ec_src2]
5439
set ec_e [string first "# ---- END PURE TCL 072 ----" $ec_src2]
13762
set ec_h [string first "# 072: ICC2 side helpers of this script" $ec_src2]
14573
set ec_f [string first "file mkdir \$LOG_DIR" $ec_src2]
22486
if {$ec_b < 0 || $ec_e < 0 || $ec_h < 0 || $ec_f < 0 || $ec_f <= $ec_h} { error "ERROR 079: markers not found in ${SCRIPT_DIR}/timing_closure.tcl" }
eval [string range $ec_src2 $ec_b $ec_e]
eval [string range $ec_src2 $ec_h [expr {$ec_f - 1}]]
unset ec_src ec_src2 ec_b ec_e ec_h ec_f ec_n
# 079: ICC2 side helpers of this script (not tested locally)
proc eco097_geom {inst sigout} {   ;# 097 (ICC2 side): the driver pin centre, the driver-to-port distance (first port on the net) and the driver-to-centroid-of-the-loads distance of the output net of a cell; "" for what cannot be read. VERIFY get_ports -of_objects <net>
    set res [dict create driver "" port "" centroid "" nloads 0]
    if {[catch {
        set pin [get_pins -quiet -exact "$inst/$sigout"]
        if {[sizeof_collection $pin] != 1} { error "no pin $inst/$sigout" }
        lassign [ant068_centre $pin] dx dy
        dict set res driver [list $dx $dy]
        set net [eco079_net_of_pin "$inst/$sigout"]
        if {$net eq ""} { error "no net on $inst/$sigout" }
        set ports [get_ports -quiet -of_objects [get_nets -exact $net]]
        foreach_in_collection pt $ports {
            set xy [eco079_port_xy [get_object_name $pt]]
            if {$xy ne ""} { dict set res port [ant_manhattan $dx $dy [lindex $xy 0] [lindex $xy 1]]; break }
        }
        set sx 0.0; set sy 0.0; set n 0
        foreach lp [eco079_net_leaf_pins $net] {
            if {$lp eq "$inst/$sigout"} continue
            set po [get_pins -quiet -exact $lp]
            if {[sizeof_collection $po] != 1} continue
            lassign [ant068_centre $po] lx ly
            set sx [expr {$sx + $lx}]; set sy [expr {$sy + $ly}]; incr n
        }
        dict set res nloads $n
        if {$n > 0} { dict set res centroid [ant_manhattan $dx $dy [expr {$sx / $n}] [expr {$sy / $n}]] }
    } err]} { dict set res err $err }
    return $res
}
proc eco095_marker_names {mark} {   ;# 095: the full names of the cells whose name contains the marker (ICC2 side)
    set l {}
    foreach_in_collection c [get_cells -quiet -hierarchical -filter "name =~ *${mark}*"] { lappend l [get_object_name $c] }
    return $l
}
proc eco079_lookup_pin {full} {   ;# 079: the pin object name, or "" ; VERIFY get_pins -exact with a hierarchical leaf pin name
    set p [get_pins -quiet -exact $full]
    if {[sizeof_collection $p] == 1} { return [get_object_name $p] }
    set p [get_pins -quiet -hierarchical -filter "full_name == $full"]
    if {[sizeof_collection $p] == 1} { return [get_object_name $p] }
    return ""
}
proc eco079_lookup_cell {full} {
    set c [get_cells -quiet -exact $full]
    if {[sizeof_collection $c] == 1} { return [get_object_name $c] }
    set c [get_cells -quiet -hierarchical -filter "full_name == $full"]
    if {[sizeof_collection $c] == 1} { return [get_object_name $c] }
    return ""
}
proc eco079_lookup_net {full} {
    set n [get_nets -quiet -exact $full]
    if {[sizeof_collection $n] == 1} { return [get_object_name $n] }
    set n [get_nets -quiet -hierarchical -filter "full_name == $full"]
    if {[sizeof_collection $n] == 1} { return [get_object_name $n] }
    return ""
}
proc eco079_lookup_port {name} {   ;# 079 fix: the port object name or "" ; -exact as antenna_port_buffers.tcl (names with brackets such as dma_rdata[14])
    set p [get_ports -quiet -exact $name]
    if {[sizeof_collection $p] == 1} { return [get_object_name $p] }
    return ""
}
proc eco079_port_xy {name} {   ;# 079 fix: the centre of the first terminal of the port (the pin location, as antenna_port_buffers.tcl); "" if none
    set t [get_terminals -quiet -of_objects [get_ports -quiet -exact $name]]
    if {[sizeof_collection $t] == 0} { return "" }
    return [ant068_centre [index_collection $t 0]]
}
proc eco079_net_of_port {name} {   ;# 079 fix: the net object name of a port, "" if none
    set n [get_nets -quiet -of_objects [get_ports -quiet -exact $name]]
    if {[sizeof_collection $n] >= 1} { return [get_object_name [index_collection $n 0]] }
    return ""
}
proc eco079_net_of_pin {pinname} {   ;# the net object name of a pin, "" if none
    set n [get_nets -quiet -of_objects [get_pins -quiet -exact $pinname]]
    if {[sizeof_collection $n] >= 1} { return [get_object_name [index_collection $n 0]] }
    return ""
}
proc eco079_net_leaf_pins {netname} {
    set out {}
    foreach_in_collection p [get_pins -quiet -leaf -of_objects [get_nets -quiet -exact $netname]] { lappend out [get_object_name $p] }
    upvar #0 ea_pgnames pgn   ;# 079 fix 2: power / ground pins never belong to the signal topology (set from the LEF in step 3)
    if {[info exists pgn]} { return [eco079_drop_pg $out $pgn] }
    return $out
}
proc eco079_driver_info {netname} {   ;# {driver_cells has_input_port driver_xy}: the cells of the output leaf pins of the net, an input port on it, a point to measure from
    set cells {}
    set xy ""
    foreach_in_collection p [get_pins -quiet -leaf -of_objects [get_nets -quiet -exact $netname] -filter "direction == out"] {
        lappend cells [get_object_name [get_cells -quiet -of_objects $p]]
        if {$xy eq ""} { set xy [ant068_centre $p] }
    }
    set hp 0
    foreach_in_collection po [get_ports -quiet -of_objects [get_nets -quiet -exact $netname]] {   ;# VERIFY get_ports -of_objects <net>
        if {[get_attribute -quiet $po direction] eq "in"} { set hp 1; if {$xy eq ""} { set xy [ant068_centre $po] } }
    }
    return [list $cells $hp $xy]
}
proc eco081_list_errors {label} {   ;# 081: the DRC errors of check_routes as a list of dicts {type_name layer(s) bounding_box nets}; every failure is printed raw, nothing is swallowed. VERIFY every command here.
    global DRC_ERR_NAME eco081_info_done eco081_noattr
    if {![info exists eco081_info_done]} {
        set eco081_info_done 1
        foreach pat {*drc_error*} { if {[catch {help $pat} herr]} { puts ">>> 081 help $pat failed: $herr" } }
        foreach c {open_drc_error_data get_drc_error_data get_drc_errors write_drc_error_data close_drc_error_data} { puts ">>> 081 command $c: [expr {[llength [info commands $c]] ? {exists} : {NOT found}}]" }
        if {[catch {redirect -variable la_txt { list_attributes -class drc_error }; puts ">>> 081 drc_error attributes: [join [lrange [split $la_txt "\n"] 0 40] { }]"} lerr]} { puts ">>> 081 list_attributes -class drc_error failed: $lerr" }
    }
    set coll ""
    set got 0
    foreach open_cmd [list "" "open_drc_error_data $DRC_ERR_NAME" "open_drc_error_data -name $DRC_ERR_NAME"] {
        if {$open_cmd ne ""} { if {[catch {eval $open_cmd} oerr]} { puts ">>> 081 $label: $open_cmd failed: $oerr"; continue } else { puts ">>> 081 $label: $open_cmd ok" } }
        if {[catch {set coll [get_drc_errors -error_data $DRC_ERR_NAME *]} gerr]} { puts ">>> 081 $label: get_drc_errors -error_data $DRC_ERR_NAME * failed: $gerr"; continue }
        set got 1
        break
    }
    set recs {}
    if {!$got} {
        puts ">>> 081 $label: the DRC errors could not be listed with get_drc_errors; trying write_drc_error_data"
        set ef $::LOG_DIR/6g_drc_errors.txt
        if {[catch {write_drc_error_data $ef} werr] && [catch {write_drc_error_data -file $ef} werr2]} { puts ">>> 081 $label: write_drc_error_data failed: $werr / $werr2" } elseif {[file exists $ef]} { puts ">>> 081 $label: error data written to $ef; first lines: [join [lrange [split [eco079_read $ef] "\n"] 0 15] { | }]" }
        return $recs
    }
    puts ">>> 081 $label: [sizeof_collection $coll] DRC error object(s)"
    foreach_in_collection e $coll {
        set rec [dict create]
        foreach a {type_name layer layers bounding_box} {
            set v ""
            catch {set v [get_attribute -quiet $e $a]}
            if {$v ne ""} { dict set rec $a $v } else { set eco081_noattr($a) 1 }
        }
        set nets {}
        catch { foreach_in_collection o [get_attribute -quiet $e objects] { if {[get_attribute -quiet $o object_class] eq "net"} { lappend nets [get_object_name $o] } } }   ;# VERIFY the attribute objects
        dict set rec nets $nets
        lappend recs $rec
    }
    if {[array exists eco081_noattr]} { puts ">>> 081 NOTE: attributes empty or not readable on the error objects: [lsort [array names eco081_noattr]]" }
    return $recs
}
proc eco081_nets_in_window {w} {   ;# 081: signal net names whose shapes intersect the window; VERIFY get_nets -intersect and the attribute net_type
    set out {}
    if {[catch {
        foreach_in_collection n [get_nets -quiet -intersect $w] {
            set nt [get_attribute -quiet $n net_type]
            if {$nt eq "power" || $nt eq "ground"} continue
            lappend out [get_object_name $n]
        }
    } err]} { puts ">>> 081 get_nets -intersect $w failed: $err" }
    return $out
}
proc eco081_cleanup {protected_nets} {   ;# 081: returns {drc open antenna history}; the DRC clean-up loop (rounds, windows, nets), prints everything
    global DRC_ROUNDS DRC_WINDOW_MARGIN
    set hist {}
    lassign [ant068_check_routes_counts] d o a
    lappend hist [list "after routing" $d]
    puts ">>> 081 DRC clean-up: check_routes after routing: DRCs $d, open nets $o, ICC2 antenna violations $a"
    set round 0
    while {1} {
        set act [eco081_next_action $d $round $DRC_ROUNDS]
        if {$act ne "retry"} break
        incr round
        puts ">>> 081 DRC clean-up round $round of $DRC_ROUNDS: $d DRC(s) before"
        set recs [eco081_list_errors "round $round"]
        foreach r $recs { puts ">>> 081   DRC: [eco081_error_line $r]" }
        if {[catch {route_detail -incremental true -max_number_iterations 40} err]} { puts ">>> 081 route_detail -incremental failed: $err" }
        lassign [ant068_check_routes_counts] d o a
        lappend hist [list "round $round (incremental route)" $d]
        puts ">>> 081 round $round after route_detail -incremental: DRCs $d, open nets $o"
        if {[eco081_next_action $d $round $DRC_ROUNDS] eq "done"} continue
        set recs [eco081_list_errors "round $round remaining"]
        set boxes {}
        foreach r $recs { if {[dict exists $r bounding_box]} { lappend boxes [dict get $r bounding_box] } }
        set wins [eco081_windows $boxes $DRC_WINDOW_MARGIN]
        set nets {}
        foreach w $wins {
            set nw [eco081_nets_in_window $w]
            puts ">>> 081 round $round window $w: [llength $nw] net(s)[expr {[llength $nw] ? " : [lrange $nw 0 7]" : {}}]"
            lappend nets {*}$nw
            if {[catch {route_detail -incremental true -max_number_iterations 40 -coordinates [list $w]} err]} { puts ">>> 081 route_detail -coordinates $w failed: $err" }
        }
        foreach r $recs { lappend nets {*}[dict get $r nets] }
        lassign [eco081_split_nets $nets $protected_nets] use skipped
        if {[llength $skipped]} { puts ">>> 081 round $round: [llength $skipped] protected net(s) (antenna buffers / clock root) are NOT re-routed: $skipped" }
        if {[llength $use] > 0} {
            set coll [get_nets -quiet -exact $use]
            puts ">>> 081 round $round: route_eco -nets <[sizeof_collection $coll] nets> -reuse_existing_global_route false"
            if {[catch {route_eco -nets $coll -reuse_existing_global_route false -reroute modified_nets_first_then_others -max_detail_route_iterations 60} err]} { puts ">>> 081 route_eco -nets failed: $err" }
            if {[catch {route_detail -incremental true -max_number_iterations 40} err]} { puts ">>> 081 route_detail -incremental failed: $err" }
        } else { puts ">>> 081 round $round: no net found for the error windows (the windowed route_detail above is all that was done)" }
        lassign [ant068_check_routes_counts] d o a
        lappend hist [list "round $round (windows + nets)" $d]
        puts ">>> 081 round $round after the windows and nets: DRCs $d, open nets $o"
    }
    puts ">>> 081 DRC clean-up result: [eco081_next_action $d $round $DRC_ROUNDS]; DRC counts: [eco081_history_text $hist]"
    if {[string is integer -strict $d] && $d > 0} {
        foreach r [eco081_list_errors "REMAINING after $round round(s)"] { puts ">>> 081 REMAINING DRC: [eco081_error_line $r]" }
    }
    return [list $d $o $a $hist]
}
proc eco079_in2out_state {label} {   ;# 080: {wns num source}: setup WNS of the in2out group (even when it has no violator), its violating endpoints, and where the WNS came from
    global SETUP_SCEN GATE_GROUP_PATTERN CLK_PORT
    lassign [ant072_wns $SETUP_SCEN max] w t n groups
    lassign [eco079_group_violators $groups $GATE_GROUP_PATTERN] gv_w gv_n
    set gnames {}
    catch { foreach_in_collection g [get_path_groups -quiet *] { lappend gnames [get_object_name $g] } }   ;# VERIFY get_path_groups
    set match [eco079_group_match $gnames $GATE_GROUP_PATTERN]
    set gw ""
    foreach g $match {
        if {[catch {
            set p [get_timing_paths -scenarios $SETUP_SCEN -delay_type max -groups $g -max_paths 1]   ;# VERIFY get_timing_paths -groups
            if {[sizeof_collection $p] > 0} { set sl [get_attribute $p slack]; if {$gw eq "" || $sl < $gw} { set gw $sl } }
        } err]} { puts ">>> 080 $label in2out: the WNS of path group $g could not be read: $err" }
    }
    set fw ""
    if {[catch {
        set ins [remove_from_collection [all_inputs] [get_ports -quiet -exact $CLK_PORT]]
        # 081: only input ports whose net has loads: an unused port (the unused paddr bits) is "not a timing startpoint" (TIM-010) and made a warning per port
        set used ""
        set nunused 0
        foreach_in_collection ip $ins {
            set nt [get_nets -quiet -of_objects $ip]
            if {[sizeof_collection $nt] > 0 && [sizeof_collection [get_pins -quiet -leaf -of_objects $nt -filter "direction == in"]] > 0} { append_to_collection used $ip } else { incr nunused }
        }
        puts ">>> 080 $label in2out: $nunused input port(s) without a loaded net are left out of the -from list (TIM-010 'not a timing startpoint' silenced)"
        if {$used ne ""} { set ins $used }
        set p [get_timing_paths -scenarios $SETUP_SCEN -delay_type max -from $ins -to [all_outputs] -max_paths 1]   ;# VERIFY get_timing_paths -from <ports> -to <ports>
        if {[sizeof_collection $p] > 0} { set fw [get_attribute $p slack] }
    } err]} { puts ">>> 080 $label in2out: the worst input-to-output path could not be read: $err" }
    if {$gw ne ""} { set src "path group(s) $match" } elseif {$fw ne ""} { set src "worst setup path from an input port to an output port (no path group named *$GATE_GROUP_PATTERN* was readable; groups seen: $gnames)"; set gw $fw } else { set src "UNREADABLE (groups seen: $gnames)" }
    puts ">>> 080 $label in2out: WNS [expr {$gw eq {} ? {UNKNOWN} : $gw}] ns from $src; worst input-to-output path [expr {$fw eq {} ? {UNKNOWN} : $fw}] ns; violating endpoints in the group: $gv_n"
    return [list $gw $gv_n $src]
}
file mkdir $LOG_DIR
redirect -tee -file ${LOG_DIR}/6g_pt_eco_apply.log {
    puts ">>> RUN ROOT: $RUN_ROOT"   ;# 082: the log shows which clone wrote it

    set ea_failures {}

    set open_blk [get_blocks -quiet *]
    if {[sizeof_collection $open_blk] > 0} { close_blocks -force $open_blk }
    set open_lib [get_libs -quiet *]
    if {[sizeof_collection $open_lib] > 0} { foreach_in_collection lib_obj $open_lib { close_lib -force $lib_obj } }
    open_lib ${BLOCKS_DIR}/${DESIGN_NAME}.dlib
    open_block ${DESIGN_NAME}.dlib:${DESIGN_NAME}_route
    current_block ${DESIGN_NAME}_route
    link_block
    unpu_remove_clock_latency pt_eco_apply   ;# 088: remove the tool-made set_clock_latency (a no-op when the block is clean); prints the counts per scenario, ERROR 088 if any is left
    puts ">>> 079 block ${DESIGN_NAME}_route opened (it is overwritten in place at the end; the README tells the user to back up the library first)"

    # --------------------------------------------------------------------------
    # 1. Parse the change files
    # --------------------------------------------------------------------------
    if {![file exists $ECO_HOLD_FILE] || [file size $ECO_HOLD_FILE] == 0} { error "ERROR 079: the hold change file $ECO_HOLD_FILE is missing or empty (pt_eco_probe.tcl writes it; copy it from the PrimeTime run to $PT_DIR)" }
    set ea_files [list hold $ECO_HOLD_FILE]
    if {$ECO_SETUP_FILE ne "" && [file exists $ECO_SETUP_FILE] && [file size $ECO_SETUP_FILE] > 0} { lappend ea_files setup $ECO_SETUP_FILE } else { puts ">>> 079 the optional setup change file $ECO_SETUP_FILE does not exist (or is empty): the setup ECO is SKIPPED" }
    set ea_cmds {}
    set ea_perr {}
    foreach {kind f} $ea_files {
        set pr [eco079_parse [eco079_read $f]]
        set k 0
        foreach c [dict get $pr cmds] {
            dict set c file $kind
            dict set c idx [expr {[llength $ea_cmds] + 1}]
            lappend ea_cmds $c
            incr k
        }
        foreach e [dict get $pr errors] { lappend ea_perr "$f: $e" }
        puts ">>> 079 $kind change file $f: $k change command(s)"
    }
    if {[llength $ea_perr] > 0} { error "ERROR 079: [llength $ea_perr] line(s) of the change files are not understood, NOTHING was changed:\n    [join $ea_perr "\n    "]" }
    set ea_nins 0; set ea_nsize 0
    foreach c $ea_cmds { if {[dict get $c type] eq "insert_buffer"} { incr ea_nins } else { incr ea_nsize } }
    puts ">>> 079 changes in total: $ea_nins insert_buffer, $ea_nsize size_cell"
    set ea_hold_n 0
    foreach c $ea_cmds { if {[dict get $c file] eq "hold"} { incr ea_hold_n } }
    set ea_cf_exists [expr {[file exists $ECO_COUNT_FILE] && [file size $ECO_COUNT_FILE] > 0}]
    set ea_cf_text ""
    if {$ea_cf_exists} { set ea_cf_text [eco079_read $ECO_COUNT_FILE] }
    if {[catch {lassign [eco079_expect_decide $ea_cf_exists $ea_cf_text $EXPECT_HOLD_CMDS EXPECT_HOLD_CMDS] ea_expect ea_expect_src ea_expect_warn} err]} { error "ERROR 079: $ECO_COUNT_FILE: $err (nothing changed)" }
    if {$ea_expect_warn ne ""} { puts ">>> 079 WARNING: $ea_expect_warn" }
    puts ">>> 079 expected number of hold commands: $ea_expect (from $ea_expect_src[expr {$ea_cf_exists ? ", $ECO_COUNT_FILE" : {}}])"
    lassign [eco079_count_check "hold change file commands" $ea_hold_n $ea_expect] ok msg
    puts ">>> 079 CHECK $msg"
    if {!$ok} { error "ERROR 079: $msg (nothing changed)" }

    # 093: the pin class of every hold insertion as the probe computed it (a load pin on a flop-driven net is safe; a cone net, a cone driver pin, a cone port or an unreadable pin is a violation). Information and a stop
    # 093: on a violation or a class file of another change file; the gates below stay the proof in ICC2's timing.
    set ea_cls_file $ECO_CLASS_FILE
    if {$ECO_KIND eq "setup"} {
        puts ">>> 093 the pin classes of the setup kind are the size_cell classes checked below (098)"
    } elseif {![file exists $ea_cls_file] && $ECO_KIND eq "drc"} { error "ERROR 095: the pin-class file $ea_cls_file is missing: for the kind drc it is REQUIRED (it carries the in2out-cone and clock-network classes of pt_eco_drc_probe.tcl); nothing changed" }
    if {$ECO_KIND eq "setup"} {
        # 098: size_cell rows, checked below
    } elseif {![file exists $ea_cls_file]} {
        puts ">>> 093 no pin-class file $ea_cls_file (pt_eco_probe.tcl writes it since task 093): no class is printed; the in2out and setup gates below are the proof"
    } else {
        set ea_cp [eco093_parse_classes [eco079_read $ea_cls_file]]
        if {[llength [dict get $ea_cp errors]] > 0} { error "ERROR 093: $ea_cls_file: [join [dict get $ea_cp errors] { | }] (nothing changed)" }
        set ea_hcmds {}
        foreach c $ea_cmds { if {[dict get $c file] eq "hold"} { lappend ea_hcmds $c } }
        lassign [eco093_check $ea_hcmds [dict get $ea_cp rows]] ea_cl ea_cprob
        foreach l $ea_cl { puts ">>> 093 $l" }
        if {[llength $ea_cprob] > 0} { error "ERROR 093: the pin classes of $ea_cls_file do not allow this ECO: [join $ea_cprob { | }] (nothing changed)" }
        puts ">>> 093 CHECK pin classes: [llength $ea_cl] hold insertions, none in a violation class"
    }

    # 098: the SETUP kind is size_cell only (the probe stops and reports when PrimeTime needs an insertion on the read path); its class file carries one row per size_cell change
    set ea_earlier {}
    if {$ECO_KIND eq "setup"} {
        foreach c $ea_cmds { if {[dict get $c type] ne "size_cell"} { error "ERROR 098: the setup kind is size_cell only, but change [dict get $c idx] (line [dict get $c line]) is an insert_buffer on [dict get $c full_pin]: the probe should have stopped for a decision (nothing changed)" } }
        if {![file exists $ECO_CLASS_FILE]} { error "ERROR 098: the class file $ECO_CLASS_FILE is missing: for the kind setup it is REQUIRED (nothing changed)" }
        set ea_cp2 [eco093_parse_classes [eco079_read $ECO_CLASS_FILE]]
        if {[llength [dict get $ea_cp2 errors]] > 0} { error "ERROR 098: $ECO_CLASS_FILE: [join [dict get $ea_cp2 errors] { | }] (nothing changed)" }
        lassign [eco098_check_size $ea_cmds [dict get $ea_cp2 rows]] ea_cl2 ea_cprob2
        foreach l $ea_cl2 { puts ">>> 098 $l" }
        if {[eco098_rows_problem [dict get $ea_cp2 rows] $ea_cmds] ne ""} { lappend ea_cprob2 [eco098_rows_problem [dict get $ea_cp2 rows] $ea_cmds] }   ;# the number of ROWS (dict size: comment and blank lines are not rows)
        if {[llength $ea_cprob2] > 0} { error "ERROR 098: the classes of $ECO_CLASS_FILE do not allow this ECO: [join $ea_cprob2 { | }] (nothing changed)" }
        puts ">>> 098 CHECK size classes: [llength $ea_cl2] size_cell changes, none in a violation class (a cone cell only to a FASTER reference, nothing on the clock network)"
    }
    # 098: cells of earlier rounds (the resized drivers of the max-transition ECO, task 095) are protected and may not be targeted again
    if {$ECO_KIND ne "drc"} {
        set ea_ef [file join [eco092_pt_dir $PNR_DIR $PT_TAG] pt_eco_drc_changes_icc2.tcl]
        if {[file exists $ea_ef]} {
            foreach ea_in [eco098_earlier_instances [list [eco079_read $ea_ef]]] { if {[eco079_lookup_cell $ea_in] ne ""} { lappend ea_earlier $ea_in } }
            puts ">>> 098 earlier-round cells from $ea_ef: [llength $ea_earlier] found in the design (protected, unchanged at the end)"
        } else { puts ">>> 098 no earlier max-transition change file $ea_ef: the resized drivers of task 095 are not protected by name (the end check of reference and pins of the other protected cells stays)" }
        foreach c $ea_cmds { if {[dict get $c type] eq "size_cell" && [lsearch -exact $ea_earlier [dict get $c full_inst]] >= 0} { error "ERROR 098: change [dict get $c idx] resizes [dict get $c full_inst], a cell of an earlier round (protected) (nothing changed)" } }
    }

    # --------------------------------------------------------------------------
    # 2. Pins, references, names (nothing is changed on any error here)
    # --------------------------------------------------------------------------
    set ea_prob {}
    set ea_deferred 0
    set ea_nport 0
    foreach c $ea_cmds {
        set idx [dict get $c idx]
        if {[dict get $c type] eq "insert_buffer" && [dict get $c objkind] eq "port"} {
            set pn [dict get $c full_pin]
            if {[eco079_lookup_port $pn] eq ""} {
                lappend ea_prob "change $idx (line [dict get $c line]): port $pn not found in the design"
            } else {
                incr ea_nport
                set pdir [get_attribute -quiet [get_ports -exact $pn] direction]   ;# VERIFY port attribute direction (in / out / inout)
                if {$pdir ne "in"} { lappend ea_prob "change $idx (line [dict get $c line]): port $pn has direction '$pdir', only input ports are supported (the loads move behind the new cell)" }
                if {[eco079_port_xy $pn] eq ""} { lappend ea_prob "change $idx (line [dict get $c line]): port $pn has no terminal (no pin location)" }
                if {[eco079_net_of_port $pn] eq ""} { lappend ea_prob "change $idx (line [dict get $c line]): port $pn has no net" }
            }
        } elseif {[dict get $c type] eq "insert_buffer"} {
            if {[eco079_is_deferred $ea_cmds $idx [dict get $c full_pin] 0]} { incr ea_deferred; continue }
            if {[eco079_lookup_pin [dict get $c full_pin]] eq ""} { lappend ea_prob "change $idx (line [dict get $c line]): pin [dict get $c full_pin] not found" }
        } else {
            if {[eco079_is_deferred $ea_cmds $idx [dict get $c full_inst] 1]} { incr ea_deferred; continue }
            if {[eco079_lookup_cell [dict get $c full_inst]] eq ""} { lappend ea_prob "change $idx (line [dict get $c line]): cell [dict get $c full_inst] not found" }
        }
    }
    puts ">>> 079 pins/ports/cells checked: [llength $ea_cmds] changes ($ea_nport on a top-level port), $ea_deferred refer to a cell that an earlier insertion creates (looked up when applied), [llength $ea_prob] not found"
    foreach p $ea_prob { puts ">>> 079 ERROR $p" }

    set ea_libnames {}
    foreach_in_collection lc [get_lib_cells -quiet ${STD_LIB}/*] { lappend ea_libnames [lindex [split [get_object_name $lc] /] end] }   ;# the library prefix is the design's reference library (STD_LIB as in cts.tcl)
    set ea_rtab [eco079_ref_table $ea_cmds]
    puts ">>> 079 reference table (reference, count, in library, don't-use):"
    foreach r [lsort [dict keys $ea_rtab]] { puts ">>> 079   [format {%-10s %4d  in library: %-3s  don't-use: %s} $r [dict get $ea_rtab $r] [expr {[lsearch -exact $ea_libnames $r] >= 0 ? {yes} : {NO}}] [expr {[ant_dont_use $r $DONT_USE_PATTERNS] eq {} ? {no} : {YES}}]]" }
    foreach p [eco079_ref_problems [dict keys $ea_rtab] $ea_libnames $DONT_USE_PATTERNS] { lappend ea_prob $p; puts ">>> 079 ERROR $p" }
    set ea_ex_cells {}
    set ea_ex_nets {}
    foreach c $ea_cmds {
        if {[dict get $c type] ne "insert_buffer"} continue
        if {[eco079_lookup_cell [dict get $c cell]] ne ""} { lappend ea_ex_cells [dict get $c cell] }
        if {[eco079_lookup_net [dict get $c net]] ne ""} { lappend ea_ex_nets [dict get $c net] }
    }
    foreach p [eco079_name_problems $ea_cmds $ea_ex_cells $ea_ex_nets] { lappend ea_prob $p; puts ">>> 079 ERROR $p" }
    set ea_pre [eco095_marker_names $NEW_CELL_MARK]
    set ea_si_round [expr {$PT_SI && $ECO_KIND ne "drc"}]   ;# 098: the SI-on round runs on a block that already holds the cells of the first hold ECO: every cell with the marker that exists BEFORE is an earlier-round cell (protected, not counted as new); new names must not collide (eco079_name_problems)
    if {$ECO_KIND eq "drc"} { set ea_holdprev [eco095_hold_cells $ea_pre $HOLD_CELL_MARK]; set ea_pre [eco095_not_hold $ea_pre $NEW_CELL_MARK $HOLD_CELL_MARK] } elseif {$ea_si_round} { set ea_holdprev $ea_pre; set ea_pre {} } else { set ea_holdprev {} }
    if {[llength $ea_holdprev] > 0} { puts ">>> 095 the block already holds [llength $ea_holdprev] cells of the hold ECO ($HOLD_CELL_MARK): protected below, not counted as new" }
    if {[llength $ea_pre] > 0} { lappend ea_prob "[llength $ea_pre] cell(s) with $NEW_CELL_MARK in the name (other than the hold-ECO cells) already exist: this change list was applied before"; puts ">>> 079 ERROR [lindex $ea_prob end]" }
    if {[llength $ea_prob] > 0} { error "ERROR 079: [llength $ea_prob] problem(s) found before any change, NOTHING was changed (listed above)" }

    # --------------------------------------------------------------------------
    # 3. LEF sizes, BEFORE metrics, protected cells
    # --------------------------------------------------------------------------
    set fp [open $STD_LEF r]
    set ea_lef [ant_parse_lef [read $fp]]
    close $fp
    foreach r [dict keys $ea_rtab] {
        if {![dict exists $ea_lef $r] || [dict get $ea_lef $r w] eq ""} { error "ERROR 079: reference $r has no SIZE in the LEF $STD_LEF" }
    }
    set ea_site_w 1e9
    foreach f $FILLER_REFS { if {[dict exists $ea_lef $f] && [dict get $ea_lef $f w] ne "" && [dict get $ea_lef $f w] < $ea_site_w} { set ea_site_w [dict get $ea_lef $f w] } }
    if {$ea_site_w > 1e8} { error "ERROR 079: none of the filler masters $FILLER_REFS is in the LEF, the site width is unknown" }
    puts ">>> 079 site width $ea_site_w um; cell widths (um): [lmap r [lsort [dict keys $ea_rtab]] {list $r [dict get $ea_lef $r w]}]"

    set ea_pgnames [eco079_pg_names $ea_lef]
    puts ">>> 079 power / ground pin names (from the LEF, removed from every pin set of the topology check): $ea_pgnames"
    if {[llength $ea_pgnames] == 0} { error "ERROR 079: no power/ground pin found in the LEF (USE POWER / GROUND): the topology check cannot filter them (nothing changed)" }
    set ea_sig [dict create]
    foreach c $ea_cmds {
        if {[dict get $c type] ne "insert_buffer"} continue
        set r [dict get $c ref]
        if {[dict exists $ea_sig $r]} continue
        if {[catch {dict set ea_sig $r [eco079_signal_pins $r [dict get $ea_lef $r]]} err]} { error "ERROR 079: reference $r cannot be inserted as a buffer: $err (nothing changed)" }
        puts ">>> 079 reference $r: signal input [lindex [dict get $ea_sig $r] 0], signal output [lindex [dict get $ea_sig $r] 1]"
    }
    set ea_gate [dict create]
    foreach c $ea_cmds {
        if {[dict get $c type] eq "insert_buffer" && [dict get $c objkind] eq "port"} {
            set r [dict get $c ref]
            if {![dict exists $ea_gate $r]} {
                dict set ea_gate $r [eco079_in_gate [dict get $ea_lef $r]]
                lassign [eco079_port_limit [dict get $ea_gate $r] $PORT_MAX_PIN_BUF_DIST $PORT_ANT_RATIO_LIMIT $PORT_ANT_WEIGHT_PINWIRE $PORT_WIRE_WIDTH_UM] pl ptxt
                puts ">>> 079 port insertions with $r: input gate [format %.3f [dict get $ea_gate $r]] um^2, distance limit pin-to-cell [format %.1f $pl] um ($ptxt; ratio limit $PORT_ANT_RATIO_LIMIT, weight $PORT_ANT_WEIGHT_PINWIRE, wire width $PORT_WIRE_WIDTH_UM, all read from antenna_port_buffers.tcl)"
                if {$pl <= 0} { error "ERROR 079: reference $r cannot be placed on a port: $ptxt (nothing changed)" }
                lassign [eco079_port_tier2 [dict get $ea_gate $r] $PORT_ANT_WEIGHT_TOPM $PORT_TIER2_RATIO $PORT_WIRE_WIDTH_UM $pl] pl2 ptxt2
                if {$pl2 > 0} { puts ">>> 079 port insertions with $r: TIER 2 limit pin-to-cell [format %.1f $pl2] um ($ptxt2; TOP_M weight $PORT_ANT_WEIGHT_TOPM, ratio limit $PORT_TIER2_RATIO, both read from antenna_port_buffers.tcl)" } else { puts ">>> 079 port insertions with $r: NO tier 2 ($ptxt2)" }
            }
        }
    }
    set ea_m0 [ant072_metrics "079 BEFORE"]
    set ea_g0 [eco079_in2out_state "079 BEFORE"]
    lassign [ant068_check_routes_counts] ea_drc0 ea_open0 ea_ant0
    puts ">>> 079 check_routes BEFORE: DRCs $ea_drc0, open nets $ea_open0, ICC2 antenna violations $ea_ant0"

    set ea_names {}
    foreach_in_collection c [get_cells -quiet ${BUF_PREFIX}_*] { lappend ea_names [get_object_name $c] }
    set ea_nant [llength $ea_names]
    set ea_early {}
    foreach_in_collection c [get_cells -quiet ${EARLY_PREFIX}_*] { lappend ea_early [get_object_name $c] }
    set ea_nearly [llength $ea_early]
    lassign [eco092_protect_decide $ea_nant $ea_nearly] ea_pok ea_pmsg
    if {!$ea_pok} { error "ERROR 092: $ea_pmsg" }
    puts ">>> 092 $ea_pmsg"
    set ea_names [concat $ea_names $ea_early $ea_holdprev $ea_earlier]   ;# 095: the cells of the hold ECO (kind drc) are protected and compared like the antbuf_* / earlybuf_* cells
    set ea_loads [ant068_net_leaf_pins $CLK_PORT]
    if {[llength $ea_loads] != 1} { error "ERROR 079: the clock port net $CLK_PORT has [llength $ea_loads] leaf loads, 1 expected (the CTS root)" }
    set ea_root [get_object_name [get_cells -quiet -of_objects [get_pins -quiet -exact [lindex $ea_loads 0]]]]
    lappend ea_names $ea_root
    set ea_snap0 [lmap nm $ea_names {ant072_snapshot $nm}]
    set ea_pnets {}
    foreach s $ea_snap0 { foreach e [dict get $s pins] { set pn [lindex $e 1]; if {$pn ne "-" && $pn ne "VDD" && $pn ne "VSS" && [lsearch -exact $ea_pnets $pn] < 0} { lappend ea_pnets $pn } } }
    puts ">>> 079 protected cells: $ea_nant ${BUF_PREFIX}_* + $ea_nearly ${EARLY_PREFIX}_* + the clock root $ea_root ([dict get [lindex $ea_snap0 end] ref]); signal nets [llength $ea_pnets]"
    set ea_pcells [get_cells -quiet -exact $ea_names]
    if {$UNPROTECT_DURING} {
        catch {set_dont_touch $ea_pcells false}
        catch {set_dont_touch [get_nets -quiet -exact $ea_pnets] false}
        puts ">>> 079 dont_touch of the protected cells and nets switched OFF while the changes are applied (UNPROTECT_DURING 1); the snapshot comparison at the end is the guard"
    }

    # --------------------------------------------------------------------------
    # 4. Fillers into a table; apply the changes one at a time
    # --------------------------------------------------------------------------
    set ea_filter [join [lmap f $FILLER_REFS {string cat "ref_name == " $f}] " || "]
    set ea_ftable [ant070_all_fillers $ea_filter]
    puts ">>> 079 filler table: [llength $ea_ftable] filler instances"
    puts ">>> 097 a resized cell that does not fit in place is relocated to the nearest free run within MAX_RESIZE_MOVE_UM = [format %.1f $MAX_RESIZE_MOVE_UM] um (= PORT_MAX_PIN_BUF_DIST of step 6c), at most $MAX_SITE_TRIES candidate runs per change; a driver-to-port distance that grows by more than [format %.1f $RESIZE_PORT_WARN_UM] um is a WARNING"
    if {[llength $ea_ftable] == 0} { error "ERROR 079: no filler instance found with '$ea_filter'" }
    set ea_nfill0 [llength $ea_ftable]
    set ea_done {}
    set ea_failed {}
    set ea_watch {}
    set ea_touched {}
    set ea_moves {}
    set ea_removed 0
    set ea_freed_n 0   ;# 097: counter for the names of the pseudo rows (free sites that are not filler instances)
    set ea_ins_err_shown 0
    set ea_skipped {}
    set ea_gone {}
    foreach c $ea_cmds {
        set idx [dict get $c idx]
        set pl [eco079_progress [expr {$idx - 1}] [llength $ea_cmds] [llength $ea_done] [llength $ea_failed] 10]
        if {$pl ne ""} { puts ">>> 079 PROGRESS $pl" }
        set dep [eco079_depends_on_gone $c $ea_gone]
        if {$dep ne ""} {   ;# 079 fix 3: uses a pin of a cell that a skipped / failed change should have created
            set dreason "uses a pin of $dep, the cell of a skipped or failed change"
            puts ">>> 079 CHANGE $idx [expr {$ALLOW_PARTIAL ? {SKIPPED} : {FAILED}}]: $dreason"
            if {$ALLOW_PARTIAL} { lappend ea_skipped [dict create idx $idx line [dict get $c line] pin [expr {[dict get $c type] eq {insert_buffer} ? [dict get $c full_pin] : [dict get $c full_inst]}] reason $dreason on $dep] } else { lappend ea_failed "change $idx: $dreason" }
            if {[dict get $c type] eq "insert_buffer"} { lappend ea_gone [dict get $c cell] }
            continue
        }
        set ref [dict get $c ref]
        set lcname ${STD_LIB}/$ref
        set lc [get_lib_cells -quiet -exact $lcname]
        if {[sizeof_collection $lc] != 1} { lappend ea_failed "change $idx: library cell $lcname not found"; continue }
        set bw [dict get $ea_lef $ref w]
        set bh [dict get $ea_lef $ref h]
        if {[dict get $c type] eq "size_cell"} {
            # ---- size_cell: same cell, other master; the cell may grow to the right into free filler sites ----
            set inst [eco079_lookup_cell [dict get $c full_inst]]
            if {$inst eq ""} { lappend ea_failed "change $idx: cell [dict get $c full_inst] not found"; continue }
            set cc [get_cells -exact $inst]
            set oldref [get_attribute -quiet $cc ref_name]
            lassign [ant068_bbox_of $cc] cx0 cy0 cx1 cy1
            set extra [expr {$bw - ($cx1 - $cx0)}]
            set rm {}
            set rmode inplace
            set rl_shift 0.0; set rl_x $cx0; set rl_y $cy0; set rl_r0 0.0; set rl_r1 0.0; set rl_dist 0.0; set rl_ori ""
            set sg_out [eco097_out_pin [dict get $ea_lef $ref]]   ;# the single signal output of the new master (an02d7 has two inputs: ea_sig only holds the 1-in/1-out buffer references)
            set geom0 [eco097_geom $inst $sg_out]
            if {$extra > 0.001} {
                lassign [eco079_grow_plan [ant_filler_runs $ea_ftable] $cy0 $cx1 $extra $ea_site_w] gok rm greason
                if {$gok} {
                    remove_cells [get_cells -exact $rm]
                    set ea_ftable [ant_rows_remove $ea_ftable $rm]
                    incr ea_removed [llength $rm]
                } else {
                    # ---- 097: it does not fit in place: RELOCATE it to the nearest free run (its own old sites count as free) within MAX_RESIZE_MOVE_UM ----
                    set rmode reloc
                    set own_ori [get_attribute -quiet $cc orientation]
                    set cands [eco097_candidates $ea_ftable $inst [list $cx0 $cy0 $cx1 $cy1] $own_ori $bw $ea_site_w $MAX_RESIZE_MOVE_UM]
                    puts ">>> 097 SIZE change $idx: $inst $oldref -> $ref needs [format %.2f $extra] um more width ($greason); relocation: [llength $cands] candidate run(s) within [format %.1f $MAX_RESIZE_MOVE_UM] um, at most $MAX_SITE_TRIES tried"
                    set rl_ok 0
                    set sized 0
                    set rej {}
                    set ntry 0
                    foreach cd $cands {
                        if {$ntry >= $MAX_SITE_TRIES} break
                        incr ntry
                        set nx [dict get $cd x]; set ny [dict get $cd y]
                        set names [dict get $cd names]
                        set real [eco097_real_names $names]
                        set tbl_b [eco097_table_with_own $ea_ftable $inst [list $cx0 $cy0 $cx1 $cy1] $own_ori]   ;# the table as the candidate saw it (extents of the rows the move removes)
                        set nfl 0; set flc ""
                        if {[llength $real] > 0} { set flc [get_cells -quiet -exact $real]; set nfl [sizeof_collection $flc] }
                        if {$nfl != [llength $real]} { lappend rej "($nx, $ny): only $nfl of [llength $real] filler names found"; continue }
                        if {$nfl > 0} { set dori [get_attribute -quiet [index_collection $flc 0] orientation] } else { set dori [eco097_pseudo_ori $tbl_b $names] }
                        if {$dori eq "" && abs($ny - $cy0) < 0.001} { set dori $own_ori }
                        if {$dori eq ""} { lappend rej "($nx, $ny): the row orientation is unknown"; continue }
                        if {$nfl > 0} { remove_cells $flc }
                        set ea_ftable [ant_rows_remove $ea_ftable $names]
                        incr ea_removed [llength $real]
                        if {!$sized} {
                            if {[catch {size_cell $cc $lcname} err]} {
                                if {[catch {size_cell -lib_cell $lc $cc} err2]} { puts ">>> 097 SIZE change $idx FAILED: $err / $err2"; lappend rej "($nx, $ny): size_cell failed: $err / $err2"; break }
                            }
                            set sized 1
                        }
                        set sargs [list -coordinates [list $nx $ny] -orientation $dori]
                        if {[catch {set_cell_location {*}$sargs [get_cells -exact $inst]} err]} { lappend rej "($nx, $ny): set_cell_location failed: $err"; continue }
                        lassign [ant068_bbox_of [get_cells -exact $inst]] bx0 by0 bx1 by1
                        set bori [get_attribute -quiet [get_cells -exact $inst] orientation]
                        set bad {}
                        if {[ant_manhattan $bx0 $by0 $nx $ny] > $POS_TOL} { lappend bad "cell at ([format %.3f $bx0], [format %.3f $by0]) instead of ([format %.3f $nx], [format %.3f $ny])" }
                        if {$bori ne $dori} { lappend bad "orientation $bori instead of $dori" }
                        if {[get_attribute -quiet [get_cells -exact $inst] ref_name] ne $ref} { lappend bad "reference [get_attribute -quiet [get_cells -exact $inst] ref_name] instead of $ref" }
                        if {[llength $bad] > 0} { lappend rej "($nx, $ny): [join $bad {; }]"; continue }
                        # success: update the occupancy (the old footprint and the unused rest of the removed fillers are free again)
                        set freed [eco097_freed_rows $tbl_b $names [list $cx0 $cy0 $cx1 $cy1] $nx [expr {$nx + [dict get $cd w]}] $ny [expr {$ny + [dict get $cd h]}] $dori $ea_site_w $ea_freed_n]
                        set rl_ok 1
                        set rl_shift [ant_manhattan $nx $ny $cx0 $cy0]; set rl_x $nx; set rl_y $ny
                        set rl_r0 [dict get $cd run_x0]; set rl_r1 [dict get $cd run_x1]; set rl_dist [dict get $cd dist]; set rl_ori $dori
                        break
                    }
                    if {!$rl_ok} {
                        set fmsg "$inst $oldref -> $ref needs [format %.2f $extra] um more width: $greason; relocation failed ([llength $cands] candidate(s) within the limit, [llength $rej] rejected: [join $rej { | }]); [eco097_fail_text $ea_ftable $inst [list $cx0 $cy0 $cx1 $cy1] $own_ori $bw $ea_site_w $MAX_RESIZE_MOVE_UM]"
                        puts ">>> 079 SIZE change $idx [expr {$ALLOW_PARTIAL ? {SKIPPED} : {FAILED}}]: $fmsg"
                        if {$ALLOW_PARTIAL} { lappend ea_skipped [dict create idx $idx line [dict get $c line] pin $inst reason $fmsg on {}] } else { lappend ea_failed "change $idx: $fmsg" }
                        continue
                    }
                }
            }
            if {$rmode eq "inplace"} {
                if {[catch {size_cell $cc $lcname} err]} {   ;# VERIFY size_cell <cells> <lib_cell> (usage text of this release)
                    if {[catch {size_cell -lib_cell $lc $cc} err2]} { puts ">>> 079 SIZE change $idx FAILED: $err / $err2"; lappend ea_failed "change $idx: size_cell $inst $ref failed: $err / $err2"; continue }
                }
                legalize_placement -cells [get_cells -exact $inst]
            }
            lassign [ant068_bbox_of [get_cells -exact $inst]] nx0 ny0 nx1 ny1
            set newref [get_attribute -quiet [get_cells -exact $inst] ref_name]
            if {$rmode eq "inplace"} { set mv [ant_manhattan $nx0 $ny0 $cx0 $cy0] } else { set mv [ant_manhattan $nx0 $ny0 $rl_x $rl_y] }
            set okc [expr {$newref eq $ref && $mv <= $POS_TOL}]
            puts [format ">>> 079 SIZE change %d: %s %s -> %s, fillers removed %d, origin (%.3f, %.3f) -> (%.3f, %.3f) %s" $idx $inst $oldref $newref [llength $rm] $cx0 $cy0 $nx0 $ny0 [expr {$okc ? "OK" : "FAILED"}]]
            puts [eco097_size_line $idx $inst $oldref $newref $rmode $rl_shift $rl_x $rl_y $rl_r0 $rl_r1 $rl_dist]
            set geom1 [eco097_geom $inst $sg_out]
            puts [format ">>> 097   change %d geometry: driver (%s) -> (%s); driver-to-port distance %s -> %s um; driver-to-centroid of the %s loads %s -> %s um" $idx [join [lmap v [dict get $geom0 driver] {format %.2f $v}] {, }] [join [lmap v [dict get $geom1 driver] {format %.2f $v}] {, }] [expr {[dict get $geom0 port] eq {} ? {n/a} : [format %.1f [dict get $geom0 port]]}] [expr {[dict get $geom1 port] eq {} ? {n/a} : [format %.1f [dict get $geom1 port]]}] [dict get $geom1 nloads] [expr {[dict get $geom0 centroid] eq {} ? {n/a} : [format %.1f [dict get $geom0 centroid]]}] [expr {[dict get $geom1 centroid] eq {} ? {n/a} : [format %.1f [dict get $geom1 centroid]]}]]
            if {$rmode eq "reloc"} {
                set pf [eco097_port_flag [dict get $geom0 port] [dict get $geom1 port] $RESIZE_PORT_WARN_UM]
                if {$pf ne ""} { puts ">>> 097   change $idx $pf" }
            }
            if {!$okc} { lappend ea_failed "change $idx: $inst now $newref, moved by [format %.3f $mv] um" } else {
                lappend ea_done [dict create idx $idx type size_cell cell $inst ref $ref]
                lappend ea_touched {*}[lmap e [ant072_pin_nets $inst] {lindex $e 1}]
                if {$rmode eq "reloc"} {
                    foreach fr $freed { lappend ea_ftable $fr }
                    incr ea_freed_n [llength $freed]
                    puts ">>> 097   change $idx: [llength $freed] free row(s) added to the occupancy table (the old footprint and the unused rest of the removed fillers); they are refilled with the other free sites at the end"
                }
            }
            continue
        }
        # ---- insert_buffer ----
        set isport [expr {[dict get $c objkind] eq "port"}]
        set abpins {}
        set gate 0.0
        set portlim 0.0
        if {$isport} {
            # 079 fix: an input PORT: the loads move behind the new cell; the pin location is the port terminal (as antenna_port_buffers.tcl)
            set pinname [eco079_lookup_port [dict get $c full_pin]]
            if {$pinname eq ""} { lappend ea_failed "change $idx: port [dict get $c full_pin] not found"; continue }
            set pobj [get_ports -exact $pinname]
            set dir port
            set netb [eco079_net_of_port $pinname]
            if {$netb eq ""} { lappend ea_failed "change $idx: port $pinname has no net"; continue }
            set before [eco079_net_leaf_pins $netb]
            lassign [eco079_port_xy $pinname] px py
            set drv_cells {}; set has_port 1; set drv_xy [list $px $py]
            set dkind port
            set gate [dict get $ea_gate $ref]
            lassign [eco079_port_limit $gate $PORT_MAX_PIN_BUF_DIST $PORT_ANT_RATIO_LIMIT $PORT_ANT_WEIGHT_PINWIRE $PORT_WIRE_WIDTH_UM] portlim portwhy
            set abpins [eco079_antbuf_pins $before $BUF_PREFIX]
            if {[llength $abpins] > 0} {
                set abinfo {}
                foreach ap $abpins { lassign [ant068_centre [get_pins -exact $ap]] ax ay; lappend abinfo [format "%s (input pin %.1f um from the port pin)" $ap [ant_manhattan $px $py $ax $ay]] }
                puts ">>> 079 CASE change $idx: port $pinname already has an antenna buffer: [join $abinfo {, }]. The new cell goes BETWEEN the port and the antenna buffer (which is not touched); it must be within [format %.1f $portlim] um of the port pin ($portwhy)"
            }
        } else {
            set pinname [eco079_lookup_pin [dict get $c full_pin]]
            if {$pinname eq ""} { lappend ea_failed "change $idx: pin [dict get $c full_pin] not found (it should exist now)"; continue }
            set pobj [get_pins -exact $pinname]
            set dir [get_attribute -quiet $pobj direction]   ;# VERIFY pin attribute direction
            set netb [eco079_net_of_pin $pinname]
            if {$netb eq ""} { lappend ea_failed "change $idx: pin $pinname has no net"; continue }
            set before [eco079_net_leaf_pins $netb]
            lassign [eco079_driver_info $netb] drv_cells has_port drv_xy
            set dkind [eco079_driver_kind $drv_cells $has_port $BUF_PREFIX]
            lassign [ant068_centre $pobj] px py
        }
        set placed 0
        set tried {}
        set last_why "no usable filler run"
        set tiers {1 2}
        set tier_notes {}
        set tier_lims {}
        set portlim2 0.0
        if {$isport} {
            lassign [eco079_port_tier2 $gate $PORT_ANT_WEIGHT_TOPM $PORT_TIER2_RATIO $PORT_WIRE_WIDTH_UM $portlim] portlim2 portwhy2
            if {$portlim2 <= 0} { set tiers {1} }
        }
        foreach tier $tiers {
            if {$placed} break
            if {$isport} { set lim [expr {$tier == 1 ? $portlim : $portlim2}] } else { set lim [expr {$tier == 1 ? $DIST_TIER1 : $DIST_TIER2}] }
            lappend tier_lims [list $tier $lim]
            set rw $PORT_ANT_WEIGHT_PINWIRE; set rl $PORT_ANT_RATIO_LIMIT   ;# the predicted ratio of a port wire: tier 1 with the M2/M3 weight against the limit, tier 2 with the TOP_M weight against TIER2_RATIO
            if {$tier == 2} { set rw $PORT_ANT_WEIGHT_TOPM; set rl $PORT_TIER2_RATIO }
            set L [expr {$lim + $bw + $bh}]
            set frows [ant_rows_in_window $ea_ftable [expr {$px - $L}] [expr {$py - $L}] [expr {$px + $L}] [expr {$py + $L}]]
            set cands {}
            foreach cd [ant_site_candidates [ant_filler_runs $frows] $bw $ea_site_w $px $py $lim] {
                if {[lsearch -exact $tried [list [dict get $cd x] [dict get $cd y]]] < 0} { lappend cands $cd }
            }
            if {[llength $cands] == 0} { lappend tier_notes [format "tier %d (limit %.1f um): no usable filler run within the limit" $tier $lim] }
            set tier_rej {}
            set ntry 0
            foreach cd $cands {
                if {$ntry >= $MAX_SITE_TRIES} break
                incr ntry
                set cx [dict get $cd x]; set cy [dict get $cd y]
                lappend tried [list $cx $cy]
                set rmn [dict get $cd names]
                set rmr [eco097_real_names $rmn]   ;# 097: free sites left by a relocated cell are pseudo rows of the table, not filler instances
                set flc ""; set nflc 0
                if {[llength $rmr] > 0} { set flc [get_cells -quiet -exact $rmr]; set nflc [sizeof_collection $flc] }
                if {$nflc != [llength $rmr]} { set last_why "only $nflc of [llength $rmr] filler names found"; continue }
                if {$nflc > 0} { set ori0 [get_attribute -quiet [index_collection $flc 0] orientation]; remove_cells $flc } else { set ori0 [eco097_pseudo_ori $ea_ftable $rmn] }
                set ea_ftable [ant_rows_remove $ea_ftable $rmn]
                incr ea_removed [llength $rmr]
                # PrimeTime's new names are kept; the full hierarchical name is tried first, then the leaf name
                set cell_full [dict get $c cell]; set net_full [dict get $c net]
                if {[catch {insert_buffer -lib_cell $lc -new_cell_names $cell_full -new_net_names $net_full $pobj} err ierr]} {   ;# VERIFY insert_buffer on a pin (driver or load) with hierarchical new names
                    if {!$ea_ins_err_shown} {
                        set ea_ins_err_shown 1
                        puts ">>> 079 insert_buffer with the full hierarchical names returned an error (shown once; every later change uses the same fallback silently if it recurs): message '$err', code [dict get $ierr -code]; the leaf names are tried. First lines of the error info: [join [lrange [split [dict get $ierr -errorinfo] "\n"] 0 4] { | }]"
                    }
                    if {[catch {insert_buffer -lib_cell $lc -new_cell_names [lindex [split $cell_full /] end] -new_net_names [lindex [split $net_full /] end] $pobj} err2]} { set last_why "insert_buffer failed: $err / $err2"; continue }
                }
                set bname [eco079_lookup_cell $cell_full]
                if {$bname eq ""} { set last_why "the new cell $cell_full was not found after insert_buffer"; continue }
                set bc [get_cells -exact $bname]
                set sargs [list -coordinates [list $cx $cy]]
                if {$ori0 ne ""} { lappend sargs -orientation $ori0 }
                if {[catch {set_cell_location {*}$sargs $bc} err]} {
                    if {[catch {set_attribute -objects $bc -name origin -value [list $cx $cy]} err2]} { set last_why "cannot move $bname: $err / $err2"; continue }
                }
                legalize_placement -cells $bc
                lassign [ant068_bbox_of $bc] bx0 by0 bx1 by1
                set dpos [ant_manhattan $bx0 $by0 $cx $cy]
                lassign [dict get $ea_sig $ref] sigin sigout   ;# 079 fix 2: the SIGNAL pins from the LEF (a direction filter also returned VDD / VSS)
                set inp [get_pins -quiet -exact "$bname/$sigin"]
                set outp [get_pins -quiet -exact "$bname/$sigout"]
                if {[sizeof_collection $inp] != 1 || [sizeof_collection $outp] != 1} { error "ERROR 079: change $idx: the new cell $bname has no pins $sigin / $sigout (found [sizeof_collection $inp] / [sizeof_collection $outp]) (nothing saved)" }
                lassign [ant068_centre $inp] ix iy
                set dist [ant_manhattan $px $py $ix $iy]
                set why {}
                if {$dpos > $POS_TOL} { lappend why "cell at ([format %.3f $bx0], [format %.3f $by0]) instead of the site ([format %.3f $cx], [format %.3f $cy])" }
                if {$dist > $lim} { lappend why "distance [format %.1f $dist] > [format %.1f $lim]" }
                set ratio 0.0
                set rtxt ""
                if {$isport} {
                    set ratio [ant_ratio $gate $dist $PORT_WIRE_WIDTH_UM $rw]
                    set rtxt [format " predicted antenna ratio %.0f (weight %s, limit %s)" $ratio $rw $rl]
                    if {$ratio > $rl} { lappend why "predicted antenna ratio [format %.0f $ratio] > $rl (weight $rw)" }
                }
                set bi [get_object_name $inp]; set bz [get_object_name $outp]
                set netin [eco079_net_of_pin $bi]; set netout [eco079_net_of_pin $bz]
                set tprob [eco079_topology_check $dir $pinname $before [eco079_net_leaf_pins $netin] [eco079_net_leaf_pins $netout] $bname $sigin $sigout $ea_pgnames]
                foreach tp $tprob { lappend why "topology: $tp" }
                puts [format ">>> 079 CHANGE %d (%s line %d) %s %s ref %s tier %d%s site (%.3f, %.3f) distance %.1f um%s cell %s %s" $idx [dict get $c file] [dict get $c line] [switch -- $dir { out {string cat {driver pin}} port {string cat {input port}} default {string cat {load pin}} }] $pinname $ref $tier [expr {$isport && $tier == 2 ? { (TIER 2: beyond the tier-1 limit)} : {}}] $cx $cy $dist $rtxt $bname [expr {[llength $why] ? "REJECTED: [join $why {; }]" : "OK"}]]
                if {[llength $why] == 0} {
                    set placed 1
                    lappend ea_done [dict create idx $idx type insert_buffer cell $bname ref $ref pin $pinname dir $dir net_in $netin net_out $netout site [list $cx $cy] dist $dist]
                    lappend ea_touched $netin $netout
                    foreach mv [eco079_protected_moves $before $ea_names $netb] { lappend ea_moves $mv }
                    set wr [eco079_watch_reason $dkind]
                    if {$wr ne ""} {
                        set ddist "n/a"
                        if {$drv_xy ne ""} { set ddist [format %.1f [ant_manhattan [lindex $drv_xy 0] [lindex $drv_xy 1] $ix $iy]] }
                        set extra ""
                        if {$isport} {
                            set extra [format "; %s input gate %.3f um^2, predicted antenna ratio %.0f (TOP_M-weight worst case %.0f; this tier: weight %s, limit %s), tier-%d distance limit %.1f um" [expr {$tier == 2 ? {TIER 2:} : {tier 1:}}] $gate $ratio [ant_ratio $gate $dist $PORT_WIRE_WIDTH_UM $PORT_ANT_WEIGHT_TOPM] $rw $rl $tier $lim]
                            if {[llength $abpins] > 0} {
                                set closer {}
                                foreach ap $abpins { lassign [ant068_centre [get_pins -exact $ap]] ax ay; lappend closer [format "%s is %.1f um from the port pin: the new cell is %s" $ap [ant_manhattan $px $py $ax $ay] [expr {$dist <= [ant_manhattan $px $py $ax $ay] ? {CLOSER} : {not closer, but within the limit}}]] }
                                append extra "; ANTBUF CASE (new cell between the port and the antenna buffer): [join $closer {; }]"
                            }
                        }
                        lappend ea_watch [format "change %d: kind=%s cell %s ref %s on %s, net %s (%s); pin-to-buffer %.1f um, driver-to-buffer %s um%s" $idx [dict get $c objkind] $bname $ref $pinname $netb $wr $dist $ddist $extra]
                    }
                    break
                }
                if {[llength $tprob] > 0} {   ;# 079 fix 2: a topology problem does not depend on the site: no other candidate is tried
                    error "ERROR 079: change $idx ([dict get $c file] line [dict get $c line]): the topology after insert_buffer on $pinname ($dir) differs from what PrimeTime assumed (independent of the site, so no other candidate is tried): [join $tprob {; }]. Nothing saved. Net before (signal pins): {$before}; buffer input net $netin: {[eco079_net_leaf_pins $netin]}; buffer output net $netout: {[eco079_net_leaf_pins $netout]}"
                }
                set last_why [join $why {; }]
                lappend tier_rej "($cx, $cy): $last_why"
                if {[catch {remove_buffers $bc} err]} { error "ERROR 079: change $idx: cannot remove the rejected cell $bname: $err (nothing saved)" }   ;# VERIFY remove_buffers restores the net
                set after_back [eco079_net_leaf_pins [expr {$isport ? [eco079_net_of_port $pinname] : [eco079_net_of_pin $pinname]}]]   ;# 079 fix: a port has no pin object
                if {[lsort $after_back] ne [lsort $before]} { error "ERROR 079: change $idx: after removing the rejected cell the net of $pinname has {[lsort $after_back]}, expected {[lsort $before]} (nothing saved)" }
            }
            if {!$placed && [llength $tier_rej] > 0} { lappend tier_notes [format "tier %d (limit %.1f um): %d candidate(s) rejected: %s" $tier $lim [llength $tier_rej] [join $tier_rej { | }]] }
        }
        if {!$placed} {
            set fwhy "[join $tier_notes {; }]; [eco079_fail_diag [ant_filler_runs $ea_ftable] $bw $ea_site_w $px $py $tier_lims]"
            if {$ALLOW_PARTIAL} {
                puts ">>> 079 CHANGE $idx SKIPPED (ALLOW_PARTIAL 1): pin $pinname ref $ref: $fwhy"
                lappend ea_skipped [dict create idx $idx line [dict get $c line] pin $pinname reason $fwhy on {}]
            } else {
                puts ">>> 079 CHANGE $idx FAILED: pin $pinname ref $ref: $fwhy"
                lappend ea_failed "change $idx: pin $pinname ($ref): $fwhy"
            }
            lappend ea_gone [dict get $c cell]
        }
    }
    puts ">>> 079 fillers removed: $ea_removed; changes applied: [llength $ea_done] of [llength $ea_cmds], skipped: [llength $ea_skipped]"
    set ea_skip_idx [lmap r $ea_skipped {dict get $r idx}]
    set ea_nskip_ins 0
    foreach c $ea_cmds { if {[lsearch -exact $ea_skip_idx [dict get $c idx]] >= 0 && [dict get $c type] eq "insert_buffer"} { incr ea_nskip_ins } }
    if {[llength $ea_skipped] > 0} {
        puts ">>> 079 ===== SKIPPED CHANGES (ALLOW_PARTIAL 1): [llength $ea_skipped] of [llength $ea_cmds]: [join [lsort -integer $ea_skip_idx] {, }] ====="
        foreach ln [eco079_skip_report $ea_skipped $ea_cmds] { puts ">>> 079 SKIPPED $ln" }
        puts ">>> 079 SKIPPED: PrimeTime assumed these changes; its timing (zero violations) is NOT valid for this netlist. PrimeTime MUST be re-run (pt_hold_ff.tcl, pt_setup_ss.tcl) and a second ECO round may be needed."
    }
    if {[llength $ea_failed] > 0} { error "ERROR 079: [llength $ea_failed] change(s) FAILED, nothing saved and nothing routed (the design in memory is not saved):\n    [join $ea_failed "\n    "]" }

    # --------------------------------------------------------------------------
    # 5. Fillers back, power, re-route only the touched nets
    # --------------------------------------------------------------------------
    set fill_cells [get_lib_cells -quiet [lmap f $FILLER_REFS {string cat ${FILLER_LIB}/ $f}]]
    if {[sizeof_collection $fill_cells] == 0} { set fill_cells [get_lib_cells -quiet {*/feedth9 */feedth3 */feedth}] }
    if {[sizeof_collection $fill_cells] > 0} { create_stdcell_fillers -lib_cells $fill_cells } else { lappend ea_failures "filler cells not found, the removed fillers are not restored" }
    connect_pg_net -automatic
    connect_pg_net -net VDD [get_pins -hierarchical -quiet */VDD]
    connect_pg_net -net VSS [get_pins -hierarchical -quiet */VSS]
    set ea_tn [lsort -unique [lsearch -all -inline -not -exact $ea_touched {}]]
    set ea_tcoll [get_nets -quiet -exact $ea_tn]
    puts ">>> 079 nets to re-route: [sizeof_collection $ea_tcoll] of [llength $ea_tn] touched net names"
    remove_routes -nets $ea_tcoll -detail_route
    route_eco -nets $ea_tcoll -reuse_existing_global_route false -reroute modified_nets_first_then_others -max_detail_route_iterations 60
    route_eco -open_net_driven true -reuse_existing_global_route true -reroute modified_nets_first_then_others -max_detail_route_iterations 40
    route_detail -incremental true -max_number_iterations 40
    if {$UNPROTECT_DURING} {
        catch {set_dont_touch $ea_pcells true}
        catch {set_dont_touch [get_nets -quiet -exact $ea_pnets] true}
        puts ">>> 079 dont_touch of the protected cells and nets switched ON again"
    }

    # --------------------------------------------------------------------------
    # 6. ANTENNA WATCH, hard checks, AFTER metrics, save
    # --------------------------------------------------------------------------
    puts ">>> 079 ===== ANTENNA WATCH: [llength $ea_watch] inserted cell(s) on a port net or on the output net of an antenna buffer (Calibre decides afterwards; none is skipped) ====="
    foreach w $ea_watch { puts ">>> 079 ANTENNA WATCH $w" }
    lassign [eco081_cleanup $ea_pnets] ea_drc ea_open ea_ant ea_drc_hist   ;# 081: check_routes plus the DRC clean-up loop (rounds); the counts are those of the last check
    puts ">>> 079 check_routes AFTER: DRCs $ea_drc (before the ECO: $ea_drc0), open nets $ea_open, ICC2 antenna violations $ea_ant; DRC counts per step: [eco081_history_text $ea_drc_hist]"
    if {$ea_drc eq "" || $ea_drc != 0} { lappend ea_failures "check_routes DRCs '$ea_drc' (0 required) after $DRC_ROUNDS clean-up round(s) (DRC counts per step: [eco081_history_text $ea_drc_hist]; the remaining errors are listed above as REMAINING DRC)" }
    if {$ea_open eq "" || $ea_open != 0} { lappend ea_failures "check_routes open nets '$ea_open' (0 required)" }
    redirect -variable ea_leg_txt { check_legality -verbose }
    puts $ea_leg_txt
    set ea_leg [ant_parse_legality $ea_leg_txt]
    puts ">>> 079 CHECK legality violations: [expr {$ea_leg eq {} ? {unreadable} : $ea_leg}] (0 required)"
    if {$ea_leg eq "" || $ea_leg != 0} { lappend ea_failures "legality violations '$ea_leg' (0 required)" }
    # counts and references of the new cells
    set ea_n_ins_done 0; set ea_n_size_done 0
    foreach d $ea_done { if {[dict get $d type] eq "insert_buffer"} { incr ea_n_ins_done } else { incr ea_n_size_done } }
    set ea_found_names [eco095_marker_names $NEW_CELL_MARK]
    if {$ECO_KIND eq "drc"} {
        set ea_found_names [eco095_not_hold $ea_found_names $NEW_CELL_MARK $HOLD_CELL_MARK]
        set ea_hold_after [eco095_hold_cells [eco095_marker_names $NEW_CELL_MARK] $HOLD_CELL_MARK]
        puts ">>> 095 CHECK hold-ECO cells ($HOLD_CELL_MARK): [llength $ea_holdprev] before the ECO, [llength $ea_hold_after] after it"
        if {$ea_hold_after ne $ea_holdprev} { lappend ea_failures "the cells of the hold ECO changed: before [llength $ea_holdprev], after [llength $ea_hold_after] (names differ or a cell vanished)" }
    } elseif {$ea_si_round} {
        # 098: the cells that existed before the round are still there, and the NEW ones are those of the change file
        set ea_all_after $ea_found_names
        set ea_found_names [lmap n $ea_all_after {expr {[lsearch -exact $ea_holdprev $n] >= 0 ? [continue] : $n}}]
        set ea_gone_prior [lmap n $ea_holdprev {expr {[lsearch -exact $ea_all_after $n] >= 0 ? [continue] : $n}}]
        puts ">>> 098 CHECK earlier-round cells with the marker $NEW_CELL_MARK: [llength $ea_holdprev] before the ECO, [expr {[llength $ea_holdprev] - [llength $ea_gone_prior]}] still there after it; new cells found: [llength $ea_found_names]"
        if {[llength $ea_gone_prior] > 0} { lappend ea_failures "earlier-round cells vanished: [lrange $ea_gone_prior 0 4]" }
    }
    set ea_found [llength $ea_found_names]
    set ea_want_ins [expr {$ea_nins - $ea_nskip_ins}]
    puts ">>> 079 CHECK inserted cells: applied $ea_n_ins_done, insertions in the change files $ea_nins, skipped $ea_nskip_ins, expected applied = total - skipped = $ea_want_ins, found in the design by name ($NEW_CELL_MARK): $ea_found"
    if {$ea_n_ins_done != $ea_want_ins} { lappend ea_failures "inserted cells applied $ea_n_ins_done != $ea_want_ins (= $ea_nins insertions in the change files - $ea_nskip_ins skipped)" }
    if {$ea_found != $ea_want_ins} { lappend ea_failures "cells with $NEW_CELL_MARK in the name: $ea_found != $ea_want_ins (= $ea_nins - $ea_nskip_ins skipped)" }
    foreach d $ea_done {
        set cobj [get_cells -quiet -exact [dict get $d cell]]
        if {[sizeof_collection $cobj] != 1} { lappend ea_failures "change [dict get $d idx]: cell [dict get $d cell] vanished"; continue }
        if {[get_attribute -quiet $cobj ref_name] ne [dict get $d ref]} { lappend ea_failures "change [dict get $d idx]: [dict get $d cell] has reference [get_attribute -quiet $cobj ref_name], PrimeTime wrote [dict get $d ref]" }
    }
    # new nets exist
    foreach c $ea_cmds { if {[dict get $c type] eq "insert_buffer" && [lsearch -exact $ea_skip_idx [dict get $c idx]] < 0 && [eco079_lookup_net [dict get $c net]] eq ""} { lappend ea_failures "change [dict get $c idx]: the net name [dict get $c net] does not exist after the insertion (PrimeTime's name is not kept)" } }
    # protected cells
    set ea_snap1 [lmap nm $ea_names {ant072_snapshot $nm}]
    set ea_diff [ant072_snapshot_diff $ea_snap0 $ea_snap1]
    lassign [eco079_diff_split $ea_diff $ea_moves $NEW_CELL_MARK] ea_diff ea_exp
    foreach d $ea_exp { puts ">>> 079 EXPECTED protected pin move (an insertion put a PrimeTime cell in front of the antenna buffer / on its net; the topology was verified): $d" }
    puts ">>> 079 CHECK protected cells ([llength $ea_names]): [expr {[llength $ea_diff] ? $ea_diff : {reference, origin and orientation identical; every pin on the same net except the [llength $ea_exp] expected move(s) listed above}}]"
    foreach d $ea_diff { lappend ea_failures "protected cell: $d" }
    set ea_nant1 [sizeof_collection [get_cells -quiet ${BUF_PREFIX}_*]]
    set ea_nearly1 [sizeof_collection [get_cells -quiet ${EARLY_PREFIX}_*]]
    puts ">>> 079 CHECK ${BUF_PREFIX}_* count: $ea_nant1 (before the ECO $ea_nant); ${EARLY_PREFIX}_* count: $ea_nearly1 (before the ECO $ea_nearly)"
    foreach {ea_l ea_b ea_a} [list "${BUF_PREFIX}_*" $ea_nant $ea_nant1 "${EARLY_PREFIX}_*" $ea_nearly $ea_nearly1] {
        set ea_cp [eco092_count_problem $ea_l $ea_b $ea_a]
        if {$ea_cp ne ""} { lappend ea_failures $ea_cp }
    }
    set ea_m1 [ant072_metrics "079 AFTER"]
    set ea_g1 [eco079_in2out_state "079 AFTER"]
    # 080: the GATE. The in2out group and the whole setup WNS must not be worse than before by more than the tolerance; hold only gives a warning (PrimeTime is the sign-off for hold).
    puts ">>> 079 GATE setup violating endpoints: whole design before [dict get $ea_m0 setup_num], after [dict get $ea_m1 setup_num]; in2out group before [lindex $ea_g0 1], after [lindex $ea_g1 1]; hold before [dict get $ea_m0 hold_num], after [dict get $ea_m1 hold_num]"
    foreach {glabel gb ga gtol} [list "the in2out group" [lindex $ea_g0 0] [lindex $ea_g1 0] $GATE_TOL_SETUP "the whole-design setup WNS" [dict get $ea_m0 setup] [dict get $ea_m1 setup] $GATE_TOL_SETUP] {
        lassign [eco079_gate_check $glabel $gb $ga $gtol] gst gmsg
        puts ">>> 079 GATE $gst: $gmsg"
        if {$gst ne "ok"} {
            puts ">>> 079 ERROR 079: $gmsg: nothing saved"
            lappend ea_failures "$gmsg: nothing saved"
        }
    }
    lassign [eco079_gate_check "the whole-design hold WNS" [dict get $ea_m0 hold] [dict get $ea_m1 hold] $GATE_TOL_HOLD] ghst ghmsg
    puts ">>> 079 GATE hold $ghst: $ghmsg"
    if {$ghst ne "ok"} { puts ">>> 079 WARNING: $ghmsg. ICC2's hold view is not the sign-off: PrimeTime (pt_hold_ff.tcl) decides." }
    puts ">>> 079 NOTE: ICC2's view of the I/O paths is more lenient than PrimeTime's (ICC2 gives the external clock the macro's insertion delay; PrimeTime launches/captures at the clock pin with zero latency). The numbers above are REPORTED, not tuned; PrimeTime (pt_setup_ss.tcl / pt_hold_ff.tcl) is the sign-off."
    if {[llength $ea_failures] > 0} { error "ERROR 079: [llength $ea_failures] check(s) failed, NOTHING SAVED: [join $ea_failures {; }]" }

    save_block
    save_block -force -as ${DESIGN_NAME}_route
    save_lib
    puts ">>> [eco079_final_line [llength $ea_skipped] [llength $ea_cmds] $ea_skip_idx $ea_n_ins_done $ea_n_size_done [llength $ea_watch] ${DESIGN_NAME}_route ${LOG_DIR}/6g_pt_eco_apply.log]"
    if {[llength $ea_skipped] > 0} { puts ">>> 079 PARTIAL RESULT: re-run PrimeTime on the result; the skipped changes are listed above (SKIPPED CHANGES)" }
    puts ">>> 079 NEXT: metal_fill.tcl, pv.tcl, the Calibre DRC / antenna / LVS runs (the ANTENNA WATCH cells first), then PrimeTime pt_setup_ss.tcl and pt_hold_ff.tcl (zero violations expected), then the post-layout simulation."
}

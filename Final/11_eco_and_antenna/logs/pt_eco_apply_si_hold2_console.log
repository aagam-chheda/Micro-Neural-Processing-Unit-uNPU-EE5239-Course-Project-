# 092: plain Tcl (tested by pnr_v2/test_pt_eco_apply.tcl). The folder of PrimeTime's change files: pnr_icc2/pt (default) or, with the tag of a checkpoint (UNPU_PT_TAG, task 091), pnr_icc2/pt_<tag>.
proc eco092_pt_dir {pnr tag} {
    if {$tag eq ""} { return ${pnr}/pt }
    if {![regexp {^[A-Za-z0-9_]{1,32}$} $tag]} { error "ERROR 092: UNPU_PT_TAG='$tag' is not a valid tag (1 to 32 letters, digits or underscores)" }
    return ${pnr}/pt_${tag}
}
# 092: the protected buffers: antbuf_* (antenna_port_buffers.tcl) and earlybuf_* (port_buffers_early.tcl). Either set may be empty (run 3: earlybuf only, the antbuf step comes later), both empty means this is not the block
# 092: the script is meant for (the old guard "15 antbuf_*" is replaced by: what is there before must be there after, see eco092_count_problem). Returns {ok message}.
proc eco092_protect_decide {n_ant n_early} {
    if {$n_ant + $n_early == 0} { return [list 0 "no antbuf_* and no earlybuf_* cell found: this is not a block after port_buffers_early.tcl or antenna_port_buffers.tcl (nothing changed)"] }
    return [list 1 "$n_ant antbuf_* and $n_early earlybuf_* cells are protected"]
}
# 092: "" when the count of a protected set is unchanged by the ECO, else a sentence
proc eco092_count_problem {label before after} {
    if {$before != $after} { return "$label count $before before the ECO, $after after it" }
    return ""
}
# ---- END PURE TCL 092 ----
# ---- BEGIN PURE TCL 093 ----
# 093: plain Tcl (tested by pnr_v2/test_eco_scope.tcl). The class file pt_eco_hold_pin_classes.txt that pt_eco_probe.tcl writes next to the change files: one line per insertion,
# 093: "<idx> <pin> <ref> <class> net=<net> drivers=<pins>"; "#" lines and empty lines are comments. Returns a dict: rows (idx -> dict pin ref cls net drivers), errors (texts).
proc eco093_parse_classes {text} {
    set rows [dict create]
    set errors {}
    set ln 0
    foreach l [split $text "\n"] {
        incr ln
        set t [string trim $l]
        if {$t eq "" || [string index $t 0] eq "#"} continue
        if {![regexp {^([0-9]+) (\S+) (\S+) (\S+) net=(\S+) drivers=(\S+)$} $t -> idx pin ref cls net drv]} { lappend errors "line $ln: not understood: $t"; continue }
        if {[dict exists $rows $idx]} { lappend errors "line $ln: change $idx appears twice"; continue }
        dict set rows $idx [dict create pin $pin ref $ref cls $cls net $net drivers $drv]
    }
    return [dict create rows $rows errors $errors]
}
# 093: the classes that must stop the apply (the list of pt_eco_class_violation in pt/pt_common.tcl; a test keeps the two equal)
proc eco093_violation {cls} {
    return [expr {[lsearch -exact {cone_net cone_driver cone_port cone_resize cone_slower clock_net unknown} $cls] >= 0}]
}
# 093: the class file against the HOLD insertions of the change file. cmds: the parsed commands of the hold file (dicts with idx type full_pin). Returns {lines problems}: one printable line per insertion
# 093: and the problems (a command without a line, a line for another pin, a line without a command, a violation class). Empty problems = the file belongs to this change file and no insertion is a violation.
proc eco093_check {cmds rows} {
    set lines {}
    set probs {}
    set seen {}
    foreach c $cmds {
        if {[dict get $c type] ne "insert_buffer"} continue
        set idx [dict get $c idx]
        lappend seen $idx
        if {![dict exists $rows $idx]} { lappend probs "change $idx (pin [dict get $c full_pin]) has no line in the class file"; continue }
        set r [dict get $rows $idx]
        if {[dict get $r pin] ne [dict get $c full_pin]} { lappend probs "change $idx is on pin [dict get $c full_pin] but the class file says [dict get $r pin]: the class file belongs to another change file"; continue }
        set v [eco093_violation [dict get $r cls]]
        lappend lines "change $idx: pin [dict get $r pin] ([dict get $r ref]): class [dict get $r cls][expr {$v ? { (VIOLATION)} : {}}]; net [dict get $r net]; driver [dict get $r drivers]"
        if {$v} { lappend probs "change $idx: pin [dict get $r pin] has the class [dict get $r cls], a violation of the in2out cone" }
    }
    dict for {idx r} $rows { if {[lsearch -exact $seen $idx] < 0} { lappend probs "the class file has a line for change $idx (pin [dict get $r pin]) but the change file has no insertion with that number" } }
    return [list $lines $probs]
}
# ---- END PURE TCL 093 ----
# ---- BEGIN PURE TCL 095 ----
# 095: plain Tcl (tested by pnr_v2/test_drc_eco.tcl). The kind of ECO this run applies: hold (DEFAULT, tasks 079-093) or drc (the max-transition ECO for the data limit, pt_eco_drc_probe.tcl). Returns a dict: main (the change file),
# 095: setup (the optional setup change file; "" = none for this kind), count (the expected-count file) and classes (the pin-class file); all in the folder of PrimeTime's files.
proc eco095_kind_files {kind pt_dir {si 0}} {
    switch -- $kind {
        hold {
            # 098: with SI on the optional setup change file is NOT read by a hold run (one kind per call, the setup kind has its own call)
            return [dict create main ${pt_dir}/pt_eco_hold_changes_icc2.tcl setup [expr {$si ? "" : "${pt_dir}/pt_eco_setup_changes_icc2.tcl"}] count ${pt_dir}/pt_eco_hold_expected_count.txt classes ${pt_dir}/pt_eco_hold_pin_classes.txt]
        }
        drc  { return [dict create main ${pt_dir}/pt_eco_drc_changes_icc2.tcl setup "" count ${pt_dir}/pt_eco_drc_expected_count.txt classes ${pt_dir}/pt_eco_drc_pin_classes.txt] }
        setup { return [dict create main ${pt_dir}/pt_eco_setup_changes_icc2.tcl setup "" count ${pt_dir}/pt_eco_setup_expected_count.txt classes ${pt_dir}/pt_eco_setup_pin_classes.txt] }
    }
    error "ERROR 095: UNPU_ECO_KIND='$kind' is not valid: hold (the default), drc or setup (task 098)"
}
# 098: the folder of PrimeTime's change files: pt[_<tag>] (SI off) or pt_si / pt_<tag>_si (the probes ran with UNPU_PT_SI=1). si must be 0 or 1.
proc eco098_pt_dir {pnr tag si} {
    if {$si ni {0 1}} { error "ERROR 098: UNPU_PT_SI='$si' is not valid: 0 (the default) or 1" }
    set d [eco092_pt_dir $pnr $tag]
    return [expr {$si ? "${d}_si" : $d}]
}
# 098: the instances that earlier ECO rounds resized or inserted and that this round must leave alone: the cells named in the given change files (size_cell instances and insert_buffer cells; texts of the files)
proc eco098_earlier_instances {texts} {
    set out {}
    foreach t $texts {
        set pr [eco079_parse $t]
        foreach c [dict get $pr cmds] {
            if {[dict get $c type] eq "size_cell"} { lappend out [dict get $c full_inst] } else { lappend out [dict get $c cell] }
        }
    }
    return [lsort -unique $out]
}
# 098: the number of class rows against the number of size_cell changes. rows = the dict of eco093_parse_classes (idx -> row; comment and blank lines never become rows); "" when equal. ([dict size], not [llength]: llength of a dict counts keys AND values.)
proc eco098_rows_problem {rows cmds} {
    set n 0
    foreach c $cmds { if {[dict get $c type] eq "size_cell"} { incr n } }
    set r [dict size $rows]
    if {$r != $n} { return "the class file has $r row(s) for $n size_cell change(s)" }
    return ""
}
# 098: a SETUP-kind class file against the size_cell changes: every size_cell has a row (pin = the instance) and no row is a violation class. Returns {lines problems}.
proc eco098_check_size {cmds rows} {
    set lines {}; set probs {}; set seen {}
    foreach c $cmds {
        if {[dict get $c type] ne "size_cell"} continue
        set idx [dict get $c idx]
        lappend seen $idx
        if {![dict exists $rows $idx]} { lappend probs "change $idx (size_cell [dict get $c full_inst]) has no line in the class file"; continue }
        set r [dict get $rows $idx]
        if {[dict get $r pin] ne [dict get $c full_inst]} { lappend probs "change $idx is size_cell [dict get $c full_inst] but the class file says [dict get $r pin]: the class file belongs to another change file"; continue }
        set v [eco093_violation [dict get $r cls]]
        lappend lines "change $idx: size_cell [dict get $r pin] -> [dict get $r ref]: class [dict get $r cls][expr {$v ? { (VIOLATION)} : {}}]; net [dict get $r net]"
        if {$v} { lappend probs "change $idx: size_cell [dict get $r pin] has the class [dict get $r cls]" }
    }
    return [list $lines $probs]
}
# 095: the cells that carry the PrimeTime marker but are NOT cells of the hold ECO that is already in the block (U_PTECO_HOLD_BUF<n>): a drc run on a block that has the hold cells must not call them "applied before".
proc eco095_not_hold {names mark hold_mark} {
    set out {}
    foreach n $names { if {[string first $mark $n] >= 0 && [string first $hold_mark $n] < 0} { lappend out $n } }
    return $out
}
# 095: the cells of the hold ECO in the block (names with the hold marker), as a sorted list
proc eco095_hold_cells {names hold_mark} {
    set out {}
    foreach n $names { if {[string first $hold_mark $n] >= 0} { lappend out $n } }
    return [lsort $out]
}
# ---- END PURE TCL 095 ----
# ---- BEGIN PURE TCL 097 ----
# 097: plain Tcl (tested by pnr_v2/test_eco_resize.tcl; needs ant_filler_runs, ant_site_candidates, ant_rows_in_window, ant_run_report, ant_manhattan of antenna_port_buffers.tcl). A RESIZED cell that does not fit in place
# 097: (task 079's growth into the filler run at its right edge) is relocated to the nearest free site run that is wide enough for the NEW cell. Rows of the filler table are {name x0 y0 x1 y1 ori}. The table also
# 097: holds PSEUDO rows (names starting with "__"): free sites that are not filler instances (the footprint a relocated cell left, the rest of a removed filler); they are "removed" from the table only.
proc eco097_is_pseudo {name} { return [string match "__*" $name] }
proc eco097_real_names {names} { return [lmap n $names {expr {[eco097_is_pseudo $n] ? [continue] : $n}}] }
# 097: the orientation stored in the first pseudo row of `names` (rows of the table), "" when none
proc eco097_pseudo_ori {rows names} {
    foreach n $names {
        if {![eco097_is_pseudo $n]} continue
        foreach r $rows { if {[lindex $r 0] eq $n && [lindex $r 5] ne ""} { return [lindex $r 5] } }
    }
    return ""
}
# 097: the table with the old footprint of the cell as a free row (the cell is going to move or to grow: its own sites count as free). bbox = {x0 y0 x1 y1}.
proc eco097_table_with_own {rows inst bbox ori} {
    lassign $bbox x0 y0 x1 y1
    return [concat $rows [list [list "__own_$inst" $x0 $y0 $x1 $y1 $ori]]]
}
# 097: the candidate runs for a cell of new width bw whose old box is bbox: the run is evaluated from the OLD cell's centre (Manhattan distance of the new cell's centre, limit = the move limit). Returns the list of candidate
# 097: dicts of ant_site_candidates (x y w h dist orient names run_x0 run_x1), nearest first, each with `shift` (Manhattan distance of the new ORIGIN from the old one) and `inplace` (same origin).
proc eco097_candidates {rows inst bbox ori bw site_w limit {tol 0.001}} {
    lassign $bbox x0 y0 x1 y1
    set px [expr {($x0 + $x1) / 2.0}]; set py [expr {($y0 + $y1) / 2.0}]
    set tbl [eco097_table_with_own $rows $inst $bbox $ori]
    set L [expr {$limit + $bw + ($y1 - $y0)}]
    set frows [ant_rows_in_window $tbl [expr {$px - $L}] [expr {$py - $L}] [expr {$px + $L}] [expr {$py + $L}]]
    set out {}
    foreach cd [ant_site_candidates [ant_filler_runs $frows] $bw $site_w $px $py $limit $tol] {
        dict set cd shift [ant_manhattan [dict get $cd x] [dict get $cd y] $x0 $y0]
        dict set cd inplace [expr {abs([dict get $cd x] - $x0) <= $tol && abs([dict get $cd y] - $y0) <= $tol}]
        lappend out $cd
    }
    return $out
}
# 097: after a relocation the sites that are free again, as pseudo rows. names = the table rows that the move removed (fillers and the own row), own = the old box, the new cell occupies [nx0, nx1] in the row y0..y1.
# 097: Every removed row and the old footprint, minus the new cell's span, becomes a free row again (pieces shorter than half a site are dropped). Returns the list of rows; counter = first number for the names.
proc eco097_freed_rows {rows names own nx0 nx1 y0 y1 ori site_w counter {tol 0.001}} {
    set segs {}
    foreach n $names {
        if {[string match "__own_*" $n]} continue
        foreach r $rows { if {[lindex $r 0] eq $n} { lappend segs [list [lindex $r 1] [lindex $r 2] [lindex $r 3] [lindex $r 4] [expr {[lindex $r 5] ne "" ? [lindex $r 5] : $ori}]] } }   ;# a filler is in the row of the new cell: its orientation
    }
    lassign $own ox0 oy0 ox1 oy1
    lappend segs [list $ox0 $oy0 $ox1 $oy1 $ori]
    set out {}
    foreach sg $segs {
        lassign $sg sx0 sy0 sx1 sy1 sori
        set pieces {}
        if {abs($sy0 - $y0) <= $tol} {
            if {$sx0 < $nx0 - $tol} { lappend pieces [list $sx0 [expr {min($sx1, $nx0)}]] }
            if {$sx1 > $nx1 + $tol} { lappend pieces [list [expr {max($sx0, $nx1)}] $sx1] }
        } else { set pieces [list [list $sx0 $sx1]] }
        foreach pc $pieces {
            if {[lindex $pc 1] - [lindex $pc 0] < $site_w / 2.0} continue
            lappend out [list "__freed_$counter" [lindex $pc 0] $sy0 [lindex $pc 1] $sy1 $sori]
            incr counter
        }
    }
    return $out
}
# 097: WARNING text when the driver-to-port distance of a relocated cell grew by more than `warn` um ("" otherwise; "" values: the distance is not available)
proc eco097_port_flag {before after warn} {
    if {![string is double -strict $before] || ![string is double -strict $after]} return
    if {$after - $before > $warn} { return [format "WARNING: the driver-to-port distance grew by %.1f um (%.1f -> %.1f), more than %.1f um: the output net is longer; the timing gates decide" [expr {$after - $before}] $before $after $warn] }
    return ""
}
# 097: the per-change log line
proc eco097_size_line {idx inst oldref newref mode shift x y run_x0 run_x1 dist} {
    if {$mode eq "inplace"} { return [format ">>> 097 SIZE change %d: cell %s %s -> %s, in place" $idx $inst $oldref $newref] }
    return [format ">>> 097 SIZE change %d: cell %s %s -> %s, relocated by %.2f um to (%.3f, %.3f), run \[%.3f,%.3f\], distance %.2f" $idx $inst $oldref $newref $shift $x $y $run_x0 $run_x1 $dist]
}
# 097: the failure text when no candidate works: the 3 nearest runs with their widths and why each is rejected, and what the user can do
proc eco097_fail_text {rows inst bbox ori bw site_w limit} {
    lassign $bbox x0 y0 x1 y1
    set px [expr {($x0 + $x1) / 2.0}]; set py [expr {($y0 + $y1) / 2.0}]
    set tbl [eco097_table_with_own $rows $inst $bbox $ori]
    set runs [ant_filler_runs $tbl]
    set lines [ant_run_report $runs $bw $site_w $px $py $limit 3]
    return "no free site run within MAX_RESIZE_MOVE_UM = [format %.1f $limit] um is wide enough for the new cell ([format %.2f $bw] um = [expr {int(ceil($bw / $site_w - 1e-6))}] sites); the 3 nearest runs: [join $lines { | }]. The user decides: raise MAX_RESIZE_MOVE_UM (the line `set MAX_RESIZE_MOVE_UM` in pt_eco_apply.tcl), or ask the probe for -methods {insert_buffer} only for this net"
}
# 097: the signal OUTPUT pin of a LEF cell (dict with `pins`: name -> dict dir use); "" when it has none or more than one (the geometry report then says n/a)
proc eco097_out_pin {lefcell} {
    set outs {}
    dict for {pn pd} [dict get $lefcell pins] {
        if {[dict get $pd use] eq "POWER" || [dict get $pd use] eq "GROUND"} continue
        if {[dict get $pd dir] eq "OUTPUT"} { lappend outs $pn }
    }
    return [expr {[llength $outs] == 1 ? [lindex $outs 0] : ""}]
}

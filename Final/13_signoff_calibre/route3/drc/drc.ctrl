#define 4M1L
#define BLOCK
#define 3V
// 082: RELATIVE on purpose (VERIFY V18: Calibre resolves LAYOUT PATH from the folder it is started in, like SOURCE PATH / MASK SVDB DIRECTORY). Start it from <RUN_DIR>/pnr_icc2/calibre/run1/drc/ (README step 2): ../../../outputs is then THIS clone's pnr_icc2/outputs, never another clone's.
LAYOUT PATH "../../../outputs_route3/unpu_top_routed.gds"
LAYOUT PRIMARY "unpu_top"
LAYOUT SYSTEM GDSII
DRC RESULTS DATABASE "unpu_top.drc.db" ASCII
DRC MAXIMUM RESULTS ALL
DRC MAXIMUM VERTEX ALL
DRC CELL NAME NO
DRC SUMMARY REPORT "unpu_top.drc.rpt" REPLACE HIER
VIRTUAL CONNECT COLON NO
VIRTUAL CONNECT REPORT NO
DRC ICSTATION YES
INCLUDE "/storage/EE5239G1/aagams_workspace/calibre_run/scr/DRC_TS18SL_SCL_CALIBRE"

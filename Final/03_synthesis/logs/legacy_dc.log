# =============================================================================
# dc_script_legacy.tcl -- Design Compiler synthesis of unpu_top with the OLD constraints (task 064).
#
# PURPOSE   Clean-slate run of 2026-11-02 (user decision): synthesise unpu_top once with the old constraints (period 20 ns, setup
#           uncertainty 1.5, hold uncertainty 0.5, APB 35/35, DMA 40/40, rst_n 40, min delays 0 / -0.5, ...) and no stage profiles.
#           The result feeds the gate-level simulation and the pnr_v2/ ICC2 flow (pnr_v2/design_setup.tcl reads
#           syn/out/legacy/unpu_top_cn.dc.v and unpu_top_cn.sdc).
# READS     rtl/*.sv (the 11 files listed below, RTL is frozen) and constraints/legacy/unpu_top_legacy.sdc, which is
#           byte-identical to `git show 925bfa9:constraints/pm_unpu_top.sdc` (the only authoritative form of the old numbers;
#           nothing is retyped here).
# WRITES    syn/out/legacy/ : exactly 14 files (unpu_top.{profile,area,power,timing,timing_top5,constraint,qor,check_timing,check_design},
#           unpu_top.dc.v, unpu_top.sdc, unpu_top_cn.dc.v, unpu_top_cn.sdc, unpu_top_cn.ddc); no SDF (write_sdf is task 059, not accepted).
#           DC scratch files go to syn/out/work/legacy/ (both under the git-ignored syn/out/).
# RUN       csh, from the repo root (the script checks that it is):
#             mkdir -p syn/out ; dc_shell -f constraints/legacy/dc_script_legacy.tcl |& tee syn/out/legacy_dc.log
#           See syn/RUNBOOK_legacy.md. The script ends with exit.
# DO NOT    edit this script or the SDC to close timing. The old numbers are the user's decision; a change needs a written
#           reason and the user's approval.
#
# BASIS     The COMMITTED constraints/pm_dc_script_unpu.tcl (HEAD, with the task-055 fixes: fatal guards, exit, scratch directory,
#           exact output check, change_names to _cn), not the working-tree version. Library setup, operating-condition and
#           wire-load branches, optimisation constraints and compile options are unchanged. Differences, and only these:
#   L1. no UNPU_STAGE, no constraints/stage_numbers.tcl, no profile table. read_sdc reads constraints/legacy/unpu_top_legacy.sdc.
#   L2. The numbers the base takes from the profile (period, setup and hold uncertainty) are read from the SDC's own
#       `set CLK_PERIOD` / `set CLK_UNCERT_SETUP` / `set CLK_UNCERT_HOLD` lines by unpu_sdc_number (pure Tcl, strict: not exactly one
#       such line, or a non-numeric value, stops the script). Why this and not a typed 20.0: one table, no second copy of a number;
#       the tool's clock period (from create_clock in the same file) is then compared with the SDC's CLK_PERIOD, which also
#       catches an SDC whose create_clock and CLK_PERIOD disagree. They are used in the report headers and the read-back check.
#       (dc_shell evaluates the SDC in its own scope, so the variables themselves are not visible after read_sdc: task 055.)
#   L3. outputs go to syn/out/legacy/ and scratch to syn/out/work/legacy/; no write_sdf; the end-of-script check expects the 14 files
#       above. unpu_check_outputs is the base's procedure from constraints/stage_numbers.tcl, copied here (no file is sourced).
#   L4. the report header says "legacy constraints" instead of "stage profile <name>".
# =============================================================================
# -----------------------------------------------------------------------------
# 1. Setup: design, library, read RTL
# -----------------------------------------------------------------------------
# CHANGED (task 055): FATAL guards. A Tcl "error" in a dc_shell -f script only prints "Error:" and the script goes on
# (seen in the first real run: compile and the reports ran after the guard fired). unpu_fatal prints the reason
# and runs exit 1, so nothing after a failed guard runs. VERIFY: "exit 1" ends dc_shell with status 1 from inside a proc.
proc unpu_fatal {msg} {
    puts "Error: unpu DC script: $msg"
    puts "Error: unpu DC script: STOPPED with exit 1; nothing after this point was run."
    exit 1
    # not reached; if exit ever returned, do not go on:
    return -code error "unpu DC script: exit 1 did not end the shell"
}
# The script must run from the repo root: every path below is the repo root plus a relative path.
set repo_root [pwd]
/storage/EE5239G1/aagams_workspace2/unpu_run3
set sdc_rel constraints/legacy/unpu_top_legacy.sdc
constraints/legacy/unpu_top_legacy.sdc
foreach rel [list rtl/unpu_top.sv $sdc_rel] {
    if {![file exists $repo_root/$rel]} {
        unpu_fatal "$rel not found under the current directory $repo_root. Run dc_shell from the repo root."
    }
}
# L2: the numbers come from the SDC's own table lines. strict: exactly one line `set <name> <number>` per name.
proc unpu_sdc_number {sdc_text var} {
    set hits {}
    foreach l [split $sdc_text "\n"] {
        if {[regexp "^set\[ \t\]+$var\[ \t\]+(\[^ \t;\]+)" $l -> v]} { lappend hits $v }
    }
    if {[llength $hits] != 1} { return -code error "expected exactly one line 'set $var <number>' in the SDC, found [llength $hits]" }
    set v [lindex $hits 0]
    if {![string is double -strict $v]} { return -code error "'set $var $v' in the SDC: '$v' is not a number" }
    return $v
}
if {[catch {set fh [open $repo_root/$sdc_rel r]} msg]} { unpu_fatal "cannot open $sdc_rel: $msg" }
set sdc_text [read $fh]
# =============================================================================
# pm_unpu_top.sdc -- timing constraints for unpu_top (SCL 180 nm, 50 MHz)
#
# Pure SDC: constraints only, no library setup, no don't-use cells, no
# operating condition or wire-load model, no compile options. Those stay in
# constraints/pm_dc_script_unpu.tcl, which reads this file with read_sdc.
# The same file can be read by ICC2 and PrimeTime.
#
# Contents, in order:
#   1. The PM's example constraints (clock, I/O delays), kept as given. The
#      PM's set_drive 0 and set_load 0 (a perfect driver, an empty output) are
#      deliberately removed; section 3 replaces them with real ones. The clock name is the literal port name `clk`, and the clock is
#      created on [get_ports clk]; the PM's "is there a clk port, else make a
#      virtual clock" fallback is script logic, not a constraint, and is dropped
#      because unpu_top has a real clk port.
#   2. The constraints from constraints/unpu_top.sdc: clock uncertainty and
#      transition, and the I/O delays with named port groups. They override the
#      PM's 0 delays on the named ports (a later set_input_delay / set_output_delay
#      on the same port and the same -max or -min wins).
#   3. NEW: boundary non-idealities: a weak input driving cell, a wire load on
#      the input nets, the output load, and design-wide max transition and max
#      capacitance.
#
# EVERY number below except the 20 ns period (CLAUDE.md) and the 1 pF output
# load (the course instructor's value) is an ASSUMPTION, pending the SoC team's
# interface timing and loads. The assumptions are deliberately HARSH (pessimistic):
# large clock uncertainty and slew, big external delay shares, a long input wire,
# tight transition and capacitance limits. Timing that closes here has margin. None may be changed to close timing without a
# written reason and the user's approval.
#
# Units: the SCL libraries declare time_unit 1ns and capacitive_load_unit
# (1, pf) (read from the ss .lib header; the ff library's time unit matches, its
# capacitance unit was not read). All times are ns and all loads are pF.
# =============================================================================

set_units -time ns -capacitance pF


# -----------------------------------------------------------------------------
# 1. The PM's constraints, as given
# -----------------------------------------------------------------------------
create_clock -name clk -period 20 [get_ports clk]

set_input_delay  0 [all_inputs]  -clock clk
set_output_delay 0 [all_outputs] -clock clk


# -----------------------------------------------------------------------------
# 2. From constraints/unpu_top.sdc (copied by hand: if one file changes, update
#    the other)
# -----------------------------------------------------------------------------
set CLK_PERIOD        20.0   ;# 50 MHz, from CLAUDE.md; keep equal to the create_clock -period above
set CLK_UNCERT_SETUP   1.5   ;# HARSH ASSUMPTION, setup margin: jitter ~0.5 + skew ~1.0 (7.5% of the period)
set CLK_UNCERT_HOLD    0.5   ;# HARSH ASSUMPTION, hold margin: skew only, jitter does not hurt hold
set CLK_TRANSITION     0.6   ;# HARSH ASSUMPTION, slew at the flop clock pins (ideal clock only)
# The APB read path prdata = f(paddr) is combinational (in to out, through the
# CSR read mux), so its budget is
#     CLK_PERIOD * (1 - APB_IN_PCT - APB_OUT_PCT) - CLK_UNCERT_SETUP
# APB_IN_PCT and APB_OUT_PCT MUST therefore leave a positive budget for that
# path. With the values below it is 6 ns before uncertainty, 4.5 ns after.
set APB_IN_PCT         0.35  ;# HARSH ASSUMPTION, fraction of period used outside, max input delay
set APB_OUT_PCT        0.35  ;# HARSH ASSUMPTION, fraction of period the outside needs after prdata/pready
set DMA_IN_PCT         0.4   ;# HARSH ASSUMPTION, dma_rdata, dma_ready
set DMA_OUT_PCT        0.4   ;# HARSH ASSUMPTION, dma_addr/wdata/wstrb/valid
set RST_IN_PCT         0.4   ;# HARSH ASSUMPTION, rst_n
set IN_MIN_DELAY       0.0   ;# HARSH ASSUMPTION, input may change right at the clock edge (the earliest possible)
set OUT_MIN_DELAY     -0.5   ;# HARSH ASSUMPTION, the outside needs outputs held 0.5 ns after the edge (min output delay = minus its hold time)

# Port groups, listed explicitly. clk is in no group.
set APB_IN_PORTS   {paddr[*] pwdata[*] pwrite psel penable}
set APB_OUT_PORTS  {prdata[*] pready}
set DMA_IN_PORTS   {dma_rdata[*] dma_ready}
set DMA_OUT_PORTS  {dma_addr[*] dma_wdata[*] dma_wstrb[*] dma_valid}
set RST_IN_PORTS   {rst_n}

set_clock_uncertainty -setup $CLK_UNCERT_SETUP [get_clocks clk]
set_clock_uncertainty -hold  $CLK_UNCERT_HOLD  [get_clocks clk]
set_clock_transition  $CLK_TRANSITION [get_clocks clk]

# Input delays. -max is the setup side, -min the hold side.
set_input_delay -clock clk -max [expr {$CLK_PERIOD * $APB_IN_PCT}] [get_ports $APB_IN_PORTS]
set_input_delay -clock clk -min $IN_MIN_DELAY                      [get_ports $APB_IN_PORTS]

set_input_delay -clock clk -max [expr {$CLK_PERIOD * $DMA_IN_PCT}] [get_ports $DMA_IN_PORTS]
set_input_delay -clock clk -min $IN_MIN_DELAY                      [get_ports $DMA_IN_PORTS]

# rst_n: an ordinary input delay, deliberately with NO set_false_path. Its
# assertion is asynchronous, but the recovery/removal checks on its release
# must stay in the analysis, so it is timed like any other input.
set_input_delay -clock clk -max [expr {$CLK_PERIOD * $RST_IN_PCT}] [get_ports $RST_IN_PORTS]
set_input_delay -clock clk -min $IN_MIN_DELAY                      [get_ports $RST_IN_PORTS]

# Output delays. -max is the setup side, -min the hold side.
set_output_delay -clock clk -max [expr {$CLK_PERIOD * $APB_OUT_PCT}] [get_ports $APB_OUT_PORTS]
set_output_delay -clock clk -min $OUT_MIN_DELAY                      [get_ports $APB_OUT_PORTS]

set_output_delay -clock clk -max [expr {$CLK_PERIOD * $DMA_OUT_PCT}] [get_ports $DMA_OUT_PORTS]
set_output_delay -clock clk -min $OUT_MIN_DELAY                      [get_ports $DMA_OUT_PORTS]


# -----------------------------------------------------------------------------
# 3. NEW: boundary non-idealities
#
# Gives the boundary a finite driver and finite loads (the PM's idealised
# set_drive 0 and set_load 0 were removed). All of it is an assumption; the
# SoC team has not given real numbers. The output load is the instructor's
# value; everything else is mine.
#
# a) Driving cell: every data input is driven by a buffd1, the weakest of the
#    library's plain buffers (family buffd1/2/3/4/7/da; buffd2 was inspected:
#    input I, output Z, function "I"). A weak driver gives slow input edges
#    and a larger driver delay, the pessimistic side. buffd1 is ASSUMED to
#    have the same pin names as buffd2; that has not been read from the .lib
#    (if DC reports it cannot find pin Z on buffd1, fix it here). The input
#    slew is whatever buffd1 produces into the net below; there is deliberately
#    no set_input_transition on top. clk is excluded (ideal clock, see
#    set_clock_transition above).
#
# b) Input wire load: 0.2 pF on every data input net, roughly 1 mm of 180 nm
#    route (about 0.2 fF/um), so the driver sees a long wire and not an empty
#    pin. HARSH ASSUMPTION.
#
# c) Output load: 1 pF on every output port, the value suggested by the course
#    instructor. It is deliberately conservative: roughly a hundred 180 nm cell
#    inputs (about 0.01 pF each) or several millimetres of route, much heavier
#    than a realistic SoC-level load. A design that meets timing at 1 pF has
#    margin if the real load is lighter. Expect DC to upsize or buffer the
#    output cells, which costs some area, and each output path to slow by
#    roughly a nanosecond at the ss corner. Never lower this to close timing
#    without a written reason and the user's approval.
#
# d) Design-wide max transition 3.0 ns and max capacitance 2.0 pF.
#    Max transition 3.0 ns is the library's own pin limit (max_transition : 3 in
#    the ss .lib, read on the server), so it is the characterised limit and not a
#    tightened one. It replaces my earlier harsh 1.0 ns (see e). Max capacitance
#    2.0 pF is a harsh assumption, tighter than the PM's own
#    commented-out set_max_capacitance 5 (a different technology) and not checked
#    against the SCL library. The library's pin limits still apply and where they
#    are tighter they win. The 1 pF output load sits under the 2.0 pF cap; keep
#    MAX_CAPACITANCE above OUT_LOAD or every output is a violation by construction.
#
# e) Why max transition is 3.0 ns and not 1.0 ns (decided by the user, 2026-10-14,
#    option A, after the first two DC runs). Assumptions a) and b) already fix the
#    slew at every data input: a buffd1 driving 0.2 pF gives 2.43 ns (DC, ss
#    corner), which can never meet 1.0 ns; DC cannot change the driver or the wire,
#    so 79 input ports were violated by construction (-1.43 ns each), which says
#    nothing about the design. A port-specific looser limit does not help: DC
#    applies the tighter of the design-wide and the port limit, so a 3.0 ns
#    set_max_transition on the ports did not override a design-wide 1.0 ns (tried
#    in the second DC run). The 1.0 ns, my own harsh guess with no library basis,
#    is therefore dropped and the library's 3 ns applies everywhere. The input
#    driver and wire assumptions stay harsh. The one internal net that was over 1.0
#    ns (n45 in pe_10, 1.46 ns) is legal under 3 ns and no longer reported.
# -----------------------------------------------------------------------------
set DRIVE_CELL       buffd1  ;# ASSUMPTION, weakest plain buffer standing in for the outside driver
set DRIVE_PIN        Z       ;# output pin; verified for buffd2 in the ss .lib, assumed for buffd1
set IN_WIRE_LOAD     0.2     ;# pF, HARSH ASSUMPTION, wire on every data input net
set OUT_LOAD         1.0     ;# pF, every output port; the instructor's suggested value
set MAX_TRANSITION   3.0     ;# ns, the library's own pin limit (see e)
set MAX_CAPACITANCE  2.0     ;# pF, HARSH ASSUMPTION

set_driving_cell -lib_cell $DRIVE_CELL -pin $DRIVE_PIN [get_ports $APB_IN_PORTS]
set_driving_cell -lib_cell $DRIVE_CELL -pin $DRIVE_PIN [get_ports $DMA_IN_PORTS]
set_driving_cell -lib_cell $DRIVE_CELL -pin $DRIVE_PIN [get_ports $RST_IN_PORTS]

set_load $IN_WIRE_LOAD [get_ports $APB_IN_PORTS]
set_load $IN_WIRE_LOAD [get_ports $DMA_IN_PORTS]
set_load $IN_WIRE_LOAD [get_ports $RST_IN_PORTS]

set_load $OUT_LOAD [get_ports $APB_OUT_PORTS]
set_load $OUT_LOAD [get_ports $DMA_OUT_PORTS]

set_max_transition  $MAX_TRANSITION  [current_design]
set_max_capacitance $MAX_CAPACITANCE [current_design]

close $fh
foreach var {CLK_PERIOD CLK_UNCERT_SETUP CLK_UNCERT_HOLD} {
    if {[catch {unpu_sdc_number $sdc_text $var} val]} { unpu_fatal "cannot get $var from $sdc_rel: $val" }
    set $var $val
}
# L3: DC's scratch files go to a scratch directory, not to the repo root and not to the output directory.
set run_tag  legacy
legacy
set work_dir $repo_root/syn/out/work/$run_tag
/storage/EE5239G1/aagams_workspace2/unpu_run3/syn/out/work/legacy
file mkdir $work_dir
cd $work_dir
puts "Info: \[unpu\] $run_tag constraints: period $CLK_PERIOD ns, setup uncertainty $CLK_UNCERT_SETUP ns, hold uncertainty $CLK_UNCERT_HOLD ns (from $sdc_rel); scratch directory $work_dir"
Info: [unpu] legacy constraints: period 20.0 ns, setup uncertainty 1.5 ns, hold uncertainty 0.5 ns (from constraints/legacy/unpu_top_legacy.sdc); scratch directory /storage/EE5239G1/aagams_workspace2/unpu_run3/syn/out/work/legacy
# CHANGED: top module
set top_module  unpu_top
unpu_top
set clk_name    clk
clk
